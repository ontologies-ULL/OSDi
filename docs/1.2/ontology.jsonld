  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasRiskCharacterization",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines the risk characterization of a clinical progression element, which can be expressed as a parameter (e.g., relative risk) or as a pathway (e.g., a pathway that defines the events that lead to the occurrence of a certain manifestation). A development or chronic manifestation without risk characterization that does not belong to a group of two or more alternative progressions (i.e., not affected by any combination rule, affected by a coexistent rule, or by an alternative rule with a single member) is always active in its context: it applies from the start, and a manifestation without risk that depends on a development (hasSubProgression) is active whenever such development is active. Within a group of two or more alternative progressions, the progression without risk (at most one, and only if the group has no null progression) takes the remaining probability (1 minus the sum of the rest). Both decision trees and discrete-event simulations should interpret progressions without risk in this way."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has risk characterization"
  }, {
    "@language" : "es",
    "@value" : "tiene la caracterización de riesgo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid54"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isRiskCharacterizationOf"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#TODO" : [ {
    "@value" : "Check if this is the best name for the property"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasScaleParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines the scale parameter of a probability distribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has scale parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro de escala"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasSensitivity",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The Sensitivity in epidemiology is the Probability of correctly classifying a sick individual, that is, the Probability that a positive result will be obtained in a diagnostic test for a sick subject. The Sensitivity is, therefore, the ability of the complementary test to detect the disease. Sensitivity is the percentage of true positives or the Probability that the test is positive if the disease is present; False negatives are sick subjects diagnosed as healthy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid57"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has sensitivity"
  }, {
    "@language" : "es",
    "@value" : "tiene la sensibilidad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasSex",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines the sex of the population, which can be used to define the characteristics of the disease and the interventions. The value is the proportion of female individuals in the population."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has sex"
  }, {
    "@language" : "es",
    "@value" : "tiene sexo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid60"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#usesAttributeValue"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasSize",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Number of individuals in the population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has size"
  }, {
    "@language" : "es",
    "@value" : "tiene el tamaño"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasSource",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Source of the parameter value, e.g., a bibliographic reference, name of a dataset, name of an expert..."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has source"
  }, {
    "@language" : "es",
    "@value" : "tiene la fuente"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasSpecificity",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The Specificity of a test is the Probability that a healthy subject will have a negative test result. Specificity is the percentage of true negatives or the Probability that the test will be negative if the disease is not present. False positives are healthy subjects diagnosed as sick."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid61"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has specificity"
  }, {
    "@language" : "es",
    "@value" : "tiene la especificidad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasStandardDeviationParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines the standard deviation parameter of a probability distribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has standard deviation parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro de desviación estándar"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasStartOffset",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Tiempo transcurrido entre un punto de referencia y el inicio de la pauta. El punto de referencia es el final de la pauta anterior si existe (hasPrevious), o el inicio de la pauta, estrategia o tecnología sanitaria padre en otro caso. La unidad por defecto es años."
  }, {
    "@language" : "en",
    "@value" : "Time elapsed between a reference point and the start of the guideline. The reference point is the end of the previous guideline if it has one (hasPrevious), or the start of the parent guideline, strategy or health technology otherwise. Default unit is years."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has start offset"
  }, {
    "@language" : "es",
    "@value" : "tiene el desfase de inicio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasStrategy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines a relationship between a health condition, intervention or strategy and a strategy, which can be either a simple strategy or a group of strategies. This property allows us to define the strategies that are applied to a health condition, intervention or strategy, as well as the strategies that are part of a group of strategies."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid64"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has strategy"
  }, {
    "@language" : "es",
    "@value" : "tiene la estrategia"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid68"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isStrategyOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasSubGuideline",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relaciona una pauta con cada una de sus subpautas directas. Una pauta puede descomponerse recursivamente; la forma de combinar las subpautas se indica con hasSubGuidelineCombination. No es transitiva a propósito: usa la ruta SPARQL hasSubGuideline+ para obtener todos los descendientes."
  }, {
    "@language" : "en",
    "@value" : "Relates a guideline to each of its direct sub-guidelines. A guideline may be decomposed recursively; the way sub-guidelines are combined is stated with hasSubGuidelineCombination. Intentionally not transitive: use the SPARQL path hasSubGuideline+ to retrieve all descendants."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has sub-guideline"
  }, {
    "@language" : "es",
    "@value" : "tiene subpauta"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000051"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isSubGuidelineOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasSubGuidelineCombination",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Indica cómo se combinan las subpautas directas de una pauta compuesta: simultáneas, secuenciales (ordenadas con hasNext/hasPrevious) o alternativas excluyentes (seleccionadas por sus condiciones de aplicación)."
  }, {
    "@language" : "en",
    "@value" : "States how the direct sub-guidelines of a composite guideline are combined: concurrently, sequentially (ordered with hasNext/hasPrevious) or as mutually exclusive alternatives (selected by their applicability conditions)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#CompositeGuideline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has sub-guideline combination"
  }, {
    "@language" : "es",
    "@value" : "tiene combinación de subpautas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasSubProgression",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines a relationship between a clinical progression element and its sub-element, indicating that the sub-element only appear as a part of the clinical progression."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has sub-progression"
  }, {
    "@language" : "es",
    "@value" : "has sub-progression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000051"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasSubpopulation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines a relationship between a population and a subpopulation, indicating that the subpopulation is a subset of the population."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has subpopulation"
  }, {
    "@language" : "es",
    "@value" : "tiene la subpoblación"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000051"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isSubPopulationOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasTemporaryThreshold",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Time limit in which the sample must be made. For example on the third day of birth. This value must be expressed in number of days."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid75"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has temporary threshold"
  }, {
    "@language" : "es",
    "@value" : "tiene el umbral temporal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasTimeHorizon",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines the time horizon (in years) applied to a simulation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has time horizon"
  }, {
    "@language" : "es",
    "@value" : "tiene horizonte temporal"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
