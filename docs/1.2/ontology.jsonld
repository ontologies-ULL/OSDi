    "@language" : "en",
    "@value" : "has age"
  }, {
    "@language" : "es",
    "@value" : "tiene edad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid10"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#usesAttributeValue"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasAlfaParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines the alpha parameter of a probability distribution, which is the shape parameter that determines the skewness of the distribution"
