  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#isDisutility",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Indicates whether a utility parameter represents a disutility or a utility. A utility u (isDisutility = false) of a progression, the disease or an intervention is equivalent to a disutility of (base utility of the population - u), so the patient gets exactly u if it is the only one active. The converted value is combined with the rest of disutilities by using the disutility combination method of the experiment (hasDisutilityCombinationMethod). This applies both to annual and one-time utilities, and assumes that the utility was measured in a population with the same base utility as that of the model."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Utility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "es una desutilidad"
  }, {
    "@language" : "en",
    "@value" : "is disutility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
