}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines the age of the population, which can be used to define the characteristics of the disease and the interventions. The value is the average age of the individuals in the population."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Population"
  } ],
