    "@language" : "en",
    "@value" : "Defines a relationship between a health technology or a strategy and a guideline, indicating that the guideline is applied to the health technology or strategy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid43"
