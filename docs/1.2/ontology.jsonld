}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://creativecommons.org/ns#license" : [ {
    "@id" : "http://creativecommons.org/licenses/by-nc-sa/4.0/"
  } ],
  "http://purl.org/dc/elements/1.1/contributor" : [ {
    "@value" : "María Luz Couce Pico (https://orcid.org/0000-0003-4861-9905)"
  } ],
  "http://purl.org/dc/elements/1.1/creator" : [ {
    "@value" : "David Prieto González (https://orcid.org/0000-0003-1411-129X)"
  }, {
    "@value" : "Evelio J. González González (https://orcid.org/0000-0002-2203-3757)"
  }, {
    "@value" : "Iván Castilla Rodríguez (http://orcid.org/0000-0003-3933-2582)"
  } ],
  "http://purl.org/dc/elements/1.1/description" : [ {
    "@language" : "en",
    "@value" : "Ontology designed for collecting and inferring the parameters required to create a simulation-based Health Technology Assesment"
  }, {
    "@language" : "es",
    "@value" : "Ontología diseñada para recopilar e inferir los parámetros necesarios para crear una evaluación de tecnología sanitaria basada en simulación"
  } ],
  "http://purl.org/dc/elements/1.1/source" : [ {
    "@id" : "https://github.com/ontologies-ULL/OSDi"
  } ],
  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "en",
    "@value" : "This ontology provides a structured framework for the interoperability of health economics data used to create models. The ontology represents all the concepts and relationships involved in health technology assessment, including the characterization of the disease and its development, the population affected, and the interventions applied."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Las restricciones only sin cardinalidad son orientativas y señalan qué propiedades aplican a cada clase"
  }, {
    "@language" : "en",
    "@value" : "The only restrictions without cardinality are indicative and indicate which properties apply to each class"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "OSDi"
  }, {
    "@language" : "es",
    "@value" : "OSDi"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi/1.2"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "1.2"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#AcuteManifestation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Sudden or rapid appearance of clinical signs or symtoms, in general with a short and intense course"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Acute manifestation"
  }, {
    "@language" : "es",
    "@value" : "Manifestación aguda"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Manifestation"
  }, {
    "@id" : "_:genid189"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionWithInitialProportion"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#AgentBasedModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An model based on using multiple agents"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Agent based model"
  }, {
    "@language" : "es",
    "@value" : "Modelo basado en agentes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Model"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#AlternativeCombinationRule",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A set of disease progressions which are treated as mutually exclusive alternatives, e.g., a mild and a severe development of certain disease"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Alternative disease progression set"
  }, {
    "@language" : "es",
    "@value" : "Conjunto de progresiones de enfermedad alternativas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule"
  }, {
    "@id" : "_:genid190"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#AtomicGuideline",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A guideline with no sub-guidelines. Must be asserted: under the open-world assumption the absence of sub-guidelines cannot be inferred. Asserting it on a guideline that has sub-guidelines makes the ontology inconsistent."
  }, {
    "@language" : "es",
    "@value" : "Pauta sin subpautas. Debe asertarse: bajo la suposición de mundo abierto no se puede inferir la ausencia de subpautas. Asertarla en una pauta con subpautas hace la ontología inconsistente."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Atomic guideline"
  }, {
    "@language" : "es",
    "@value" : "Pauta simple"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  }, {
    "@id" : "_:genid191"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#CompositeGuideline"
  } ]
}, {
