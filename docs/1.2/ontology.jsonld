  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasAssessedIntervention",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relaciona un modelo con una intervención cuyo valor se evalúa en él. Normalmente es una, pero se admiten varias (p. ej. evaluaciones de múltiples tecnologías). El papel depende del modelo: la misma intervención puede ser comparador en otro."
  }, {
    "@language" : "en",
    "@value" : "Relates a model to an intervention whose value is being assessed in it. Usually one, but several are allowed (e.g. multiple technology appraisals). The role is specific to the model: the same intervention may be a comparator in another model."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Model"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has assessed intervention"
  }, {
    "@language" : "es",
    "@value" : "tiene la intervención evaluada"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Intervention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#includesModelItem"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isAssessedInterventionOf"
  } ]
