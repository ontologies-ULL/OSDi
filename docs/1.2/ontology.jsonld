}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasFrequency",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "For a guideline: number of applications per period (see hasPeriod), e.g. 3 applications every 1 day. For an acute manifestation: number of occurrences per year."
  }, {
    "@language" : "es",
    "@value" : "Para una pauta: número de aplicaciones por periodo (ver hasPeriod), p. ej. 3 aplicaciones cada 1 día. Para una manifestación aguda: número de apariciones al año."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid40"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has frequency"
  }, {
    "@language" : "es",
    "@value" : "tiene la frecuencia"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
