}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasOffsetParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines the offset parameter of a probability distribution, which is a value that is added to the random variable defined by the distribution. This is useful for defining distributions that can only take values above or below a certain threshold (for example, an offset of 1 in a Poisson distribution would define a distribution that can only take values from 1 to infinite, instead of from 0 to infinite)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has offset parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro de desplazamiento"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"
  } ]
