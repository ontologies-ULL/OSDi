    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasMinApplicationAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Edad mínima (incluida) a la que se aplica la pauta. Junto con hasMaxApplicationAge, sustituye a hasRange. Para otras condiciones (peso, atributos...) usa hasConditionExpression."
  }, {
    "@language" : "en",
    "@value" : "Minimum age (inclusive) at which the guideline applies. Together with hasMaxApplicationAge, replaces hasRange. For other conditions (weight, attributes...) use hasConditionExpression."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has minimum application age"
  }, {
    "@language" : "es",
    "@value" : "tiene la edad mínima de aplicación"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasMortalityRateCombinationMethod",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Defines the method used to combine the increased mortality rates (magnitudes of IncreasedMortalityRateEffect, expressed as rate ratios) of all the model items that are active at the same time. Combination methods are applied, at any moment, to the set of model items (disease, clinical progressions, interventions) that are simultaneously active for an individual: in a decision tree, the items along the path to each leaf; in a discrete-event simulation, the state of the patient between two consecutive events. MAX applies only the largest rate ratio; MULT multiplies all of them. If not defined, MAX is assumed. The combined rate ratio divides the life expectancy before applying any life expectancy reduction (see hasLifeExpectancyReductionCombinationMethod)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has mortality rate combination method"
  }, {
    "@language" : "es",
    "@value" : "tiene el método de combinación de tasas de mortalidad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid169"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasNext",
