}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasExpectedValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The expected value of a parameter with uncertainty. This is useful for deterministic parameters with uncertainty, which can be used in deterministic sensitivity analysis, and for second-order uncertainty parameters, which are used in two-level PSA."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid154"
  } ],
