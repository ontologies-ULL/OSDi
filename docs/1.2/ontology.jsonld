  }, {
    "@language" : "es",
    "@value" : "tiene la edad máxima"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasMaxApplicationAge",
