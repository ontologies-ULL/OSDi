  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombination_Alternative",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Alternativa"
  }, {
    "@language" : "en",
    "@value" : "Alternative"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@language" : "es",
    "@value" : "A cada individuo se le aplica exactamente una subpauta, seleccionada por sus condiciones de aplicación (límites de edad y/o expresiones de condición), p. ej. una dosis distinta según la edad o el peso."
  }, {
    "@language" : "en",
    "@value" : "Exactly one sub-guideline applies to each individual, selected by its applicability conditions (application age bounds and/or condition expressions), e.g. a different dose depending on age or weight."
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombination_Concurrent",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Concurrent"
  }, {
    "@language" : "es",
    "@value" : "Simultánea"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@language" : "en",
    "@value" : "All sub-guidelines apply at the same time (e.g. two drugs given together). Each may have its own start offset."
  }, {
    "@language" : "es",
    "@value" : "Todas las subpautas se aplican a la vez (p. ej. dos fármacos administrados juntos). Cada una puede tener su propio desfase de inicio."
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombination_Sequential",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Secuencial"
  }, {
    "@language" : "en",
    "@value" : "Sequential"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@language" : "es",
    "@value" : "Las subpautas se aplican una tras otra (p. ej. inducción y después mantenimiento). El orden se indica con hasNext/hasPrevious; la primera es la subpauta sin hasPrevious. Cada paso termina al alcanzar su duración o número de aplicaciones."
  }, {
    "@language" : "en",
    "@value" : "Sub-guidelines apply one after another (e.g. induction, then maintenance). The order is given by hasNext/hasPrevious; the first one is the sub-guideline with no hasPrevious. Each step ends when its duration or count is reached."
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#HealthCareCat",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "es",
    "@value" : "Cuidado sanitario"
  }, {
    "@language" : "en",
    "@value" : "Healthcare"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageCategoryScheme"
  } ]
