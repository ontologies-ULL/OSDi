    "@language" : "en",
    "@value" : "has intervention"
  }, {
    "@language" : "es",
    "@value" : "tiene la intervención"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Intervention"
