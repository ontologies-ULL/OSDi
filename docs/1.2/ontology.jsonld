}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#creator",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#dependsOn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relaciona un parámetro calculado con cada atributo o parámetro referenciado en su expresión (hasExpressionValue). Todo elemento que aparezca en la expresión debería declararse con esta propiedad, para que las herramientas puedan resolver las dependencias del parámetro sin analizar la expresión."
  }, {
    "@language" : "en",
    "@value" : "Relates a calculated parameter to each attribute or parameter referenced in its expression (hasExpressionValue). Every element referenced in the expression should be declared with this property, so that tools can resolve the dependencies of the parameter without parsing the expression."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "depende de"
  }, {
    "@language" : "en",
    "@value" : "depends on"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid4"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasDependantCalculatedParameter"
  } ]
}, {
