  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DI_Sensitivity",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DataItemType"
