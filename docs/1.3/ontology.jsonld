    "@id" : "_:genid219"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#ChronicManifestation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Conjunto de signos y síntomas de larga duración o que reaparecen con frecuencia"
  }, {
    "@language" : "en",
    "@value" : "Long-lasting or frequently recurring set of signs and symptoms"
