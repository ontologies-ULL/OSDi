  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Parameter whose value is computed using an expression, generally dependent on other parameters"
  }, {
    "@language" : "es",
    "@value" : "Parámetro cuyo valor se calcula mediante una expresión, que en general depende de otros parámetros"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
