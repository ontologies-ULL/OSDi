    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DataItemType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Especificidad"
  }, {
    "@language" : "en",
    "@value" : "Specificity"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@value" : "The probability of a negative test result, conditioned on the individual truly being negative"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO" : [ {
    "@value" : "http://purl.obolibrary.org/obo/STATO_0000134"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DI_StandardDeviation",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DataItemType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Desviación estándar"
  }, {
    "@language" : "en",
    "@value" : "Standard deviation"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@value" : "A measure of variation which correspond to the average distance from the mean of the data set to any given point of that dataset"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO" : [ {
    "@value" : "http://purl.obolibrary.org/obo/STATO_0000237"
  } ]
}, {
