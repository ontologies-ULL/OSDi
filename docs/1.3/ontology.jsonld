  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A clinical progression element that is present in an initial proportion in a population"
  }, {
    "@language" : "es",
    "@value" : "Un elemento de progresión clínica que está presente en una proporción inicial de una población"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Clinical progression with initial proportion"
  }, {
    "@language" : "es",
    "@value" : "Progresión clínica con proporción inicial"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
