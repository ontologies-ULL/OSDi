  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A model based on using multiple agents"
  }, {
    "@language" : "es",
    "@value" : "Un modelo basado en el uso de múltiples agentes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Agent based model"
  }, {
