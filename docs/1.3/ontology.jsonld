  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An HTA experiment that uses a model, some input parameters and obtains results"
  }, {
    "@language" : "es",
    "@value" : "Un experimento de ETS que usa un modelo y unos parámetros de entrada, y obtiene resultados"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Experiment"
  }, {
    "@language" : "es",
    "@value" : "Experimento"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid339"
  }, {
