    "@id" : "_:genid448"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid443"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#Manifestation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Symptoms or signs of a disease. They may be chronic or acute"
  }, {
    "@language" : "es",
    "@value" : "Síntomas o signos de una enfermedad. Pueden ser crónicos o agudos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Manifestación"
  }, {
    "@language" : "en",
    "@value" : "Manifestation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"
  }, {
    "@id" : "_:genid452"
  } ],
  "http://www.w3.org/2002/07/owl#disjointUnionOf" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/ontologies-ULL/OSDi#AcuteManifestation"
    }, {
