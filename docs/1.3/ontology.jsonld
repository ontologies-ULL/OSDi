  }, {
    "@id" : "_:genid571"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A rule that defines how to combine a set of disease progressions (exclusions, coexistence...)"
  }, {
    "@language" : "es",
    "@value" : "Una regla que define cómo combinar un conjunto de progresiones de la enfermedad (exclusiones, coexistencia...)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Pogression combination rule"
  }, {
    "@language" : "es",
    "@value" : "Regla de combinación de progresiones"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DiseaseProgressionElement"
  }, {
    "@id" : "_:genid572"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#QoLDataItemType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A type of data item related to quality-of-life measures"
  }, {
    "@language" : "es",
    "@value" : "Un tipo de elemento de datos relacionado con medidas de calidad de vida"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Quality-of-Life Data Item Type"
  }, {
    "@language" : "es",
    "@value" : "Tipo de elemento de datos de calidad de vida"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DataItemType"
  }, {
    "@id" : "_:genid573"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#RareDisease",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A disease with very low prevalence"
  }, {
    "@language" : "es",
    "@value" : "Una enfermedad con una prevalencia muy baja"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Enfermedad rara"
  }, {
    "@language" : "en",
    "@value" : "Rare disease"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Disease"
  }, {
    "@id" : "_:genid574"
  }, {
    "@id" : "_:genid575"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageCategoryScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#ConceptScheme" ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "es",
    "@value" : "Categorías relacionadas con uso de recursos"
  }, {
    "@language" : "en",
    "@value" : "Resource usage-related categories"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Elemento relacionado con el uso de recursos sanitarios, que pertenece a alguna categoría concreta"
  }, {
    "@language" : "en",
    "@value" : "Item related to the use of health resources, belonging to some specific category"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Elemento de uso de recursos"
  }, {
    "@language" : "en",
    "@value" : "Resource Usage Item"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ModelItem"
  }, {
    "@id" : "_:genid576"
  }, {
    "@id" : "_:genid577"
  }, {
    "@id" : "_:genid578"
  }, {
    "@id" : "_:genid579"
  }, {
    "@id" : "_:genid580"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#ScreeningCat",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionCat"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "es",
    "@value" : "Cribado"
  }, {
    "@language" : "en",
    "@value" : "Screening"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#ScreeningIntervention",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An intervention to identify the subset of population who may have certain disease or condition and require further testing to obtain a final diagnosis. A screening intervention declares its screening strategy through a StrategyReplacementEffect on the disease: its replacement (usually a group with the screening strategy and the confirmatory diagnosis strategy) replaces the detection strategies of the disease in its arm. The sensitivity, specificity and costs of the screening are those of the screening strategy."
  }, {
    "@language" : "es",
    "@value" : "Una intervención para identificar el subconjunto de la población que puede tener cierta enfermedad o condición y requiere más pruebas para obtener un diagnóstico final. Una intervención de cribado declara su estrategia de cribado mediante un StrategyReplacementEffect sobre la enfermedad: su sustitución (normalmente un grupo con la estrategia de cribado y la estrategia de diagnóstico de confirmación) sustituye las estrategias de detección de la enfermedad en su brazo. La sensibilidad, la especificidad y los costes del cribado son los de la estrategia de cribado."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Intervención de cribado"
  }, {
    "@language" : "en",
    "@value" : "Screening intervention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid581"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#ScreeningStrategy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A strategy related to the identification of persons potentially suffering a disease among a population"
  }, {
    "@language" : "es",
    "@value" : "Una estrategia relacionada con la identificación, dentro de una población, de las personas que pueden padecer una enfermedad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Estrategia de cribado"
  }, {
    "@language" : "en",
    "@value" : "Screening strategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"
  }, {
    "@id" : "_:genid589"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid585"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#SecondOrderUncertaintyParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Parameter whose value has second-order uncertainty, i.e. the precise value is not known and is subject to uncertainty. For example, the actual value of the effectiveness of a treatment could have been derived from a metaanalysis of several studies and being defined by an average but also confidence intervals"
  }, {
    "@language" : "es",
    "@value" : "Parámetro cuyo valor tiene incertidumbre de segundo orden, es decir, el valor exacto no se conoce y está sujeto a incertidumbre. Por ejemplo, el valor real de la efectividad de un tratamiento podría proceder de un metaanálisis de varios estudios y estar definido por una media, pero también por intervalos de confianza"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Parámetro con incertidumbre de segundo orden"
  }, {
    "@language" : "en",
    "@value" : "Second-order uncertainty parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ParameterNature"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid590"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#SequentialCombinationRule",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A set of disease progressions that appear sequentially, e.g., the stages of a cancer. The first element is given by hasFirst and the order by hasNext/hasPrevious. Like the other combination rules, it must be asserted."
  }, {
    "@language" : "es",
    "@value" : "Conjunto de progresiones de enfermedad que aparecen de forma secuencial, p. ej. los estadios de un cáncer. El primer elemento se indica con hasFirst y el orden con hasNext/hasPrevious. Como el resto de reglas de combinación, debe asertarse."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Conjunto de progresiones de enfermedad secuenciales"
  }, {
    "@language" : "en",
    "@value" : "Sequential disease progression set"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule"
  }, {
    "@id" : "_:genid599"
  }, {
    "@id" : "_:genid603"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#Stage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A phase or step in the progression of a disease"
  }, {
    "@language" : "es",
    "@value" : "Una fase o etapa de la progresión de una enfermedad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Estadio"
  }, {
    "@language" : "en",
    "@value" : "Stage"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"
  }, {
    "@id" : "_:genid604"
  }, {
    "@id" : "_:genid609"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A way of defining a series of steps required to treat, detect or follow-up a disease or condition"
  }, {
    "@language" : "es",
    "@value" : "Una forma de definir la serie de pasos necesarios para tratar, detectar o hacer el seguimiento de una enfermedad o condición"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Estrategia"
  }, {
    "@language" : "en",
    "@value" : "Strategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"
  }, {
    "@id" : "_:genid614"
  }, {
    "@id" : "_:genid619"
  }, {
    "@id" : "_:genid620"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "One of the mutually exclusive outcomes of a strategy (hasStrategyOutcome). An outcome declares how likely it is (hasOutcomeRisk and its subproperties), the strategy that follows it (followedByStrategy), when it is evaluated (hasEvaluationTime), and its own effects, costs and utilities, which apply once, when the outcome happens (annual ones are not meaningful for an outcome: the payoffs after an outcome belong to the next strategy). An outcome must belong to one of the concrete subclasses. The chain of strategies that follow an outcome cannot go back to a strategy already applied (decision trees reject cycles): a repetition is modeled as another strategy."
  }, {
    "@language" : "es",
    "@value" : "Uno de los resultados mutuamente excluyentes de una estrategia (hasStrategyOutcome). Un resultado declara su probabilidad (hasOutcomeRisk y sus subpropiedades), la estrategia que lo sigue (followedByStrategy), cuándo se evalúa (hasEvaluationTime) y sus efectos, costes y utilidades, que se aplican una vez, al producirse el resultado. Un resultado debe pertenecer a una de las subclases concretas. La cadena de estrategias que siguen a un resultado no puede volver a una estrategia ya aplicada: una repetición se modela como otra estrategia."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Resultado de una estrategia"
  }, {
    "@language" : "en",
    "@value" : "Strategy outcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ModelItem"
  }, {
    "@id" : "_:genid621"
  }, {
    "@id" : "_:genid622"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#StrategyReplacementEffect",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An effect of an intervention that replaces the strategies of a health condition (affects: the disease or an element of its progression) with a new strategy or group of strategies (hasReplacementStrategy). It applies in the arm of the intervention and by type of strategy (detection, i.e. screening or diagnosis; follow-up; or treatment, i.e. line of therapy): the new strategy replaces the strategies of its same type that the health condition declares (hasStrategy), or it is assigned to the health condition if it had none of that type; the strategies of other types are kept. If the replacement is a group, each member replaces the strategies of its type. It does not use a magnitude (hasEffectMagnitude). Two strategy replacements of the same health condition in the same arm are an error. This is the only way for an intervention to declare strategies."
  }, {
    "@language" : "es",
    "@value" : "Efecto de una intervención que sustituye las estrategias de una condición de salud (affects: la enfermedad o un elemento de su progresión) por una nueva estrategia o grupo de estrategias (hasReplacementStrategy). Se aplica en el brazo de la intervención y por tipo de estrategia (detección, es decir, cribado o diagnóstico; seguimiento; o tratamiento, es decir, línea de terapia): la nueva estrategia sustituye a las estrategias de su mismo tipo que declara la condición de salud (hasStrategy), o se le asigna si no tenía ninguna de ese tipo; las estrategias de otros tipos se mantienen. Si la sustitución es un grupo, cada miembro sustituye a las de su tipo. No usa magnitud (hasEffectMagnitude). Dos sustituciones de estrategia sobre la misma condición de salud en un mismo brazo son un error. Es la única forma de que una intervención declare estrategias."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Efecto de sustitución de estrategia"
  }, {
    "@language" : "en",
    "@value" : "Strategy replacement effect"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Effect"
  }, {
    "@id" : "_:genid623"
  }, {
    "@id" : "_:genid624"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#SuccessOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "El éxito de una estrategia. En una simulación, si no define su propio riesgo, llega con la duración de la condición de salud (hasDuration), modificada por los efectos. Es el resultado al que sigue followedOnSuccessBy en la forma abreviada (ver failsIf)."
  }, {
    "@language" : "en",
    "@value" : "The success of a strategy. In a simulation, if it does not define its own risk, it arrives with the duration of the health condition (hasDuration), modified by the effects. It is the outcome followed by followedOnSuccessBy in the short form (see failsIf)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Success outcome"
  }, {
    "@language" : "es",
    "@value" : "Éxito"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#TODO",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#TherapeuticIntervention",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An intervention driven by a set of drugs and/or treatments"
  }, {
    "@language" : "es",
    "@value" : "Una intervención basada en un conjunto de fármacos o tratamientos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Intervención terapéutica"
  }, {
    "@language" : "en",
    "@value" : "Therapeutic intervention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Intervention"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid632"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#TreatmentCat",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#HealthCareCat"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "es",
    "@value" : "Tratamiento"
  }, {
    "@language" : "en",
    "@value" : "Treatment"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An outcome of a strategy that is not a detection strategy (e.g., a partial response, a discontinuation or a death caused by the treatment). Its risk (hasOutcomeRisk) is a probability per episode or a time to event; resolvesHealthCondition says whether it resolves the health condition. Categories without effect on the computations (e.g., complete or partial response) should be expressed with hasCategory."
  }, {
    "@language" : "es",
    "@value" : "Un resultado de una estrategia que no es de detección (p. ej., una respuesta parcial, una interrupción o una muerte causada por el tratamiento). Su riesgo (hasOutcomeRisk) es una probabilidad por episodio o un tiempo hasta el evento; resolvesHealthCondition indica si resuelve la condición de salud. Las categorías sin efecto en los cálculos (p. ej., respuesta completa o parcial) deberían expresarse con hasCategory."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Resultado de un tratamiento"
  }, {
    "@language" : "en",
    "@value" : "Treatment outcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"
  }, {
    "@id" : "_:genid636"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#UniformDistributionExpression",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A bounded continuous probability distribution, where the occurrence of an event is equally probable inside the defined limits"
  }, {
    "@language" : "es",
    "@value" : "Una distribución de probabilidad continua y acotada, en la que la aparición de un evento es igual de probable dentro de los límites definidos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Expresión para distribución de probabilidad Uniforme"
  }, {
    "@language" : "en",
    "@value" : "Expression for a Uniform probability distribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"
  }, {
    "@id" : "_:genid637"
  }, {
    "@id" : "_:genid638"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#Utility",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "La utilidad (o desutilidad) autopercibida de un estado de salud, usada para calcular los años de vida ajustados por calidad"
  }, {
    "@language" : "en",
    "@value" : "The self-perceived utility (or disutility) of a health state, used to compute quality-adjusted life years"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Utilidad"
  }, {
    "@language" : "en",
    "@value" : "Utility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  }, {
    "@id" : "_:genid647"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid639"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#YearDependantParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A parameter whose value depends on the year, such as costs"
  }, {
    "@language" : "es",
    "@value" : "Un parámetro cuyo valor depende del año, como los costes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Parámetro dependiente del año"
  }, {
    "@language" : "en",
    "@value" : "Year-Dependent Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid648"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#affects",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define una relación entre un efecto y un atributo, parámetro o condición de salud, indicando que el efecto lo afecta. Una condición de salud solo puede verse afectada por un StrategyReplacementEffect; el resto de efectos afectan a atributos o parámetros."
  }, {
    "@language" : "en",
    "@value" : "Defines a relationship between an effect and an attribute, parameter or health condition, indicating that the effect affects it. A health condition can only be affected by a StrategyReplacementEffect; the rest of effects affect attributes or parameters."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Effect"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "afecta"
  }, {
    "@language" : "en",
    "@value" : "affects"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid1"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isAffectedBy"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#affectsProgressionElement",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la regla de combinación que afecta a cierto elemento de progresión"
  }, {
    "@language" : "en",
    "@value" : "Defines the combination rule that affects certain progression element"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "afecta al elemento de progresión"
  }, {
    "@language" : "en",
    "@value" : "affects progression element"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#appliesOneTime",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el comportamiento temporal de un parámetro (en general, un coste o una utilidad): si es verdadero, se aplica al aparecer algún elemento del modelo (enfermedad, progresión de la enfermedad...); en otro caso, se supone que se aplica anualmente. Las utilidades por episodio son pérdidas de AVAC de una vez, que se suman cuando se aplica una estrategia o un resultado de una estrategia (StrategyOutcome), o cuando aparece una manifestación. Los costes y utilidades de un resultado de una estrategia se aplican una vez."
  }, {
    "@language" : "en",
    "@value" : "Defines the temporal behavior of a parameter (generally a cost or utility): if true, applies upon onset of some model item (disease, disease progression...); otherwise, it is assumed to apply annually. Per-episode utilities are one-time QALY losses, which are added when a strategy or an outcome of a strategy (StrategyOutcome) is applied, or when a manifestation appears. The costs and utilities of an outcome of a strategy apply once."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid155"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "applies one time"
  }, {
    "@language" : "es",
    "@value" : "se aplica una única vez"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#causesFailOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "La condición de salud o el parámetro que hace fracasar una estrategia (inversa de failsIf, que describe su semántica)."
  }, {
    "@language" : "en",
    "@value" : "The health condition or parameter that makes a strategy fail (inverse of failsIf, which describes its semantics)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid5"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "causa el fallo de"
  }, {
    "@language" : "en",
    "@value" : "causes fail of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#failsIf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#contributor",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#creator",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#dependsOn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relaciona un parámetro calculado con cada atributo o parámetro referenciado en su expresión (hasExpressionValue). Todo elemento que aparezca en la expresión debería declararse con esta propiedad, para que las herramientas puedan resolver las dependencias del parámetro sin analizar la expresión."
  }, {
    "@language" : "en",
    "@value" : "Relates a calculated parameter to each attribute or parameter referenced in its expression (hasExpressionValue). Every element referenced in the expression should be declared with this property, so that tools can resolve the dependencies of the parameter without parsing the expression."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "depende de"
  }, {
    "@language" : "en",
    "@value" : "depends on"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid8"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasDependantCalculatedParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#detects",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Indica la enfermedad o enfermedades que detecta una estrategia de detección. La enfermedad que detecta una intervención de detección es su objetivo (isInterventionOf)."
  }, {
    "@language" : "en",
    "@value" : "Indicates the disease or diseases detected by a detection strategy. The disease detected by a detection intervention is its target (isInterventionOf)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "detecta"
  }, {
    "@language" : "en",
    "@value" : "detects"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Disease"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isDetectedBy"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#failsIf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Forma abreviada de dos resultados de una estrategia: un FailureOutcome y un SuccessOutcome (ver StrategyOutcome). El fracaso ocurre con la probabilidad por episodio o el tiempo hasta el evento del parámetro (según su tipo de dato), o cuando aparece la condición de salud (p. ej., la progresión de la enfermedad, o un efecto adverso de la estrategia, que modela el abandono del tratamiento). El éxito es el resultado por defecto (en una simulación, llega con la duración de la condición de salud, modificada por los efectos). Las estrategias siguientes las dan followedOnFailureBy y followedOnSuccessBy, y resolvesOnSuccess indica si el éxito resuelve la condición de salud. No puede combinarse con hasStrategyOutcome."
  }, {
    "@language" : "en",
    "@value" : "Short form of two outcomes of a strategy: a FailureOutcome and a SuccessOutcome (see StrategyOutcome). The failure happens with the probability per episode or the time to event of the parameter (according to its data item type), or when the health condition appears (e.g., the progression of the disease, or an adverse event of the strategy, which models the abandonment of the treatment). The success is the default outcome (in a simulation, it arrives with the duration of the health condition, modified by the effects). The next strategies are given by followedOnFailureBy and followedOnSuccessBy, and resolvesOnSuccess says whether the success resolves the health condition. It cannot be combined with hasStrategyOutcome."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "fails if"
  }, {
    "@language" : "es",
    "@value" : "falla si"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid11"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#followedByStrategy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "For a strategy: the strategy scheduled after it ends, whatever its outcome, unless the outcome declares its own next strategy. For a detection strategy that only declares its sensitivity and specificity, the next strategy is applied to the positive results (e.g., a confirmatory diagnosis). For an outcome of a strategy (StrategyOutcome): the strategy that follows such outcome."
  }, {
    "@language" : "es",
    "@value" : "Para una estrategia: la estrategia programada tras su final, sea cual sea su resultado, salvo que el resultado declare su propia estrategia siguiente. Para una estrategia de detección que solo declara su sensibilidad y especificidad, la estrategia siguiente se aplica a los resultados positivos (p. ej., un diagnóstico de confirmación). Para un resultado de una estrategia (StrategyOutcome): la estrategia que sigue a ese resultado."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid14"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "followed by strategy"
  }, {
    "@language" : "es",
    "@value" : "seguido por la estrategia"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#followsStrategy"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#followedOnFailureBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Forma abreviada (ver failsIf): la estrategia que sigue al fracaso de una estrategia."
  }, {
    "@language" : "en",
    "@value" : "Short form (see failsIf): the strategy that follows the failure of a strategy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "followed on failure by"
  }, {
    "@language" : "es",
    "@value" : "seguida en caso de fracaso por"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#followedOnSuccessBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Forma abreviada (ver failsIf): la estrategia que sigue al éxito de una estrategia. Para modelar una recaída tras la respuesta, el éxito va seguido de una estrategia de seguimiento (FollowUpStrategy) cuyo fracaso es la recaída, con la probabilidad de recaída entre los pacientes que respondieron; ese fracaso puede ir seguido del tratamiento de la recaída."
  }, {
    "@language" : "en",
    "@value" : "Short form (see failsIf): the strategy that follows the success of a strategy. To model a relapse after the response, the success is followed by a follow-up strategy (FollowUpStrategy) whose failure is the relapse, with the probability of relapse among the patients who responded; that failure may be followed by the treatment of the relapse."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "followed on success by"
  }, {
    "@language" : "es",
    "@value" : "seguida en caso de éxito por"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#followsStrategy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la relación entre dos estrategias, en la que una sigue a la otra."
  }, {
    "@language" : "en",
    "@value" : "Defines the relationship between two strategies, where one follows the other."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "follows strategy"
  }, {
    "@language" : "es",
    "@value" : "sigue la estrategia"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid17"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasAdverseEvent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define un efecto adverso que la estrategia puede provocar cada vez que se aplica (ver AdverseEvent)."
  }, {
    "@language" : "en",
    "@value" : "Defines an adverse event that the strategy may cause each time it is applied (see AdverseEvent)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has adverse event"
  }, {
    "@language" : "es",
    "@value" : "tiene el efecto adverso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#AdverseEvent"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isAdverseEventOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la edad de la población, que puede usarse para definir las características de la enfermedad y de las intervenciones. El valor es la edad media de los individuos de la población."
  }, {
    "@language" : "en",
    "@value" : "Defines the age of the population, which can be used to define the characteristics of the disease and the interventions. The value is the average age of the individuals in the population."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has age"
  }, {
    "@language" : "es",
    "@value" : "tiene edad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid20"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#usesAttributeValue"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasAlfaParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el parámetro alfa de una distribución de probabilidad, que es el parámetro de forma que determina la asimetría de la distribución"
  }, {
    "@language" : "en",
    "@value" : "Defines the alpha parameter of a probability distribution, which is the shape parameter that determines the skewness of the distribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid158"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has alfa parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro alfa"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasAssessedIntervention",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relaciona un modelo con una intervención cuyo valor se evalúa en él. Normalmente es una, pero se admiten varias (p. ej. evaluaciones de múltiples tecnologías). El papel depende del modelo: la misma intervención puede ser comparador en otro."
  }, {
    "@language" : "en",
    "@value" : "Relates a model to an intervention whose value is being assessed in it. Usually one, but several are allowed (e.g. multiple technology appraisals). The role is specific to the model: the same intervention may be a comparator in another model."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Model"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has assessed intervention"
  }, {
    "@language" : "es",
    "@value" : "tiene la intervención evaluada"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Intervention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#includesModelItem"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isAssessedInterventionOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasAttributeValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define un valor para un atributo, que debería usar una población o una enfermedad"
  }, {
    "@language" : "en",
    "@value" : "Defines a value for an attribute, which should be used by a population and/or disease"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Attribute"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has attribute value"
  }, {
    "@language" : "es",
    "@value" : "tiene el valor del atributo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasAuthor",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el autor de un modelo. Puede servir, por ejemplo, para reconocer la autoría del modelo o para indicar a quién dirigir las preguntas sobre él."
  }, {
    "@language" : "en",
    "@value" : "Defines the author of a model. This can be useful for defining the author of a model, for example, to give credit to the creator of the model or to provide contact information for questions about the model."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Model"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has author"
  }, {
    "@language" : "es",
    "@value" : "tiene el autor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasAverageParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el parámetro de la media de una distribución de probabilidad. Es útil para las distribuciones de probabilidad definidas por su media y otro parámetro, como la distribución normal (definida por su media y su desviación estándar) o la distribución de Poisson (definida por su media, que es también su parámetro lambda)."
  }, {
    "@language" : "en",
    "@value" : "Defines the average parameter of a probability distribution, which is the mean of the distribution. This is useful for probability distributions which are defined by their mean and another parameter, such as the normal distribution (defined by its mean and standard deviation) or the Poisson distribution (defined by its mean, which is also its lambda parameter)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has average parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro promedio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasBetaParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el parámetro beta de una distribución beta, que es el parámetro de forma que determina la asimetría de la distribución"
  }, {
    "@language" : "en",
    "@value" : "Defines the beta parameter of a beta distribution, which is the shape parameter that determines the skewness of the distribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#BetaDistributionExpression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has beta parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro beta"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasCalculationMethod",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el método usado para calcular un elemento de datos de calidad de vida, por ejemplo, una utilidad o desutilidad. Puede servir, por ejemplo, para definir el método usado para calcular una utilidad o desutilidad a partir de un cuestionario."
  }, {
    "@language" : "en",
    "@value" : "Defines the method used to calculate a quality of life data item, for example, a utility or disutility. This can be useful for defining the method used to calculate a utility or disutility from a questionnaire, for example."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#QoLDataItemType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has calculation method"
  }, {
    "@language" : "es",
    "@value" : "tiene el método de cálculo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasCategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Asocia un coste o una estrategia con un concepto SKOS usado con fines de clasificación y análisis."
  }, {
    "@language" : "en",
    "@value" : "Associates a cost or a strategy with a SKOS concept used for classification and analysis purposes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid21"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has category"
  }, {
    "@language" : "es",
    "@value" : "tiene categoría"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasComparatorIntervention",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relaciona un modelo con una intervención usada como comparador de la(s) intervención(es) evaluada(s)."
  }, {
    "@language" : "en",
    "@value" : "Relates a model to an intervention used as comparator of the assessed intervention(s)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Model"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has comparator intervention"
  }, {
    "@language" : "es",
    "@value" : "tiene la intervención como comparador"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Intervention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#includesModelItem"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isComparatorInterventionOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasConditionExpression",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "It allows expressing conditions based on parameters that we will find in the model. For example, we can find that certain drugs will be administered depending on the weight or age of the patient."
  }, {
    "@language" : "es",
    "@value" : "Permite expresar condiciones basadas en parámetros del modelo. Por ejemplo, ciertos fármacos se administran según el peso o la edad del paciente."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid25"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has condition expression"
  }, {
    "@language" : "es",
    "@value" : "tiene la expresión de condición"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isConditionExpressionOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasCost",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el coste de una condición de salud, tecnología sanitaria, intervención, ruta o estrategia."
  }, {
    "@language" : "en",
    "@value" : "Defines the cost of a health condition, health technology, intervention, pathway or strategy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid28"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has cost"
  }, {
    "@language" : "es",
    "@value" : "tiene el coste"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Cost"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasCostCombinationMethod",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el método usado para combinar los costes anuales de todos los elementos del modelo activos al mismo tiempo. Los métodos de combinación se aplican, en cada momento, al conjunto de elementos del modelo (enfermedad, progresiones clínicas, intervenciones) activos simultáneamente para un individuo: en un árbol de decisión, los elementos del camino hasta cada hoja; en una simulación de eventos discretos, el estado del paciente entre dos eventos consecutivos. Los métodos con el sufijo _DISTINCT cuentan una sola vez el individuo de un parámetro compartido por varios elementos activos simultáneamente (p. ej., la misma visita de seguimiento requerida por dos manifestaciones). ADD suma todos los costes; ADD_DISTINCT suma los costes, pero cuenta una sola vez cada parámetro de coste. Los costes de una vez (appliesOneTime = true) no se ven afectados por este método: siempre se suman, una vez por cada evento que los provoca. Si no se define, se supone ADD."
  }, {
    "@language" : "en",
    "@value" : "Defines the method used to combine the annual costs of all the model items that are active at the same time. Combination methods are applied, at any moment, to the set of model items (disease, clinical progressions, interventions) that are simultaneously active for an individual: in a decision tree, the items along the path to each leaf; in a discrete-event simulation, the state of the patient between two consecutive events. Methods suffixed with _DISTINCT count only once a parameter individual that is shared by several simultaneously active items (e.g., the same follow-up visit required by two manifestations). ADD sums every cost; ADD_DISTINCT sums the costs, but counts only once each cost parameter. One-time costs (appliesOneTime = true) are not affected by this method: they are always added, once per triggering event. If not defined, ADD is assumed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has cost combination method"
  }, {
    "@language" : "es",
    "@value" : "tiene el método de combinación de costes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid161"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasCount",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Número total de aplicaciones de la pauta (p. ej. una vacuna de 3 dosis). Puede usarse en lugar de hasDuration o junto a ella; si están ambas, la pauta termina con lo que ocurra antes."
  }, {
    "@language" : "en",
    "@value" : "Total number of applications of the guideline (e.g. a vaccine with 3 doses). May be used instead of, or together with, hasDuration; if both are present the guideline ends at whichever comes first."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has count"
  }, {
    "@language" : "es",
    "@value" : "tiene el número de aplicaciones"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasDataItemType",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el tipo de elemento de datos que representa el parámetro, que puede usarse para determinar cómo usar el parámetro en el modelo y cómo obtener su valor."
  }, {
    "@language" : "en",
    "@value" : "Defines the type of data item that represents the parameter, which can be used to determine how to use the parameter in the model and how to obtain its value."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has data item type"
  }, {
    "@language" : "es",
    "@value" : "tiene el tipo de datos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DataItemType"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isDataItemTypeOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasDependantCalculatedParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define un parámetro calculado que depende de otros parámetros."
  }, {
    "@language" : "en",
    "@value" : "Defines a calculated parameter that depends on other parameters."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid36"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has dependant calculated parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro calculado dependiente"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasDescription",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Descripción legible por personas de un individuo, pensada para mostrarse en los modelos generados (p. ej., en las hojas de parámetros). Se espera un valor por idioma."
  }, {
    "@language" : "en",
    "@value" : "Human-readable description of an individual, intended to be shown in generated models (e.g. parameter sheets). One value per language is expected."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has description"
  }, {
    "@language" : "es",
    "@value" : "tiene la descripción"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasDiscountForCosts",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la tasa de descuento de los costes en el experimento."
  }, {
    "@language" : "en",
    "@value" : "Defines the discount rate for costs in the experiment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has discount for costs"
  }, {
    "@language" : "es",
    "@value" : "tiene el descuento para costos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasDiscountForEffects",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la tasa de descuento de los efectos en el experimento."
  }, {
    "@language" : "en",
    "@value" : "Defines the discount rate for effects in the experiment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has discount for effects"
  }, {
    "@language" : "es",
    "@value" : "tiene el descuento para efectos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasDisutilityCombinationMethod",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el método usado para combinar las desutilidades anuales de todos los elementos del modelo activos al mismo tiempo. Los métodos de combinación se aplican, en cada momento, al conjunto de elementos del modelo (enfermedad, progresiones clínicas, intervenciones) activos simultáneamente para un individuo: en un árbol de decisión, los elementos del camino hasta cada hoja; en una simulación de eventos discretos, el estado del paciente entre dos eventos consecutivos. Los métodos con el sufijo _DISTINCT cuentan una sola vez el individuo de un parámetro compartido por varios elementos activos simultáneamente (p. ej., la misma visita de seguimiento requerida por dos manifestaciones). ADD suma todas las desutilidades; ADD_DISTINCT las suma, pero cuenta una sola vez cada parámetro de utilidad; MAX aplica solo la mayor desutilidad. Las desutilidades de una vez siempre se suman, una vez por cada evento que las provoca. Si no se define, se supone ADD."
  }, {
    "@language" : "en",
    "@value" : "Defines the method used to combine the annual disutilities of all the model items that are active at the same time. Combination methods are applied, at any moment, to the set of model items (disease, clinical progressions, interventions) that are simultaneously active for an individual: in a decision tree, the items along the path to each leaf; in a discrete-event simulation, the state of the patient between two consecutive events. Methods suffixed with _DISTINCT count only once a parameter individual that is shared by several simultaneously active items (e.g., the same follow-up visit required by two manifestations). ADD sums every disutility; ADD_DISTINCT sums them, but counts only once each utility parameter; MAX applies only the largest disutility. One-time disutilities are always added, once per triggering event. If not defined, ADD is assumed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has disutility combination method"
  }, {
    "@language" : "es",
    "@value" : "tiene el método de combinación de disutilidades"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid164"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasDose",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Dose administered in each application of the guideline. The unit (e.g. mg, mg/kg) is stated by the MeasuredDataItemType of the parameter."
  }, {
    "@language" : "es",
    "@value" : "Dosis administrada en cada aplicación de la pauta. La unidad (p. ej. mg, mg/kg) se indica en el MeasuredDataItemType del parámetro."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has dose"
  }, {
    "@language" : "es",
    "@value" : "tiene la dosis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasDuration",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Duración de un elemento de progresión clínica o de la aplicación de una pauta. Se expresa en años. En una combinación secuencial, un paso termina cuando se agota su duración."
  }, {
    "@language" : "en",
    "@value" : "Duration of a clinical progression element or of the application of a guideline. Expressed in years. In a sequential combination, a step ends when its duration expires. In a simulation, the success of a strategy (SuccessOutcome) without its own risk arrives with the duration of the health condition to which the strategy is applied, modified by the effects."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid39"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has duration"
  }, {
    "@language" : "es",
    "@value" : "tiene la duración"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasEffect",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define una relación entre una condición de salud, intervención, ruta, población o elemento de uso de recursos y un efecto, indicando que la condición de salud, intervención, ruta, población o elemento de uso de recursos tiene cierto efecto sobre la progresión de la enfermedad o sobre los pacientes."
  }, {
    "@language" : "en",
    "@value" : "Defines a relationship between a health condition, intervention, pathway, population or resource usage item and an effect, indicating that the health condition, intervention, pathway, population or resource usage item has a certain effect on the disease progression or on the patients."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid42"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has effect"
  }, {
    "@language" : "es",
    "@value" : "tiene el efecto"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Effect"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isEffectOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasEffectMagnitude",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el parámetro que define la magnitud del efecto. El tipo de dato de la magnitud define cómo se aplica a cada parámetro o atributo afectado (x) en un Effect genérico: un factor (DI_Factor) o una razón (DI_Ratio) multiplica (x * m); un riesgo relativo (DI_RelativeRisk) o un hazard ratio (DI_HazardRatio) sobre una probabilidad multiplica la tasa constante equivalente, es decir, 1 - (1 - x)^m; un hazard ratio sobre un tiempo hasta el evento sin distribución divide el tiempo medio (x / m), suponiendo un tiempo exponencial; una odds ratio (DI_OddsRatio) sobre una probabilidad multiplica la odds, es decir, x * m / (1 - x + x * m); una diferencia de medias (DI_MeanDifference) se resta (x - m). Cualquier otro tipo es un valor absoluto que sustituye al elemento afectado; DI_Continuous_Variable siempre sustituye, y un tipo que no coincida con el del elemento afectado debería producir un aviso. Una magnitud relativa siempre modifica el elemento afectado, aunque ambos compartan el mismo tipo. Los estadísticos de la incertidumbre (desviación estándar, límites de confianza) no son magnitudes válidas. Usa DI_Factor en lugar de DI_RelativeRisk para multiplicar una probabilidad de forma lineal (p. ej., cuando el riesgo relativo y la probabilidad proceden de la misma fuente y periodo)."
  }, {
    "@language" : "en",
    "@value" : "Defines the parameter that defines the magnitude of the effect. The data item type of the magnitude defines how it is applied to each affected parameter or attribute (x) in a generic Effect: a factor (DI_Factor) or a ratio (DI_Ratio) multiplies (x * m); a relative risk (DI_RelativeRisk) or a hazard ratio (DI_HazardRatio) on a probability multiplies the equivalent constant rate, i.e., 1 - (1 - x)^m; a hazard ratio on a time to event without a distribution divides the mean time (x / m), assuming an exponential time; an odds ratio (DI_OddsRatio) on a probability multiplies the odds, i.e., x * m / (1 - x + x * m); a mean difference (DI_MeanDifference) is subtracted (x - m). Any other type is an absolute value that replaces the affected item; DI_Continuous_Variable always replaces, and a type that does not match the type of the affected item should produce a warning. A relative magnitude always modifies the affected item, even if both share the same type. Statistics of the uncertainty (standard deviation, confidence limits) are not valid magnitudes. Use DI_Factor instead of DI_RelativeRisk to multiply a probability linearly (e.g., when the relative risk and the probability come from the same source and period)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Effect"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has magnitude effect"
  }, {
    "@language" : "es",
    "@value" : "tiene magnitud del efecto"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasEndAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la edad a la que termina cierta condición o enfermedad."
  }, {
    "@language" : "en",
    "@value" : "Defines the age at which a certain condition or disease ends."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has end age"
  }, {
    "@language" : "es",
    "@value" : "tiene la edad de finalización"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasEpidemiologicalParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define un parámetro epidemiológico de una enfermedad o una población, como la incidencia, la prevalencia, la mortalidad, etc."
  }, {
    "@language" : "en",
    "@value" : "Defines an epidemiological parameter of a disease or a population, such as the incidence, prevalence, mortality, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid49"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has epidemiological parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro epidemiológico"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#EpidemiologicalParameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasEvaluationTime",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Tiempo, en años desde el inicio de la estrategia, en que se evalúa el resultado (p. ej., una regla de parada que evalúa la respuesta a las 12 semanas). La estrategia y la condición de salud (si el resultado la resuelve) se detienen en ese momento, y empieza la estrategia siguiente. Sin tiempo de evaluación, un árbol de decisión supone que el resultado ocurre al inicio de la estrategia."
  }, {
    "@language" : "en",
    "@value" : "Time, in years since the start of the strategy, when the outcome is evaluated (e.g., a stopping rule that assesses the response at 12 weeks). The strategy and the health condition (if the outcome resolves it) stop at such time, and the next strategy starts. Without an evaluation time, a decision tree assumes that the outcome happens at the start of the strategy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has evaluation time"
  }, {
    "@language" : "es",
    "@value" : "tiene el momento de evaluación"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasExpectedValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "El valor esperado de un parámetro con incertidumbre. Es útil para los parámetros deterministas con incertidumbre, que pueden usarse en el análisis de sensibilidad determinista, y para los parámetros con incertidumbre de segundo orden, que se usan en el ASP de dos niveles."
  }, {
    "@language" : "en",
    "@value" : "The expected value of a parameter with uncertainty. This is useful for deterministic parameters with uncertainty, which can be used in deterministic sensitivity analysis, and for second-order uncertainty parameters, which are used in two-level PSA."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid168"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has expected value"
  }, {
    "@language" : "es",
    "@value" : "tiene el valor esperado"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasExpressionLanguage",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el lenguaje de expresión usado en un parámetro calculado, que puede ser cualquier lenguaje formal que permita expresar fórmulas matemáticas, como MathML u OpenMath."
  }, {
    "@language" : "en",
    "@value" : "Defines the expression language used in a calculated parameter, which can be any formal language that allows us to express mathematical formulas, such as MathML or OpenMath."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has expression language"
  }, {
    "@language" : "es",
    "@value" : "tiene el lenguage de expresión"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ExpressionLanguage"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isExpressionLanguageOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasExpressionValue",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty", "http://www.w3.org/2002/07/owl#FunctionalProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "La expresión, en un lenguaje formal, para calcular el valor de un parámetro calculado. La expresión debe escribirse con la sintaxis del lenguaje de expresión definido para ese parámetro (ver la propiedad isExpressionLanguageOf)."
  }, {
    "@language" : "en",
    "@value" : "The expression in a formal language to calculate the value of a calculated parameter. The expression must be written using the syntax of the expression language defined for that parameter (see property isExpressionLanguageOf)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has expression value"
  }, {
    "@language" : "es",
    "@value" : "tiene el valor de expresión"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasFirst",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Apunta al primero de un conjunto de elementos ordenados"
  }, {
    "@language" : "en",
    "@value" : "Points to the first of a set of ordered items"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#SequentialCombinationRule"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has first"
  }, {
    "@language" : "es",
    "@value" : "tiene primero"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasFrequency",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "For a guideline: number of applications per period (see hasPeriod), e.g. 3 applications every 1 day. For an acute manifestation: number of occurrences per year. In a decision tree, the frequency does not change the structure of the tree: the one-time payoffs of the acute manifestation, and of its strategies, outcomes and adverse events, are multiplied by the expected number of episodes within the time window of the manifestation."
  }, {
    "@language" : "es",
    "@value" : "Para una pauta: número de aplicaciones por periodo (ver hasPeriod), p. ej. 3 aplicaciones cada 1 día. Para una manifestación aguda: número de apariciones al año. En un árbol de decisión, la frecuencia no cambia la estructura del árbol: los pagos de una vez de la manifestación aguda, y de sus estrategias, resultados y efectos adversos, se multiplican por el número esperado de episodios dentro de la ventana temporal de la manifestación."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid52"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has frequency"
  }, {
    "@language" : "es",
    "@value" : "tiene la frecuencia"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasGeographicalContext",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el contexto geográfico de un modelo, parámetro o población. Puede servir, por ejemplo, para definir el ámbito de aplicación de un modelo o parámetro."
  }, {
    "@language" : "en",
    "@value" : "Defines the geographical context of a model, parameter or population. This can be useful for defining the scope of applicability of a model or parameter, for example."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid171"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has geographical context"
  }, {
    "@language" : "es",
    "@value" : "tiene el contexto geográfico"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasGroupItem",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Describe los elementos de un grupo"
  }, {
    "@language" : "en",
    "@value" : "Describes the items of a group"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Group"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has group item"
  }, {
    "@language" : "es",
    "@value" : "tiene el elemento del grupo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#GroupableModelItem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/RO_0002351"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isGroupItemOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasGuideline",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define una relación entre una tecnología sanitaria o una estrategia y una pauta, indicando que la pauta se aplica a la tecnología sanitaria o estrategia."
  }, {
    "@language" : "en",
    "@value" : "Defines a relationship between a health technology or a strategy and a guideline, indicating that the guideline is applied to the health technology or strategy."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid55"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has guideline"
  }, {
    "@language" : "es",
    "@value" : "tiene la pauta"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isGuidelineOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasInitialProportion",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la proporción inicial de pacientes de una población que ya presentan cierta manifestación"
  }, {
    "@language" : "en",
    "@value" : "Defines the initial proportion of patients of a population that already present certain manifestation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid58"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has initial proportion"
  }, {
    "@language" : "es",
    "@value" : "tiene la proporción inicial"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasIntervention",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el objetivo de una intervención: la condición de salud (la enfermedad o un elemento de su progresión) a la que se aplica. El tiempo 0 es el momento en que se aplica la intervención: todos los pacientes presentan su objetivo y la intervención está activa toda la simulación. Si el objetivo es una manifestación aguda, todos empiezan con un episodio (p. ej., una crisis de migraña). Cada intervención tiene exactamente un objetivo (ver isInterventionOf), y las intervenciones comparadas en un modelo deben tener el mismo objetivo. En una intervención de detección (cribado o diagnóstico), el objetivo es la enfermedad que detecta, y la intervención se aplica a la población en riesgo de padecerla, no solo a quienes la presentan."
  }, {
    "@language" : "en",
    "@value" : "Defines the target of an intervention: the health condition (the disease or an element of its progression) to which the intervention is applied. Time 0 is the moment when the intervention is applied: every patient presents its target, and the intervention is active during the whole simulation. If the target is an acute manifestation, every patient starts with an episode (e.g., a migraine attack). Every intervention has exactly one target (see isInterventionOf), and the interventions compared in a model must have the same target. For a detection intervention (screening or diagnosis), the target is the disease it detects, and the intervention applies to the population at risk of such disease, not only to those who present it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#HealthCondition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has intervention"
  }, {
    "@language" : "es",
    "@value" : "tiene la intervención"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Intervention"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isInterventionOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasLambdaParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el parámetro lambda de una distribución de probabilidad: la tasa en una distribución exponencial (media = 1 / lambda) y el número medio de eventos en una distribución de Poisson. La escala de una distribución gamma es hasThetaParameter (en OSDi 1.2 se llamaba hasLambdaParameter)."
  }, {
    "@language" : "en",
    "@value" : "Defines the lambda parameter of a probability distribution: the rate in an exponential distribution (mean = 1 / lambda) and the average number of events in a Poisson distribution. The scale of a gamma distribution is hasThetaParameter (in OSDi 1.2, it was called hasLambdaParameter)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid175"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has lambda parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro lambda"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasLifeExpectancy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la esperanza de vida de la población, que es el número medio de años que se espera que viva un individuo de la población. Este valor debe expresarse en años."
  }, {
    "@language" : "en",
    "@value" : "Defines the life expectancy of the population, which is the average number of years that an individual of the population is expected to live. This value must be expressed in number of years."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has life expectancy"
  }, {
    "@language" : "es",
    "@value" : "tiene la esperanza de vida"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasLifeExpectancyReductionCombinationMethod",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el método usado para combinar las reducciones de la esperanza de vida (magnitudes de LifeExpectancyReductionEffect, en años) de todos los elementos del modelo activos al mismo tiempo. Los métodos de combinación se aplican, en cada momento, al conjunto de elementos del modelo (enfermedad, progresiones clínicas, intervenciones) activos simultáneamente para un individuo: en un árbol de decisión, los elementos del camino hasta cada hoja; en una simulación de eventos discretos, el estado del paciente entre dos eventos consecutivos. Los métodos con el sufijo _DISTINCT cuentan una sola vez el individuo de un parámetro compartido por varios elementos activos simultáneamente (p. ej., la misma visita de seguimiento requerida por dos manifestaciones). ADD suma todas las reducciones; ADD_DISTINCT las suma, pero cuenta una sola vez cada parámetro de magnitud; MAX aplica solo la mayor reducción. Si no se define, se supone MAX. Primero se aplican los aumentos de la tasa de mortalidad (ver hasMortalityRateCombinationMethod), dividiendo la esperanza de vida por la tasa combinada; después se resta la reducción combinada de la esperanza de vida."
  }, {
    "@language" : "en",
    "@value" : "Defines the method used to combine the life expectancy reductions (magnitudes of LifeExpectancyReductionEffect, in years) of all the model items that are active at the same time. Combination methods are applied, at any moment, to the set of model items (disease, clinical progressions, interventions) that are simultaneously active for an individual: in a decision tree, the items along the path to each leaf; in a discrete-event simulation, the state of the patient between two consecutive events. Methods suffixed with _DISTINCT count only once a parameter individual that is shared by several simultaneously active items (e.g., the same follow-up visit required by two manifestations). ADD sums every reduction; ADD_DISTINCT sums them, but counts only once each magnitude parameter; MAX applies only the largest reduction. If not defined, MAX is assumed. Increased mortality rates (see hasMortalityRateCombinationMethod) are applied first, by dividing the life expectancy by the combined rate; then the combined life expectancy reduction is subtracted."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has life expectancy reduction combination method"
  }, {
    "@language" : "es",
    "@value" : "tiene el método de combinación de reducciones de esperanza de vida"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid178"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasLowerLimitParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el parámetro del límite inferior de una distribución uniforme"
  }, {
    "@language" : "en",
    "@value" : "Defines the lower limit parameter of a uniform distribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#UniformDistributionExpression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has lower limit parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro de límite inferior"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasMaxAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la edad máxima de una población"
  }, {
    "@language" : "en",
    "@value" : "Defines the maximum age of a population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has maximum age"
  }, {
    "@language" : "es",
    "@value" : "tiene la edad máxima"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasMaxApplicationAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Edad máxima (excluida) a la que se aplica la pauta."
  }, {
    "@language" : "en",
    "@value" : "Maximum age (exclusive) at which the guideline applies."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has maximum application age"
  }, {
    "@language" : "es",
    "@value" : "tiene la edad máxima de aplicación"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasMinAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la edad mínima de una población"
  }, {
    "@language" : "en",
    "@value" : "Defines the minimum age of a population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Population"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has minimum age"
  }, {
    "@language" : "es",
    "@value" : "tiene la edad mínima"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasMinApplicationAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Edad mínima (incluida) a la que se aplica la pauta. Junto con hasMaxApplicationAge, sustituye a hasRange. Para otras condiciones (peso, atributos...) usa hasConditionExpression."
  }, {
    "@language" : "en",
    "@value" : "Minimum age (inclusive) at which the guideline applies. Together with hasMaxApplicationAge, replaces hasRange. For other conditions (weight, attributes...) use hasConditionExpression."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has minimum application age"
  }, {
    "@language" : "es",
    "@value" : "tiene la edad mínima de aplicación"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasMortalityRateCombinationMethod",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el método usado para combinar los aumentos de la tasa de mortalidad (magnitudes de IncreasedMortalityRateEffect, expresadas como razones de tasas) de todos los elementos del modelo activos al mismo tiempo. Los métodos de combinación se aplican, en cada momento, al conjunto de elementos del modelo (enfermedad, progresiones clínicas, intervenciones) activos simultáneamente para un individuo: en un árbol de decisión, los elementos del camino hasta cada hoja; en una simulación de eventos discretos, el estado del paciente entre dos eventos consecutivos. MAX aplica solo la mayor razón de tasas; MULT las multiplica todas. Si no se define, se supone MAX. La razón de tasas combinada divide la esperanza de vida antes de aplicar cualquier reducción de la esperanza de vida (ver hasLifeExpectancyReductionCombinationMethod)."
  }, {
    "@language" : "en",
    "@value" : "Defines the method used to combine the increased mortality rates (magnitudes of IncreasedMortalityRateEffect, expressed as rate ratios) of all the model items that are active at the same time. Combination methods are applied, at any moment, to the set of model items (disease, clinical progressions, interventions) that are simultaneously active for an individual: in a decision tree, the items along the path to each leaf; in a discrete-event simulation, the state of the patient between two consecutive events. MAX applies only the largest rate ratio; MULT multiplies all of them. If not defined, MAX is assumed. The combined rate ratio divides the life expectancy before applying any life expectancy reduction (see hasLifeExpectancyReductionCombinationMethod)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has mortality rate combination method"
  }, {
    "@language" : "es",
    "@value" : "tiene el método de combinación de tasas de mortalidad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid182"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasNext",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Apunta al siguiente elemento del modelo ordenado"
  }, {
    "@language" : "en",
    "@value" : "Points to the next ordered model item"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has next"
  }, {
    "@language" : "es",
    "@value" : "tiene siguiente"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasPrevious"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasNullProgression",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Indica que una regla de combinación de alternativas define una opción de «ninguna de las anteriores»"
  }, {
    "@language" : "en",
    "@value" : "Indicates that an alternative rule combination defines an option for \"none of the above\""
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#AlternativeCombinationRule"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has null progression"
  }, {
    "@language" : "es",
    "@value" : "tiene progresión nula"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasNumberOfPSARuns",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el número de ejecuciones del análisis de sensibilidad probabilístico (ASP) en el experimento"
  }, {
    "@language" : "en",
    "@value" : "Defines the number of runs for the probabilistic sensitivity analysis (PSA) in the experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has number of PSA runs"
  }, {
    "@language" : "es",
    "@value" : "tiene número de ejecuciones de PSA"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasNumberOfSimulatedIndividuals",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el número de individuos simulados en el experimento"
  }, {
    "@language" : "en",
    "@value" : "Defines the number of simulated individuals in the experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Experiment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has number of simulated individuals"
  }, {
    "@language" : "es",
    "@value" : "tiene número de individuos simulados"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasOffsetParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el parámetro de desplazamiento de una distribución de probabilidad, que es un valor que se suma a la variable aleatoria definida por la distribución. Es útil para definir distribuciones que solo pueden tomar valores por encima o por debajo de cierto umbral (por ejemplo, un desplazamiento de 1 en una distribución de Poisson define una distribución que solo puede tomar valores de 1 a infinito, en lugar de 0 a infinito)."
  }, {
    "@language" : "en",
    "@value" : "Defines the offset parameter of a probability distribution, which is a value that is added to the random variable defined by the distribution. This is useful for defining distributions that can only take values above or below a certain threshold (for example, an offset of 1 in a Poisson distribution would define a distribution that can only take values from 1 to infinite, instead of from 0 to infinite)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has offset parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro de desplazamiento"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasOnsetAge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la edad a la que aparece cierta manifestación de la enfermedad. Este valor debe expresarse en años."
  }, {
    "@language" : "en",
    "@value" : "Defines the age at which a certain manifestation of the disease appears. This value must be expressed in number of years."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has onset age"
  }, {
    "@language" : "es",
    "@value" : "tiene la edad de inicio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasOutcomeRisk",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "How likely an outcome of a strategy is. Its data item type expresses it: a probability per episode (used by decision trees) or a time to event (used by simulations); the application converts one into the other when it can, and warns when it cannot. The outcome without risk of a strategy (at most one) is the default outcome: it takes the remaining probability (1 minus the sum of the rest)."
  }, {
    "@language" : "es",
    "@value" : "Lo probable que es un resultado de una estrategia. Lo expresa su tipo de dato: una probabilidad por episodio (la que usan los árboles de decisión) o un tiempo hasta el evento (el que usan las simulaciones); la aplicación convierte uno en otro cuando puede, y avisa cuando no puede. El resultado sin riesgo de una estrategia (como mucho uno) es el resultado por defecto: se lleva la probabilidad restante (1 menos la suma del resto)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has outcome risk"
  }, {
    "@language" : "es",
    "@value" : "tiene el riesgo del resultado"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define una relación entre una enfermedad, intervención, ruta, población o elemento de uso de recursos y un parámetro, indicando que el parámetro se usa para caracterizar la enfermedad, intervención, ruta, población o elemento de uso de recursos."
  }, {
    "@language" : "en",
    "@value" : "Defines a relationship between a disease, intervention, pathway, population or resource usage item and a parameter, indicating that the parameter is used to characterize the disease, intervention, pathway, population or resource usage item."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ModelItem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isParameterOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasPeriod",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Duración del periodo al que se refiere la frecuencia, p. ej. 8 (horas) en 'una dosis cada 8 horas'. La unidad por defecto es horas. Sustituye a hasHoursInterval."
  }, {
    "@language" : "en",
    "@value" : "Length of the period to which the frequency refers, e.g. 8 (hours) for 'one dose every 8 hours'. Default unit is hours. Replaces hasHoursInterval."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has period"
  }, {
    "@language" : "es",
    "@value" : "tiene el periodo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasPrevious",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Apunta al elemento del modelo ordenado anterior"
  }, {
    "@language" : "en",
    "@value" : "Points to the previous ordered model item"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has previous"
  }, {
    "@language" : "es",
    "@value" : "tiene anterior"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define un parámetro de una distribución de probabilidad. Es una propiedad general que puede usarse para cualquier parámetro de cualquier distribución de probabilidad, pero se proporcionan subpropiedades más específicas para los parámetros más habituales (media, varianza, lambda, etc.)"
  }, {
    "@language" : "en",
    "@value" : "Defines a parameter of a probability distribution. This is a general property which can be used for any parameter of any probability distribution, but more specific subproperties are provided for the most common parameters (average, variance, lambda, etc.)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has probability distribution parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro de distribución de probabilidad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define el parámetro de probabilidad de una distribución de Bernoulli"
  }, {
    "@language" : "en",
    "@value" : "Defines the probability parameter of a Bernoulli distribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#BernoulliDistributionExpression"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has probability parameter"
  }, {
    "@language" : "es",
    "@value" : "tiene el parámetro de probabilidad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#double"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProgressionElement",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define una relación entre una enfermedad y su elemento de progresión, indicando que un individuo afectado por la enfermedad puede presentar el elemento de progresión."
  }, {
    "@language" : "en",
    "@value" : "Defines a relationship between a disease and its progression element, indicating that an individual affected by the disease can have the progression element."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid63"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has progression element"
  }, {
    "@language" : "es",
    "@value" : "has progression element"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DiseaseProgressionElement"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#isProgressionElementOf"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasProportionWithinGroup",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define la proporción de pacientes que presentan una característica dentro de un grupo. Por ejemplo, la proporción de pacientes que presentan una manifestación dentro de un estadio de la enfermedad, o la proporción de pacientes que reciben una intervención dentro de una estrategia. Para una estrategia, es la proporción de pacientes que la reciben dentro de un grupo de estrategias alternativas que sigue a una estrategia o a uno de sus resultados (followedByStrategy, followedOnFailureBy, followedOnSuccessBy): cada paciente recibe una de las estrategias del grupo, y como mucho una de ellas puede no declarar esta propiedad, con lo que se lleva el resto. La proporción es una propiedad de la estrategia, así que es la misma en todos los grupos a los que pertenece."
  }, {
    "@language" : "en",
    "@value" : "Defines the proportion of patients that present a certain characteristic within a group. For example, the proportion of patients that present a certain manifestation within a stage of the disease, or the proportion of patients that receive a certain intervention within a strategy. For a strategy, it is the proportion of patients that receive it within a group of alternative strategies that follows a strategy or one of its outcomes (followedByStrategy, followedOnFailureBy, followedOnSuccessBy): each patient receives one of the strategies of the group, and at most one of them may lack this property, taking the rest. The proportion is a property of the strategy, so it is the same in every group the strategy belongs to."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#GroupableModelItemWithProportion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has proportion within group"
  }, {
    "@language" : "es",
    "@value" : "tiene la proporción dentro del grupo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Parameter"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasParameter"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasRefTo",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Reference to the corresponding item in an external ontology or database, if available"
  }, {
    "@language" : "es",
    "@value" : "Referencia al elemento correspondiente de una ontología o base de datos externa, si existe"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid185"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has reference to"
  }, {
    "@language" : "es",
    "@value" : "tiene la referencia a"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasRefToDO",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Reference to the corresponding item in DO, if available"
  }, {
    "@language" : "es",
    "@value" : "Referencia al elemento correspondiente de DO, si existe"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Disease"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has reference to DO"
  }, {
    "@language" : "es",
    "@value" : "tiene la referencia a DO"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasRefTo"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#hasRefToGARD",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Reference to the corresponding item in GARD, if available"
  }, {
    "@language" : "es",
    "@value" : "Referencia al elemento correspondiente de GARD, si existe"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#RareDisease"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has reference to GARD"
  }, {
    "@language" : "es",
    "@value" : "tiene la referencia a GARD"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
