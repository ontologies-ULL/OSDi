    } ]
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid449"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#MarkovModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Model based on Markov states and transitions"
  }, {
    "@language" : "es",
    "@value" : "Modelo basado en estados y transiciones de Markov"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Markov model"
  }, {
    "@language" : "es",
    "@value" : "Modelo de Markov"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Model"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#MeasuredDataItemType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Tipo para elementos de datos medibles"
  }, {
    "@language" : "en",
    "@value" : "Type for data items that are measurable"
