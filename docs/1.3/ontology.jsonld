}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DI_HazardRatio",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DataItemType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "As the magnitude of an effect, it multiplies the rate equivalent to a probability (1 - (1 - p)^HR), or divides the mean of a time to event, which is assumed exponential if it has no distribution"
  }, {
    "@language" : "es",
    "@value" : "Como magnitud de un efecto, multiplica la tasa equivalente a una probabilidad (1 - (1 - p)^HR), o divide la media de un tiempo hasta el evento, que se supone exponencial si no tiene distribución"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Hazard ratio"
  }, {
    "@language" : "es",
    "@value" : "Razón de riesgos instantáneos"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@value" : "The ratio of the hazard rates of an event in two groups"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO" : [ {
    "@value" : "http://purl.obolibrary.org/obo/STATO_0000677"
  } ]
