}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#NegativeDetectionOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A negative result of a detection strategy: the individual is not detected (false negative if diseased, true negative otherwise)."
  }, {
    "@language" : "es",
    "@value" : "Un resultado negativo de una estrategia de detección: el individuo no es detectado (falso negativo si tiene la enfermedad, verdadero negativo en otro caso)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Negative detection outcome"
  }, {
    "@language" : "es",
    "@value" : "Resultado negativo de una detección"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#NormalDistributionExpression",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Distribución de probabilidad continua, no acotada y simétrica, caracterizada por dos parámetros: la media, que coincide con la moda de la distribución, y la desviación estándar."
  }, {
    "@language" : "en",
    "@value" : "Unbounded and symmetric continuous probability distribution, characterized by two parameters: average, that falls in the mode of the distribution, and standard deviation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Expresión para distribución de probabilidad Normal"
  }, {
    "@language" : "en",
    "@value" : "Expression for a Normal probability distribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"
  }, {
    "@id" : "_:genid512"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A model item that has a specific order with respect to other model items, such as the stage of a disease"
  }, {
    "@language" : "es",
    "@value" : "Un elemento del modelo que tiene un orden concreto respecto a otros elementos del modelo, como el estadio de una enfermedad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Elemento del modelo ordenado"
  }, {
    "@language" : "en",
    "@value" : "Ordered Model Item"
  } ],
