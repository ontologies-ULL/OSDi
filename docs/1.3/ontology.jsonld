  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Continuous probability distributions defined on the interval [0, 1] parametrized by two positive shape parameters, alfa and beta, generally estimated from the number of 'cases' and 'no cases' from an event"
  }, {
    "@language" : "es",
    "@value" : "Distribuciones de probabilidad continuas definidas en el intervalo [0, 1] y parametrizadas por dos parámetros de forma positivos, alfa y beta, que suelen estimarse a partir del número de «casos» y «no casos» de un evento"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Expresión para distribución de probabilidad Beta"
  }, {
    "@language" : "en",
    "@value" : "Expression for a Beta probability distribution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"
  }, {
    "@id" : "_:genid216"
  }, {
    "@id" : "_:genid217"
  }, {
    "@id" : "_:genid218"
  } ]
}, {
