  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A set of disease progressions which can coexist at the same time, e.g. seizures and skin problems."
  }, {
    "@language" : "es",
    "@value" : "Un conjunto de progresiones de la enfermedad que pueden coexistir al mismo tiempo, p. ej., crisis epilépticas y problemas de piel."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Coexistent disease progression set"
  }, {
    "@language" : "es",
    "@value" : "Conjunto de progresiones de enfermedad coexistentes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#CompositeGuideline",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A guideline made up of at least one sub-guideline. Inferred automatically. Values defined on a composite guideline (e.g. route, application age) are inherited by its sub-guidelines unless they redefine them."
  }, {
    "@language" : "es",
    "@value" : "Pauta formada por al menos una subpauta. Se infiere automáticamente. Los valores definidos en una pauta compuesta (p. ej. vía, edad de aplicación) los heredan sus subpautas salvo que los redefinan."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Composite guideline"
  }, {
    "@language" : "es",
    "@value" : "Pauta compuesta"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Guideline"
  }, {
    "@id" : "_:genid261"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid257"
  } ]
