  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#MeasuredDataItemType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Tiempo hasta evento"
  }, {
    "@language" : "en",
    "@value" : "Time to event"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@value" : "A scalar measument of the time interval until certain event happens"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO" : [ {
    "@value" : "http://purl.obolibrary.org/obo/IAO_0000416"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DI_Undefined",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DataItemType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Tipo de datos indefinido"
  }, {
    "@language" : "en",
    "@value" : "Undefined data item type"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@value" : "A data item that denotes an unknown or undefined type"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DI_Upper95ConfidenceLimit",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DataItemType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Limite superior del IC al 95%"
  }, {
    "@language" : "en",
    "@value" : "Upper 95% CI limit"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@value" : "Upper limit for a 95% Confidence interval"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO" : [ {
    "@value" : "http://purl.obolibrary.org/obo/STATO_0000314"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DataItemType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "El tipo que define la naturaleza de un elemento de datos, ya sea su naturaleza estadística (probabilidad, riesgo relativo...) o alguna característica (moneda, utilidad...)"
  }, {
    "@language" : "en",
    "@value" : "The type to define the nature of a data item, either its statistic nature (probability, relative risk...) or some characteristic (currency, utility...)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Data item type"
  }, {
    "@language" : "es",
    "@value" : "Tipo del elemento de datos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid269"
  }, {
    "@id" : "_:genid270"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DecisionTreeModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A model based on a decision tree"
  }, {
    "@language" : "es",
    "@value" : "Un modelo basado en un árbol de decisión"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Decision tree model"
  }, {
    "@language" : "es",
    "@value" : "Modelo de árbol de decisión"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Model"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionCat",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#HealthCareCat"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "es",
    "@value" : "Detección"
  }, {
    "@language" : "en",
    "@value" : "Detection"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An intervention intended to detect the presence of a disease or condition in a person"
  }, {
    "@language" : "es",
    "@value" : "Una intervención destinada a detectar la presencia de una enfermedad o condición en una persona"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Detection intervention"
  }, {
    "@language" : "es",
    "@value" : "Intervención de detección"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Intervention"
  } ],
  "http://www.w3.org/2002/07/owl#disjointUnionOf" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/ontologies-ULL/OSDi#DiagnosisIntervention"
    }, {
      "@id" : "https://w3id.org/ontologies-ULL/OSDi#ScreeningIntervention"
    } ]
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid271"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An outcome of a detection strategy. Its probability depends on whether the individual has the detected disease, so it declares a risk for each case (hasRiskIfDiseased, hasRiskIfNotDiseased). In each case, the outcome without risk (at most one) takes the remaining probability."
  }, {
    "@language" : "es",
    "@value" : "Un resultado de una estrategia de detección. Su probabilidad depende de si el individuo tiene la enfermedad detectada, así que declara un riesgo para cada caso (hasRiskIfDiseased, hasRiskIfNotDiseased). En cada caso, el resultado sin riesgo (como mucho uno) se lleva la probabilidad restante."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Detection outcome"
  }, {
    "@language" : "es",
    "@value" : "Resultado de una detección"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"
  }, {
    "@id" : "_:genid276"
  }, {
    "@id" : "_:genid277"
  } ],
  "http://www.w3.org/2002/07/owl#disjointUnionOf" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/ontologies-ULL/OSDi#InconclusiveDetectionOutcome"
    }, {
      "@id" : "https://w3id.org/ontologies-ULL/OSDi#NegativeDetectionOutcome"
    }, {
      "@id" : "https://w3id.org/ontologies-ULL/OSDi#PositiveDetectionOutcome"
    } ]
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "A strategy related to the detection of a disease"
  }, {
    "@language" : "en",
    "@value" : "A strategy related to the detection of a disease or diseases (detects), characterized by its sensitivity and specificity. In a screening model, the screening strategy of an arm is applied to the whole population, and the diagnosis strategy is applied to the patients that screen positive or, without screening, to the patients with the disease."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Detection strategy"
  }, {
    "@language" : "es",
    "@value" : "Estrategia de detección"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  }, {
    "@id" : "_:genid281"
  }, {
    "@id" : "_:genid282"
  }, {
    "@id" : "_:genid287"
  }, {
    "@id" : "_:genid292"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DeterministicParameter",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Parameter with a fixed (no-uncertainty) value"
  }, {
    "@language" : "es",
    "@value" : "Parámetro con un valor fijo (sin incertidumbre)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Deterministic parameter"
  }, {
    "@language" : "es",
    "@value" : "Parámetro determinista"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ParameterNature"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid293"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#Development",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Certain progression of a Disease that comprises a specific set of manifestations or a set of pathways to such manifestations"
  }, {
    "@language" : "es",
    "@value" : "Cierta progresión de una enfermedad que comprende un conjunto concreto de manifestaciones o un conjunto de rutas hacia esas manifestaciones"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Desarrollo"
  }, {
    "@language" : "en",
    "@value" : "Development"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"
  }, {
    "@id" : "_:genid302"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DiagnosisCat",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionCat"
  } ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Diagnostic"
  }, {
    "@language" : "es",
    "@value" : "Diagnóstico"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DiagnosisIntervention",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An intervention intended to establish the presence/absence of certain disease or condition. The detection strategies of its arm are those of the disease, unless it replaces them through a StrategyReplacementEffect."
  }, {
    "@language" : "es",
    "@value" : "Una intervención destinada a establecer la presencia o ausencia de cierta enfermedad o condición. Las estrategias de detección de su brazo son las de la enfermedad, salvo que las sustituya mediante un StrategyReplacementEffect."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Diagnosis intervention"
  }, {
    "@language" : "es",
    "@value" : "Intervención diagnóstica"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ScreeningIntervention"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid307"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DiagnosisStrategy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A strategy related to the diagnosis of a disease"
  }, {
    "@language" : "es",
    "@value" : "Una estrategia relacionada con el diagnóstico de una enfermedad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Diagnosis strategy"
  }, {
    "@language" : "es",
    "@value" : "Estrategia de diagnóstico"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid311"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DiscreteEventSimulationModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A model based on discrete events and entities"
  }, {
    "@language" : "es",
    "@value" : "Un modelo basado en eventos discretos y entidades"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Discrete-event simulation model"
  }, {
    "@language" : "es",
    "@value" : "Modelo de simulación de eventos discretos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Model"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#Disease",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Any type of disease or health condition that a person may suffer. Since diseases may have or not costs, utilities... all of these properties has been explicitly defined with cardinality 'only' as an hint for the ontology users"
  }, {
    "@language" : "es",
    "@value" : "Cualquier tipo de enfermedad o condición de salud que puede sufrir una persona. Como las enfermedades pueden tener o no costes, utilidades..., todas estas propiedades se han definido explícitamente con la cardinalidad «only» como indicación para quienes usan la ontología"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Disease"
  }, {
    "@language" : "es",
    "@value" : "Enfermedad"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#HealthCondition"
  }, {
    "@id" : "_:genid315"
  }, {
