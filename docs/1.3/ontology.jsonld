    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ModelItemWithUtility"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Closed set of ways in which the sub-guidelines of a composite guideline are combined."
  }, {
    "@language" : "es",
    "@value" : "Conjunto cerrado de formas de combinar las subpautas de una pauta compuesta."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Guideline combination mode"
  }, {
    "@language" : "es",
    "@value" : "Modo de combinación de pautas"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Model"
  }, {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ModelItem"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid415"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombination_Alternative",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Alternativa"
  }, {
    "@language" : "en",
    "@value" : "Alternative"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@language" : "es",
    "@value" : "A cada individuo se le aplica exactamente una subpauta, seleccionada por sus condiciones de aplicación (límites de edad y/o expresiones de condición), p. ej. una dosis distinta según la edad o el peso."
  }, {
    "@language" : "en",
    "@value" : "Exactly one sub-guideline applies to each individual, selected by its applicability conditions (application age bounds and/or condition expressions), e.g. a different dose depending on age or weight."
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombination_Concurrent",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Concurrent"
  }, {
    "@language" : "es",
    "@value" : "Simultánea"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@language" : "en",
    "@value" : "All sub-guidelines apply at the same time (e.g. two drugs given together). Each may have its own start offset."
  }, {
    "@language" : "es",
    "@value" : "Todas las subpautas se aplican a la vez (p. ej. dos fármacos administrados juntos). Cada una puede tener su propio desfase de inicio."
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombination_Sequential",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Secuencial"
  }, {
    "@language" : "en",
    "@value" : "Sequential"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@language" : "es",
    "@value" : "Las subpautas se aplican una tras otra (p. ej. inducción y después mantenimiento). El orden se indica con hasNext/hasPrevious; la primera es la subpauta sin hasPrevious. Cada paso termina al alcanzar su duración o número de aplicaciones."
  }, {
    "@language" : "en",
    "@value" : "Sub-guidelines apply one after another (e.g. induction, then maintenance). The order is given by hasNext/hasPrevious; the first one is the sub-guideline with no hasPrevious. Each step ends when its duration or count is reached."
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#HealthCareCat",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual", "http://www.w3.org/2004/02/skos/core#Concept" ],
  "http://www.w3.org/2004/02/skos/core#inScheme" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageCategoryScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "es",
    "@value" : "Cuidado sanitario"
  }, {
    "@language" : "en",
    "@value" : "Healthcare"
  } ],
  "http://www.w3.org/2004/02/skos/core#topConceptOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageCategoryScheme"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#HealthCondition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Any disease, symptom or clinical sign that affects the health of an individual"
  }, {
    "@language" : "es",
    "@value" : "Cualquier enfermedad, síntoma o signo clínico que afecta a la salud de un individuo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Condición de salud"
  }, {
    "@language" : "en",
    "@value" : "Health condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ModelItem"
  }, {
    "@id" : "_:genid419"
  }, {
    "@id" : "_:genid420"
  }, {
    "@id" : "_:genid421"
  }, {
    "@id" : "_:genid422"
  }, {
    "@id" : "_:genid423"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#HealthTechnology",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Any treatment, drug, test... that may be applied to a patient. In the context of this ontology, this class and its subclasses define resource usage to compute costs and must not be confused with the 'interventions'"
  }, {
    "@language" : "es",
    "@value" : "Cualquier tratamiento, fármaco, prueba... que puede aplicarse a un paciente. En el contexto de esta ontología, esta clase y sus subclases definen el uso de recursos para calcular costes y no deben confundirse con las «intervenciones»"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Health technology"
  }, {
    "@language" : "es",
    "@value" : "Tecnología sanitaria"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#InconclusiveDetectionOutcome",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An inconclusive result of a detection strategy: the individual is not classified, so the outcome must be followed by another strategy (a repetition of the test, modeled as another strategy, or a different test)."
  }, {
    "@language" : "es",
    "@value" : "Un resultado no concluyente de una estrategia de detección: el individuo no queda clasificado, así que el resultado debe ir seguido de otra estrategia (una repetición de la prueba, modelada como otra estrategia, o una prueba distinta)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Inconclusive detection outcome"
  }, {
    "@language" : "es",
    "@value" : "Resultado no concluyente de una detección"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome"
  }, {
    "@id" : "_:genid424"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#IncreasedMortalityRateEffect",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An increment on the mortality rate of an individual or population."
  }, {
    "@language" : "es",
    "@value" : "Un incremento de la tasa de mortalidad de un individuo o una población."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Efecto de incremento en la tasa de mortalidad"
  }, {
    "@language" : "en",
    "@value" : "Increased mortality rate effect"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid425"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#InfectiousDisease",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A disease that is transmitted from one person to another through various means"
  }, {
    "@language" : "es",
    "@value" : "Una enfermedad que se transmite de una persona a otra por diversos medios"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Enfermedad infecciosa"
  }, {
    "@language" : "en",
    "@value" : "Infectious disease"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Disease"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#InheritedDisease"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#InheritedDisease",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A disease that is passed down from parent to child through genes"
  }, {
    "@language" : "es",
    "@value" : "Una enfermedad que se transmite de padres a hijos a través de los genes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Enfermedad hereditaria"
  }, {
    "@language" : "en",
    "@value" : "Inherited disease"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Disease"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#InstantDeathEffect",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Define un riesgo de muerte «instantánea», p. ej., una probabilidad de morir al aparecer una condición"
  }, {
    "@language" : "en",
    "@value" : "Defines an 'instantaneous' death risk, e.g., a probability of dying upon the onset of a condition"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Efecto de muerte instantánea"
  }, {
    "@language" : "en",
    "@value" : "Instantaneous death effect"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid429"
  }, {
    "@id" : "_:genid433"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#Intervention",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Algún tipo de tratamiento, fármaco, procedimiento quirúrgico... usado para modificar el desarrollo de una enfermedad. En el contexto de esta ontología, las intervenciones son las opciones que se comparan en el proceso de toma de decisiones. Cada intervención tiene exactamente un objetivo (isInterventionOf): la enfermedad o un elemento de su progresión."
  }, {
    "@language" : "en",
    "@value" : "Some kind of treatment, drug, surgical procedure... used to modify the development of a Disease. In the context of this ontology, interventions are the comparing options in the decision-making process. Each intervention has exactly one target (isInterventionOf): the disease or an element of its progression."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Intervención"
  }, {
    "@language" : "en",
    "@value" : "Intervention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ModelItem"
  }, {
    "@id" : "_:genid434"
  }, {
    "@id" : "_:genid435"
  }, {
    "@id" : "_:genid436"
  }, {
    "@id" : "_:genid437"
  }, {
    "@id" : "_:genid438"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ModelItemDefiningDiseaseProgression"
  }, {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#ModelItemWithRiskCharacterization"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#InterventionDoNothing",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Intervention"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@value" : "A null intervention that has no effect on the patient"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#LifeExpectancyReductionEffect",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An effect that reduces the life expectancy of an individual or population."
  }, {
    "@language" : "es",
    "@value" : "Un efecto que reduce la esperanza de vida de un individuo o una población."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Efecto de reducción en la esperanza de vida"
  }, {
    "@language" : "en",
    "@value" : "Life expectancy reduction effect"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid439"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#LineOfTherapy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A strategy related to the treatment of a disease or condition"
  }, {
    "@language" : "es",
    "@value" : "Una estrategia relacionada con el tratamiento de una enfermedad o condición"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Estrategia de tratamiento"
  }, {
    "@language" : "en",
    "@value" : "Line-of-therapy strategy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#Strategy"
  }, {
    "@id" : "_:genid447"
