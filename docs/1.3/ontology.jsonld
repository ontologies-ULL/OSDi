  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Sensibilidad"
  }, {
    "@language" : "en",
    "@value" : "Sensitivity"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasDescription" : [ {
    "@value" : "The probability of a positive test result, conditioned on the individual truly being positive"
  } ],
  "https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO" : [ {
    "@value" : "http://purl.obolibrary.org/obo/STATO_0000233"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#DI_Specificity",
