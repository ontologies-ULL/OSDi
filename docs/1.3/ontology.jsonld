  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Measured data item type"
  }, {
    "@language" : "es",
    "@value" : "Tipo del elemento de datos medible"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/ontologies-ULL/OSDi#DataItemType"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid455"
  } ]
}, {
  "@id" : "https://w3id.org/ontologies-ULL/OSDi#Model",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A container to define all the items that conform a model that can be simulated"
  }, {
    "@language" : "es",
    "@value" : "Un contenedor para definir todos los elementos que forman un modelo que puede simularse"
  } ],
