    "@language" : "en",
    "@value" : "A discrete (0-1) probability distribution with just one parameter (the probability of an event)"
  }, {
    "@language" : "es",
    "@value" : "Una distribución de probabilidad discreta (0-1) con un único parámetro (la probabilidad de un evento)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Expresión para distribución de probabilidad de Bernoulli"
  }, {
