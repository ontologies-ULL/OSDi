    <!-- https://w3id.org/ontologies-ULL/OSDi#DI_OddsRatio -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/OSDi#DI_OddsRatio">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
        <hasDescription>The ratio of the odds of an event in two groups</hasDescription>
        <hasRefToSTATO>http://purl.obolibrary.org/obo/STATO_0000182</hasRefToSTATO>
        <rdfs:comment xml:lang="en">As the magnitude of an effect, it multiplies the odds of a probability: p * OR / (1 - p + p * OR)</rdfs:comment>
        <rdfs:comment xml:lang="es">Como magnitud de un efecto, multiplica la odds de una probabilidad: p * OR / (1 - p + p * OR)</rdfs:comment>
        <rdfs:label xml:lang="en">Odds ratio</rdfs:label>
        <rdfs:label xml:lang="es">Razón de odds</rdfs:label>
    </owl:NamedIndividual>
    


