        <rdfs:label xml:lang="en">has member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#affects -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#affects">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isAffectedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define una relación entre un efecto y un atributo, parámetro o condición de salud, indicando que el efecto lo afecta. Una condición de salud solo puede verse afectada por un StrategyReplacementEffect; el resto de efectos afectan a atributos o parámetros.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between an effect and an attribute, parameter or health condition, indicating that the effect affects it. A health condition can only be affected by a StrategyReplacementEffect; the rest of effects affect attributes or parameters.</rdfs:comment>
        <rdfs:label xml:lang="es">afecta</rdfs:label>
        <rdfs:label xml:lang="en">affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#affectsProgressionElement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#affectsProgressionElement">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:comment xml:lang="es">Define la regla de combinación que afecta a cierto elemento de progresión</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the combination rule that affects certain progression element</rdfs:comment>
        <rdfs:label xml:lang="es">afecta al elemento de progresión</rdfs:label>
        <rdfs:label xml:lang="en">affects progression element</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#causesFailOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#causesFailOf">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#failsIf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:comment xml:lang="es">La condición de salud o el parámetro que hace fracasar una estrategia (inversa de failsIf, que describe su semántica).</rdfs:comment>
        <rdfs:comment xml:lang="en">The health condition or parameter that makes a strategy fail (inverse of failsIf, which describes its semantics).</rdfs:comment>
        <rdfs:label xml:lang="es">causa el fallo de</rdfs:label>
        <rdfs:label xml:lang="en">causes fail of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#dependsOn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#dependsOn">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDependantCalculatedParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relaciona un parámetro calculado con cada atributo o parámetro referenciado en su expresión (hasExpressionValue). Todo elemento que aparezca en la expresión debería declararse con esta propiedad, para que las herramientas puedan resolver las dependencias del parámetro sin analizar la expresión.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a calculated parameter to each attribute or parameter referenced in its expression (hasExpressionValue). Every element referenced in the expression should be declared with this property, so that tools can resolve the dependencies of the parameter without parsing the expression.</rdfs:comment>
        <rdfs:label xml:lang="es">depende de</rdfs:label>
        <rdfs:label xml:lang="en">depends on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#detects -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#detects">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isDetectedBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
        <rdfs:comment xml:lang="es">Indica la enfermedad o enfermedades que detecta una estrategia de detección. La enfermedad que detecta una intervención de detección es su objetivo (isInterventionOf).</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates the disease or diseases detected by a detection strategy. The disease detected by a detection intervention is its target (isInterventionOf).</rdfs:comment>
        <rdfs:label xml:lang="es">detecta</rdfs:label>
        <rdfs:label xml:lang="en">detects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#failsIf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#failsIf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Forma abreviada de dos resultados de una estrategia: un FailureOutcome y un SuccessOutcome (ver StrategyOutcome). El fracaso ocurre con la probabilidad por episodio o el tiempo hasta el evento del parámetro (según su tipo de dato), o cuando aparece la condición de salud (p. ej., la progresión de la enfermedad, o un efecto adverso de la estrategia, que modela el abandono del tratamiento). El éxito es el resultado por defecto (en una simulación, llega con la duración de la condición de salud, modificada por los efectos). Las estrategias siguientes las dan followedOnFailureBy y followedOnSuccessBy, y resolvesOnSuccess indica si el éxito resuelve la condición de salud. No puede combinarse con hasStrategyOutcome.</rdfs:comment>
        <rdfs:comment xml:lang="en">Short form of two outcomes of a strategy: a FailureOutcome and a SuccessOutcome (see StrategyOutcome). The failure happens with the probability per episode or the time to event of the parameter (according to its data item type), or when the health condition appears (e.g., the progression of the disease, or an adverse event of the strategy, which models the abandonment of the treatment). The success is the default outcome (in a simulation, it arrives with the duration of the health condition, modified by the effects). The next strategies are given by followedOnFailureBy and followedOnSuccessBy, and resolvesOnSuccess says whether the success resolves the health condition. It cannot be combined with hasStrategyOutcome.</rdfs:comment>
        <rdfs:label xml:lang="en">fails if</rdfs:label>
        <rdfs:label xml:lang="es">falla si</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#followedByStrategy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#followedByStrategy">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#followsStrategy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:comment xml:lang="en">For a strategy: the strategy scheduled after it ends, whatever its outcome, unless the outcome declares its own next strategy. For a detection strategy that only declares its sensitivity and specificity, the next strategy is applied to the positive results (e.g., a confirmatory diagnosis). For an outcome of a strategy (StrategyOutcome): the strategy that follows such outcome.</rdfs:comment>
        <rdfs:comment xml:lang="es">Para una estrategia: la estrategia programada tras su final, sea cual sea su resultado, salvo que el resultado declare su propia estrategia siguiente. Para una estrategia de detección que solo declara su sensibilidad y especificidad, la estrategia siguiente se aplica a los resultados positivos (p. ej., un diagnóstico de confirmación). Para un resultado de una estrategia (StrategyOutcome): la estrategia que sigue a ese resultado.</rdfs:comment>
        <rdfs:label xml:lang="en">followed by strategy</rdfs:label>
        <rdfs:label xml:lang="es">seguido por la estrategia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#followedOnFailureBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#followedOnFailureBy">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:comment xml:lang="es">Forma abreviada (ver failsIf): la estrategia que sigue al fracaso de una estrategia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Short form (see failsIf): the strategy that follows the failure of a strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">followed on failure by</rdfs:label>
        <rdfs:label xml:lang="es">seguida en caso de fracaso por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#followedOnSuccessBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#followedOnSuccessBy">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:comment xml:lang="es">Forma abreviada (ver failsIf): la estrategia que sigue al éxito de una estrategia. Para modelar una recaída tras la respuesta, el éxito va seguido de una estrategia de seguimiento (FollowUpStrategy) cuyo fracaso es la recaída, con la probabilidad de recaída entre los pacientes que respondieron; ese fracaso puede ir seguido del tratamiento de la recaída.</rdfs:comment>
        <rdfs:comment xml:lang="en">Short form (see failsIf): the strategy that follows the success of a strategy. To model a relapse after the response, the success is followed by a follow-up strategy (FollowUpStrategy) whose failure is the relapse, with the probability of relapse among the patients who responded; that failure may be followed by the treatment of the relapse.</rdfs:comment>
        <rdfs:label xml:lang="en">followed on success by</rdfs:label>
        <rdfs:label xml:lang="es">seguida en caso de éxito por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#followsStrategy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#followsStrategy">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define la relación entre dos estrategias, en la que una sigue a la otra.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the relationship between two strategies, where one follows the other.</rdfs:comment>
        <rdfs:label xml:lang="en">follows strategy</rdfs:label>
        <rdfs:label xml:lang="es">sigue la estrategia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasAdverseEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasAdverseEvent">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isAdverseEventOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#AdverseEvent"/>
        <rdfs:comment xml:lang="es">Define un efecto adverso que la estrategia puede provocar cada vez que se aplica (ver AdverseEvent).</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines an adverse event that the strategy may cause each time it is applied (see AdverseEvent).</rdfs:comment>
        <rdfs:label xml:lang="en">has adverse event</rdfs:label>
        <rdfs:label xml:lang="es">tiene el efecto adverso</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasAge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasAge">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#usesAttributeValue"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute"/>
                <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute_Age"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define la edad de la población, que puede usarse para definir las características de la enfermedad y de las intervenciones. El valor es la edad media de los individuos de la población.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the age of the population, which can be used to define the characteristics of the disease and the interventions. The value is the average age of the individuals in the population.</rdfs:comment>
        <rdfs:label xml:lang="en">has age</rdfs:label>
        <rdfs:label xml:lang="es">tiene edad</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasAssessedIntervention -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasAssessedIntervention">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#includesModelItem"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isAssessedInterventionOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
        <rdfs:comment xml:lang="es">Relaciona un modelo con una intervención cuyo valor se evalúa en él. Normalmente es una, pero se admiten varias (p. ej. evaluaciones de múltiples tecnologías). El papel depende del modelo: la misma intervención puede ser comparador en otro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a model to an intervention whose value is being assessed in it. Usually one, but several are allowed (e.g. multiple technology appraisals). The role is specific to the model: the same intervention may be a comparator in another model.</rdfs:comment>
        <rdfs:label xml:lang="en">has assessed intervention</rdfs:label>
        <rdfs:label xml:lang="es">tiene la intervención evaluada</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasAttributeValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasAttributeValue">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Define un valor para un atributo, que debería usar una población o una enfermedad</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a value for an attribute, which should be used by a population and/or disease</rdfs:comment>
        <rdfs:label xml:lang="en">has attribute value</rdfs:label>
        <rdfs:label xml:lang="es">tiene el valor del atributo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasCategory">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Cost"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="es">Asocia un coste o una estrategia con un concepto SKOS usado con fines de clasificación y análisis.</rdfs:comment>
        <rdfs:comment xml:lang="en">Associates a cost or a strategy with a SKOS concept used for classification and analysis purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">has category</rdfs:label>
        <rdfs:label xml:lang="es">tiene categoría</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasComparatorIntervention -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasComparatorIntervention">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#includesModelItem"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isComparatorInterventionOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
        <rdfs:comment xml:lang="es">Relaciona un modelo con una intervención usada como comparador de la(s) intervención(es) evaluada(s).</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a model to an intervention used as comparator of the assessed intervention(s).</rdfs:comment>
        <rdfs:label xml:lang="en">has comparator intervention</rdfs:label>
        <rdfs:label xml:lang="es">tiene la intervención como comparador</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasConditionExpression -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasConditionExpression">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isConditionExpressionOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="en">It allows expressing conditions based on parameters that we will find in the model. For example, we can find that certain drugs will be administered depending on the weight or age of the patient.</rdfs:comment>
        <rdfs:comment xml:lang="es">Permite expresar condiciones basadas en parámetros del modelo. Por ejemplo, ciertos fármacos se administran según el peso o la edad del paciente.</rdfs:comment>
        <rdfs:label xml:lang="en">has condition expression</rdfs:label>
        <rdfs:label xml:lang="es">tiene la expresión de condición</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasCost -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasCost">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthTechnology"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Cost"/>
        <rdfs:comment xml:lang="es">Define el coste de una condición de salud, tecnología sanitaria, intervención, ruta o estrategia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the cost of a health condition, health technology, intervention, pathway or strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has cost</rdfs:label>
        <rdfs:label xml:lang="es">tiene el coste</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasCount -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasCount">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Número total de aplicaciones de la pauta (p. ej. una vacuna de 3 dosis). Puede usarse en lugar de hasDuration o junto a ella; si están ambas, la pauta termina con lo que ocurra antes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Total number of applications of the guideline (e.g. a vaccine with 3 doses). May be used instead of, or together with, hasDuration; if both are present the guideline ends at whichever comes first.</rdfs:comment>
        <rdfs:label xml:lang="en">has count</rdfs:label>
        <rdfs:label xml:lang="es">tiene el número de aplicaciones</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasDataItemType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasDataItemType">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isDataItemTypeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
        <rdfs:comment xml:lang="es">Define el tipo de elemento de datos que representa el parámetro, que puede usarse para determinar cómo usar el parámetro en el modelo y cómo obtener su valor.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the type of data item that represents the parameter, which can be used to determine how to use the parameter in the model and how to obtain its value.</rdfs:comment>
        <rdfs:label xml:lang="en">has data item type</rdfs:label>
        <rdfs:label xml:lang="es">tiene el tipo de datos</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasDependantCalculatedParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasDependantCalculatedParameter">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"/>
        <rdfs:comment xml:lang="es">Define un parámetro calculado que depende de otros parámetros.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a calculated parameter that depends on other parameters.</rdfs:comment>
        <rdfs:label xml:lang="en">has dependant calculated parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro calculado dependiente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasDose -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasDose">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="en">Dose administered in each application of the guideline. The unit (e.g. mg, mg/kg) is stated by the MeasuredDataItemType of the parameter.</rdfs:comment>
        <rdfs:comment xml:lang="es">Dosis administrada en cada aplicación de la pauta. La unidad (p. ej. mg, mg/kg) se indica en el MeasuredDataItemType del parámetro.</rdfs:comment>
        <rdfs:label xml:lang="en">has dose</rdfs:label>
        <rdfs:label xml:lang="es">tiene la dosis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasDuration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasDuration">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Duración de un elemento de progresión clínica o de la aplicación de una pauta. Se expresa en años. En una combinación secuencial, un paso termina cuando se agota su duración.</rdfs:comment>
        <rdfs:comment xml:lang="en">Duration of a clinical progression element or of the application of a guideline. Expressed in years. In a sequential combination, a step ends when its duration expires. In a simulation, the success of a strategy (SuccessOutcome) without its own risk arrives with the duration of the health condition to which the strategy is applied, modified by the effects.</rdfs:comment>
        <rdfs:label xml:lang="en">has duration</rdfs:label>
        <rdfs:label xml:lang="es">tiene la duración</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasEffect -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasEffect">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isEffectOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
        <rdfs:comment xml:lang="es">Define una relación entre una condición de salud, intervención, ruta, población o elemento de uso de recursos y un efecto, indicando que la condición de salud, intervención, ruta, población o elemento de uso de recursos tiene cierto efecto sobre la progresión de la enfermedad o sobre los pacientes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a health condition, intervention, pathway, population or resource usage item and an effect, indicating that the health condition, intervention, pathway, population or resource usage item has a certain effect on the disease progression or on the patients.</rdfs:comment>
        <rdfs:label xml:lang="en">has effect</rdfs:label>
        <rdfs:label xml:lang="es">tiene el efecto</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasEffectMagnitude -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasEffectMagnitude">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Define el parámetro que define la magnitud del efecto. El tipo de dato de la magnitud define cómo se aplica a cada parámetro o atributo afectado (x) en un Effect genérico: un factor (DI_Factor) o una razón (DI_Ratio) multiplica (x * m); un riesgo relativo (DI_RelativeRisk) o un hazard ratio (DI_HazardRatio) sobre una probabilidad multiplica la tasa constante equivalente, es decir, 1 - (1 - x)^m; un hazard ratio sobre un tiempo hasta el evento sin distribución divide el tiempo medio (x / m), suponiendo un tiempo exponencial; una odds ratio (DI_OddsRatio) sobre una probabilidad multiplica la odds, es decir, x * m / (1 - x + x * m); una diferencia de medias (DI_MeanDifference) se resta (x - m). Cualquier otro tipo es un valor absoluto que sustituye al elemento afectado; DI_Continuous_Variable siempre sustituye, y un tipo que no coincida con el del elemento afectado debería producir un aviso. Una magnitud relativa siempre modifica el elemento afectado, aunque ambos compartan el mismo tipo. Los estadísticos de la incertidumbre (desviación estándar, límites de confianza) no son magnitudes válidas. Usa DI_Factor en lugar de DI_RelativeRisk para multiplicar una probabilidad de forma lineal (p. ej., cuando el riesgo relativo y la probabilidad proceden de la misma fuente y periodo).</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the parameter that defines the magnitude of the effect. The data item type of the magnitude defines how it is applied to each affected parameter or attribute (x) in a generic Effect: a factor (DI_Factor) or a ratio (DI_Ratio) multiplies (x * m); a relative risk (DI_RelativeRisk) or a hazard ratio (DI_HazardRatio) on a probability multiplies the equivalent constant rate, i.e., 1 - (1 - x)^m; a hazard ratio on a time to event without a distribution divides the mean time (x / m), assuming an exponential time; an odds ratio (DI_OddsRatio) on a probability multiplies the odds, i.e., x * m / (1 - x + x * m); a mean difference (DI_MeanDifference) is subtracted (x - m). Any other type is an absolute value that replaces the affected item; DI_Continuous_Variable always replaces, and a type that does not match the type of the affected item should produce a warning. A relative magnitude always modifies the affected item, even if both share the same type. Statistics of the uncertainty (standard deviation, confidence limits) are not valid magnitudes. Use DI_Factor instead of DI_RelativeRisk to multiply a probability linearly (e.g., when the relative risk and the probability come from the same source and period).</rdfs:comment>
        <rdfs:label xml:lang="en">has magnitude effect</rdfs:label>
        <rdfs:label xml:lang="es">tiene magnitud del efecto</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasEndAge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasEndAge">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Define la edad a la que termina cierta condición o enfermedad.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the age at which a certain condition or disease ends.</rdfs:comment>
        <rdfs:label xml:lang="en">has end age</rdfs:label>
        <rdfs:label xml:lang="es">tiene la edad de finalización</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasEpidemiologicalParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasEpidemiologicalParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#EpidemiologicalParameter"/>
        <rdfs:comment xml:lang="es">Define un parámetro epidemiológico de una enfermedad o una población, como la incidencia, la prevalencia, la mortalidad, etc.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines an epidemiological parameter of a disease or a population, such as the incidence, prevalence, mortality, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">has epidemiological parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro epidemiológico</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasEvaluationTime -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasEvaluationTime">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Tiempo, en años desde el inicio de la estrategia, en que se evalúa el resultado (p. ej., una regla de parada que evalúa la respuesta a las 12 semanas). La estrategia y la condición de salud (si el resultado la resuelve) se detienen en ese momento, y empieza la estrategia siguiente. Sin tiempo de evaluación, un árbol de decisión supone que el resultado ocurre al inicio de la estrategia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Time, in years since the start of the strategy, when the outcome is evaluated (e.g., a stopping rule that assesses the response at 12 weeks). The strategy and the health condition (if the outcome resolves it) stop at such time, and the next strategy starts. Without an evaluation time, a decision tree assumes that the outcome happens at the start of the strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has evaluation time</rdfs:label>
        <rdfs:label xml:lang="es">tiene el momento de evaluación</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasExpressionLanguage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasExpressionLanguage">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isExpressionLanguageOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ExpressionLanguage"/>
        <rdfs:comment xml:lang="es">Define el lenguaje de expresión usado en un parámetro calculado, que puede ser cualquier lenguaje formal que permita expresar fórmulas matemáticas, como MathML u OpenMath.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the expression language used in a calculated parameter, which can be any formal language that allows us to express mathematical formulas, such as MathML or OpenMath.</rdfs:comment>
        <rdfs:label xml:lang="en">has expression language</rdfs:label>
        <rdfs:label xml:lang="es">tiene el lenguage de expresión</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasFirst -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasFirst">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#SequentialCombinationRule"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"/>
        <rdfs:comment xml:lang="es">Apunta al primero de un conjunto de elementos ordenados</rdfs:comment>
        <rdfs:comment xml:lang="en">Points to the first of a set of ordered items</rdfs:comment>
        <rdfs:label xml:lang="en">has first</rdfs:label>
        <rdfs:label xml:lang="es">tiene primero</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasFrequency -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasFrequency">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#AcuteManifestation"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="en">For a guideline: number of applications per period (see hasPeriod), e.g. 3 applications every 1 day. For an acute manifestation: number of occurrences per year. In a decision tree, the frequency does not change the structure of the tree: the one-time payoffs of the acute manifestation, and of its strategies, outcomes and adverse events, are multiplied by the expected number of episodes within the time window of the manifestation.</rdfs:comment>
        <rdfs:comment xml:lang="es">Para una pauta: número de aplicaciones por periodo (ver hasPeriod), p. ej. 3 aplicaciones cada 1 día. Para una manifestación aguda: número de apariciones al año. En un árbol de decisión, la frecuencia no cambia la estructura del árbol: los pagos de una vez de la manifestación aguda, y de sus estrategias, resultados y efectos adversos, se multiplican por el número esperado de episodios dentro de la ventana temporal de la manifestación.</rdfs:comment>
        <rdfs:label xml:lang="en">has frequency</rdfs:label>
        <rdfs:label xml:lang="es">tiene la frecuencia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasGroupItem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasGroupItem">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isGroupItemOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Group"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GroupableModelItem"/>
        <rdfs:comment xml:lang="es">Describe los elementos de un grupo</rdfs:comment>
        <rdfs:comment xml:lang="en">Describes the items of a group</rdfs:comment>
        <rdfs:label xml:lang="en">has group item</rdfs:label>
        <rdfs:label xml:lang="es">tiene el elemento del grupo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasGuideline -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasGuideline">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isGuidelineOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthTechnology"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:comment xml:lang="es">Define una relación entre una tecnología sanitaria o una estrategia y una pauta, indicando que la pauta se aplica a la tecnología sanitaria o estrategia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a health technology or a strategy and a guideline, indicating that the guideline is applied to the health technology or strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has guideline</rdfs:label>
        <rdfs:label xml:lang="es">tiene la pauta</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasInitialProportion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasInitialProportion">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ChronicManifestation"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Development"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Stage"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Define la proporción inicial de pacientes de una población que ya presentan cierta manifestación</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the initial proportion of patients of a population that already present certain manifestation</rdfs:comment>
        <rdfs:label xml:lang="en">has initial proportion</rdfs:label>
        <rdfs:label xml:lang="es">tiene la proporción inicial</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasIntervention -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasIntervention">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isInterventionOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
        <rdfs:comment xml:lang="es">Define el objetivo de una intervención: la condición de salud (la enfermedad o un elemento de su progresión) a la que se aplica. El tiempo 0 es el momento en que se aplica la intervención: todos los pacientes presentan su objetivo y la intervención está activa toda la simulación. Si el objetivo es una manifestación aguda, todos empiezan con un episodio (p. ej., una crisis de migraña). Cada intervención tiene exactamente un objetivo (ver isInterventionOf), y las intervenciones comparadas en un modelo deben tener el mismo objetivo. En una intervención de detección (cribado o diagnóstico), el objetivo es la enfermedad que detecta, y la intervención se aplica a la población en riesgo de padecerla, no solo a quienes la presentan.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the target of an intervention: the health condition (the disease or an element of its progression) to which the intervention is applied. Time 0 is the moment when the intervention is applied: every patient presents its target, and the intervention is active during the whole simulation. If the target is an acute manifestation, every patient starts with an episode (e.g., a migraine attack). Every intervention has exactly one target (see isInterventionOf), and the interventions compared in a model must have the same target. For a detection intervention (screening or diagnosis), the target is the disease it detects, and the intervention applies to the population at risk of such disease, not only to those who present it.</rdfs:comment>
        <rdfs:label xml:lang="en">has intervention</rdfs:label>
        <rdfs:label xml:lang="es">tiene la intervención</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasLifeExpectancy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasLifeExpectancy">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Define la esperanza de vida de la población, que es el número medio de años que se espera que viva un individuo de la población. Este valor debe expresarse en años.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the life expectancy of the population, which is the average number of years that an individual of the population is expected to live. This value must be expressed in number of years.</rdfs:comment>
        <rdfs:label xml:lang="en">has life expectancy</rdfs:label>
        <rdfs:label xml:lang="es">tiene la esperanza de vida</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasMaxApplicationAge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasMaxApplicationAge">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Edad máxima (excluida) a la que se aplica la pauta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Maximum age (exclusive) at which the guideline applies.</rdfs:comment>
        <rdfs:label xml:lang="en">has maximum application age</rdfs:label>
        <rdfs:label xml:lang="es">tiene la edad máxima de aplicación</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasMinApplicationAge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasMinApplicationAge">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Edad mínima (incluida) a la que se aplica la pauta. Junto con hasMaxApplicationAge, sustituye a hasRange. Para otras condiciones (peso, atributos...) usa hasConditionExpression.</rdfs:comment>
        <rdfs:comment xml:lang="en">Minimum age (inclusive) at which the guideline applies. Together with hasMaxApplicationAge, replaces hasRange. For other conditions (weight, attributes...) use hasConditionExpression.</rdfs:comment>
        <rdfs:label xml:lang="en">has minimum application age</rdfs:label>
        <rdfs:label xml:lang="es">tiene la edad mínima de aplicación</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasNext -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasNext">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasPrevious"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"/>
        <rdfs:comment xml:lang="es">Apunta al siguiente elemento del modelo ordenado</rdfs:comment>
        <rdfs:comment xml:lang="en">Points to the next ordered model item</rdfs:comment>
        <rdfs:label xml:lang="en">has next</rdfs:label>
        <rdfs:label xml:lang="es">tiene siguiente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasOnsetAge -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasOnsetAge">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Define la edad a la que aparece cierta manifestación de la enfermedad. Este valor debe expresarse en años.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the age at which a certain manifestation of the disease appears. This value must be expressed in number of years.</rdfs:comment>
        <rdfs:label xml:lang="en">has onset age</rdfs:label>
        <rdfs:label xml:lang="es">tiene la edad de inicio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasOutcomeRisk -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasOutcomeRisk">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="en">How likely an outcome of a strategy is. Its data item type expresses it: a probability per episode (used by decision trees) or a time to event (used by simulations); the application converts one into the other when it can, and warns when it cannot. The outcome without risk of a strategy (at most one) is the default outcome: it takes the remaining probability (1 minus the sum of the rest).</rdfs:comment>
        <rdfs:comment xml:lang="es">Lo probable que es un resultado de una estrategia. Lo expresa su tipo de dato: una probabilidad por episodio (la que usan los árboles de decisión) o un tiempo hasta el evento (el que usan las simulaciones); la aplicación convierte uno en otro cuando puede, y avisa cuando no puede. El resultado sin riesgo de una estrategia (como mucho uno) es el resultado por defecto: se lleva la probabilidad restante (1 menos la suma del resto).</rdfs:comment>
        <rdfs:label xml:lang="en">has outcome risk</rdfs:label>
        <rdfs:label xml:lang="es">tiene el riesgo del resultado</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasParameter -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasParameter">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isParameterOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Define una relación entre una enfermedad, intervención, ruta, población o elemento de uso de recursos y un parámetro, indicando que el parámetro se usa para caracterizar la enfermedad, intervención, ruta, población o elemento de uso de recursos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a disease, intervention, pathway, population or resource usage item and a parameter, indicating that the parameter is used to characterize the disease, intervention, pathway, population or resource usage item.</rdfs:comment>
        <rdfs:label xml:lang="en">has parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasPeriod -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasPeriod">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Duración del periodo al que se refiere la frecuencia, p. ej. 8 (horas) en &apos;una dosis cada 8 horas&apos;. La unidad por defecto es horas. Sustituye a hasHoursInterval.</rdfs:comment>
        <rdfs:comment xml:lang="en">Length of the period to which the frequency refers, e.g. 8 (hours) for &apos;one dose every 8 hours&apos;. Default unit is hours. Replaces hasHoursInterval.</rdfs:comment>
        <rdfs:label xml:lang="en">has period</rdfs:label>
        <rdfs:label xml:lang="es">tiene el periodo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasPrevious -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasPrevious">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"/>
        <rdfs:comment xml:lang="es">Apunta al elemento del modelo ordenado anterior</rdfs:comment>
        <rdfs:comment xml:lang="en">Points to the previous ordered model item</rdfs:comment>
        <rdfs:label xml:lang="en">has previous</rdfs:label>
        <rdfs:label xml:lang="es">tiene anterior</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasProgressionElement -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasProgressionElement">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isProgressionElementOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DiseaseProgressionElement"/>
        <rdfs:comment xml:lang="es">Define una relación entre una enfermedad y su elemento de progresión, indicando que un individuo afectado por la enfermedad puede presentar el elemento de progresión.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a disease and its progression element, indicating that an individual affected by the disease can have the progression element.</rdfs:comment>
        <rdfs:label xml:lang="en">has progression element</rdfs:label>
        <rdfs:label xml:lang="es">has progression element</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasProportionWithinGroup -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasProportionWithinGroup">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GroupableModelItemWithProportion"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Define la proporción de pacientes que presentan una característica dentro de un grupo. Por ejemplo, la proporción de pacientes que presentan una manifestación dentro de un estadio de la enfermedad, o la proporción de pacientes que reciben una intervención dentro de una estrategia. Para una estrategia, es la proporción de pacientes que la reciben dentro de un grupo de estrategias alternativas que sigue a una estrategia o a uno de sus resultados (followedByStrategy, followedOnFailureBy, followedOnSuccessBy): cada paciente recibe una de las estrategias del grupo, y como mucho una de ellas puede no declarar esta propiedad, con lo que se lleva el resto. La proporción es una propiedad de la estrategia, así que es la misma en todos los grupos a los que pertenece.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the proportion of patients that present a certain characteristic within a group. For example, the proportion of patients that present a certain manifestation within a stage of the disease, or the proportion of patients that receive a certain intervention within a strategy. For a strategy, it is the proportion of patients that receive it within a group of alternative strategies that follows a strategy or one of its outcomes (followedByStrategy, followedOnFailureBy, followedOnSuccessBy): each patient receives one of the strategies of the group, and at most one of them may lack this property, taking the rest. The proportion is a property of the strategy, so it is the same in every group the strategy belongs to.</rdfs:comment>
        <rdfs:label xml:lang="en">has proportion within group</rdfs:label>
        <rdfs:label xml:lang="es">tiene la proporción dentro del grupo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasReplacementStrategy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasReplacementStrategy">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#StrategyReplacementEffect"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Group"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasGroupItem"/>
                                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">La estrategia, o grupo de estrategias, que sustituye a las estrategias de la condición de salud afectada por un efecto de sustitución de estrategia.</rdfs:comment>
        <rdfs:comment xml:lang="en">The strategy, or group of strategies, that replaces the strategies of the health condition affected by a strategy replacement effect.</rdfs:comment>
        <rdfs:label xml:lang="en">has replacement strategy</rdfs:label>
        <rdfs:label xml:lang="es">tiene la estrategia de sustitución</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasRiskCharacterization -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasRiskCharacterization">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isRiskCharacterizationOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#AdverseEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define la caracterización del riesgo de un elemento de progresión clínica, que puede expresarse como un parámetro (p. ej., un riesgo relativo) o como una vía (p. ej., una vía que define los eventos que llevan a la aparición de cierta manifestación). Un desarrollo o una manifestación crónica sin caracterización del riesgo que no pertenece a un grupo de dos o más progresiones alternativas (es decir, no afectado por ninguna regla de combinación, afectado por una regla de coexistencia, o por una regla de alternativas con un solo miembro) está siempre activo en su contexto: se aplica desde el inicio, y una manifestación sin riesgo que depende de un desarrollo (hasSubProgression) está activa siempre que ese desarrollo lo esté. Dentro de un grupo de dos o más progresiones alternativas, la progresión sin riesgo (como mucho una, y solo si el grupo no tiene progresión nula) se lleva la probabilidad restante (1 menos la suma del resto). Tanto los árboles de decisión como las simulaciones de eventos discretos deberían interpretar así las progresiones sin riesgo. Para un efecto adverso, el riesgo es obligatorio y es una probabilidad por aplicación de la estrategia que lo provoca (o un tiempo hasta el evento en una simulación).</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the risk characterization of a clinical progression element, which can be expressed as a parameter (e.g., relative risk) or as a pathway (e.g., a pathway that defines the events that lead to the occurrence of a certain manifestation). A development or chronic manifestation without risk characterization that does not belong to a group of two or more alternative progressions (i.e., not affected by any combination rule, affected by a coexistent rule, or by an alternative rule with a single member) is always active in its context: it applies from the start, and a manifestation without risk that depends on a development (hasSubProgression) is active whenever such development is active. Within a group of two or more alternative progressions, the progression without risk (at most one, and only if the group has no null progression) takes the remaining probability (1 minus the sum of the rest). Both decision trees and discrete-event simulations should interpret progressions without risk in this way. For an adverse event, the risk is mandatory and is a probability per application of the strategy that causes it (or a time to event in a simulation).</rdfs:comment>
        <rdfs:label xml:lang="en">has risk characterization</rdfs:label>
        <rdfs:label xml:lang="es">tiene la caracterización de riesgo</rdfs:label>
        <TODO>Check if this is the best name for the property</TODO>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasRiskIfDiseased -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasRiskIfDiseased">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasOutcomeRisk"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="en">How likely an outcome of a detection strategy is for an individual that has the detected disease (e.g., the sensitivity, for a positive result without inconclusive results). The outcome without this risk takes the remaining probability.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lo probable que es un resultado de una estrategia de detección para un individuo que tiene la enfermedad detectada (p. ej., la sensibilidad, para un resultado positivo sin resultados no concluyentes). El resultado sin este riesgo se lleva la probabilidad restante.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk if diseased</rdfs:label>
        <rdfs:label xml:lang="es">tiene el riesgo si está enfermo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasRiskIfNotDiseased -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasRiskIfNotDiseased">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasOutcomeRisk"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="en">How likely an outcome of a detection strategy is for an individual that does not have the detected disease (e.g., 1 minus the specificity, for a positive result without inconclusive results). The outcome without this risk takes the remaining probability.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lo probable que es un resultado de una estrategia de detección para un individuo que no tiene la enfermedad detectada (p. ej., 1 menos la especificidad, para un resultado positivo sin resultados no concluyentes). El resultado sin este riesgo se lleva la probabilidad restante.</rdfs:comment>
        <rdfs:label xml:lang="en">has risk if not diseased</rdfs:label>
        <rdfs:label xml:lang="es">tiene el riesgo si no está enfermo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasSensitivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasSensitivity">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">En epidemiología, la sensibilidad es la probabilidad de clasificar correctamente a un individuo enfermo, es decir, la probabilidad de obtener un resultado positivo en una prueba diagnóstica para un sujeto enfermo. La sensibilidad es, por tanto, la capacidad de la prueba complementaria para detectar la enfermedad. La sensibilidad es el porcentaje de verdaderos positivos o la probabilidad de que la prueba sea positiva si la enfermedad está presente; los falsos negativos son sujetos enfermos diagnosticados como sanos. En una estrategia de detección, hasSensitivity y hasSpecificity son la forma abreviada de dos resultados: un PositiveDetectionOutcome (seguido del followedByStrategy de la estrategia, si lo hay) y un NegativeDetectionOutcome. No pueden combinarse con hasStrategyOutcome.</rdfs:comment>
        <rdfs:comment xml:lang="en">The Sensitivity in epidemiology is the Probability of correctly classifying a sick individual, that is, the Probability that a positive result will be obtained in a diagnostic test for a sick subject. The Sensitivity is, therefore, the ability of the complementary test to detect the disease. Sensitivity is the percentage of true positives or the Probability that the test is positive if the disease is present; False negatives are sick subjects diagnosed as healthy. In a detection strategy, hasSensitivity and hasSpecificity are the short form of two outcomes: a PositiveDetectionOutcome (followed by the followedByStrategy of the strategy, if any) and a NegativeDetectionOutcome. They cannot be combined with hasStrategyOutcome.</rdfs:comment>
        <rdfs:label xml:lang="en">has sensitivity</rdfs:label>
        <rdfs:label xml:lang="es">tiene la sensibilidad</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasSex -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasSex">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#usesAttributeValue"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute"/>
                <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute_Sex"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define el sexo de la población, que puede usarse para definir las características de la enfermedad y de las intervenciones. El valor es la proporción de mujeres en la población.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the sex of the population, which can be used to define the characteristics of the disease and the interventions. The value is the proportion of female individuals in the population.</rdfs:comment>
        <rdfs:label xml:lang="en">has sex</rdfs:label>
        <rdfs:label xml:lang="es">tiene sexo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasSpecificity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasSpecificity">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">La especificidad de una prueba es la probabilidad de que un sujeto sano tenga un resultado negativo. La especificidad es el porcentaje de verdaderos negativos o la probabilidad de que la prueba sea negativa si la enfermedad no está presente. Los falsos positivos son sujetos sanos diagnosticados como enfermos. En una estrategia de detección, hasSensitivity y hasSpecificity son la forma abreviada de dos resultados (ver hasSensitivity).</rdfs:comment>
        <rdfs:comment xml:lang="en">The Specificity of a test is the Probability that a healthy subject will have a negative test result. Specificity is the percentage of true negatives or the Probability that the test will be negative if the disease is not present. False positives are healthy subjects diagnosed as sick. In a detection strategy, hasSensitivity and hasSpecificity are the short form of two outcomes (see hasSensitivity).</rdfs:comment>
        <rdfs:label xml:lang="en">has specificity</rdfs:label>
        <rdfs:label xml:lang="es">tiene la especificidad</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasStartOffset -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasStartOffset">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Tiempo transcurrido entre un punto de referencia y el inicio de la pauta. El punto de referencia es el final de la pauta anterior si existe (hasPrevious), o el inicio de la pauta, estrategia o tecnología sanitaria padre en otro caso. La unidad por defecto es años.</rdfs:comment>
        <rdfs:comment xml:lang="en">Time elapsed between a reference point and the start of the guideline. The reference point is the end of the previous guideline if it has one (hasPrevious), or the start of the parent guideline, strategy or health technology otherwise. Default unit is years.</rdfs:comment>
        <rdfs:label xml:lang="en">has start offset</rdfs:label>
        <rdfs:label xml:lang="es">tiene el desfase de inicio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasStrategy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasStrategy">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isStrategyOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Group"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasGroupItem"/>
                                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define una relación entre una condición de salud o estrategia y una estrategia, que puede ser una estrategia simple o un grupo de estrategias. Esta propiedad permite definir las estrategias que se aplican a una condición de salud o estrategia, así como las estrategias que forman parte de un grupo de estrategias. Las intervenciones no declaran estrategias directamente: sustituyen las estrategias de una condición de salud mediante un StrategyReplacementEffect.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a health condition or strategy and a strategy, which can be either a simple strategy or a group of strategies. This property allows us to define the strategies that are applied to a health condition or strategy, as well as the strategies that are part of a group of strategies. Interventions do not declare strategies directly: they replace the strategies of a health condition through a StrategyReplacementEffect.</rdfs:comment>
        <rdfs:label xml:lang="en">has strategy</rdfs:label>
        <rdfs:label xml:lang="es">tiene la estrategia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasStrategyOutcome -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasStrategyOutcome">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isStrategyOutcomeOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
        <rdfs:comment xml:lang="es">Define los resultados mutuamente excluyentes de una estrategia (ver StrategyOutcome). No puede combinarse con las formas abreviadas failsIf (para cualquier estrategia) o hasSensitivity y hasSpecificity (para una estrategia de detección).</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the mutually exclusive outcomes of a strategy (see StrategyOutcome). It cannot be combined with the short forms failsIf (for any strategy) or hasSensitivity and hasSpecificity (for a detection strategy).</rdfs:comment>
        <rdfs:label xml:lang="en">has strategy outcome</rdfs:label>
        <rdfs:label xml:lang="es">tiene el resultado de la estrategia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasSubGuideline -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasSubGuideline">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isSubGuidelineOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:comment xml:lang="es">Relaciona una pauta con cada una de sus subpautas directas. Una pauta puede descomponerse recursivamente; la forma de combinar las subpautas se indica con hasSubGuidelineCombination. No es transitiva a propósito: usa la ruta SPARQL hasSubGuideline+ para obtener todos los descendientes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a guideline to each of its direct sub-guidelines. A guideline may be decomposed recursively; the way sub-guidelines are combined is stated with hasSubGuidelineCombination. Intentionally not transitive: use the SPARQL path hasSubGuideline+ to retrieve all descendants.</rdfs:comment>
        <rdfs:label xml:lang="en">has sub-guideline</rdfs:label>
        <rdfs:label xml:lang="es">tiene subpauta</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasSubGuidelineCombination -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasSubGuidelineCombination">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#CompositeGuideline"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"/>
        <rdfs:comment xml:lang="es">Indica cómo se combinan las subpautas directas de una pauta compuesta: simultáneas, secuenciales (ordenadas con hasNext/hasPrevious) o alternativas excluyentes (seleccionadas por sus condiciones de aplicación).</rdfs:comment>
        <rdfs:comment xml:lang="en">States how the direct sub-guidelines of a composite guideline are combined: concurrently, sequentially (ordered with hasNext/hasPrevious) or as mutually exclusive alternatives (selected by their applicability conditions).</rdfs:comment>
        <rdfs:label xml:lang="en">has sub-guideline combination</rdfs:label>
        <rdfs:label xml:lang="es">tiene combinación de subpautas</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasSubProgression -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasSubProgression">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:comment xml:lang="es">Define una relación entre un elemento de progresión clínica y su subelemento, indicando que el subelemento solo aparece como parte de la progresión clínica.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a clinical progression element and its sub-element, indicating that the sub-element only appear as a part of the clinical progression.</rdfs:comment>
        <rdfs:label xml:lang="en">has sub-progression</rdfs:label>
        <rdfs:label xml:lang="es">has sub-progression</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasSubpopulation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasSubpopulation">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isSubPopulationOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <rdfs:comment xml:lang="es">Define una relación entre una población y una subpoblación, indicando que la subpoblación es un subconjunto de la población.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a population and a subpopulation, indicating that the subpopulation is a subset of the population.</rdfs:comment>
        <rdfs:label xml:lang="en">has subpopulation</rdfs:label>
        <rdfs:label xml:lang="es">tiene la subpoblación</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasTemporaryThreshold -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasTemporaryThreshold">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ScreeningStrategy"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Plazo en el que debe tomarse la muestra. Por ejemplo, el tercer día tras el nacimiento. Este valor debe expresarse en días.</rdfs:comment>
        <rdfs:comment xml:lang="en">Time limit in which the sample must be made. For example on the third day of birth. This value must be expressed in number of days.</rdfs:comment>
        <rdfs:label xml:lang="en">has temporary threshold</rdfs:label>
        <rdfs:label xml:lang="es">tiene el umbral temporal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasUncertaintyCharacterization -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasUncertaintyCharacterization">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isUncertaintyCharacterizationOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#FirstOrderUncertaintyParameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#SecondOrderUncertaintyParameter"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define la caracterización de la incertidumbre de un parámetro, que puede expresarse como otro parámetro (p. ej., un intervalo de confianza) o como una expresión de distribución de probabilidad.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the uncertainty characterization of a parameter, which can be expressed as another parameter (e.g., confidence interval) or as a probability distribution expression.</rdfs:comment>
        <rdfs:label xml:lang="en">has uncertainty characterization</rdfs:label>
        <rdfs:label xml:lang="es">tiene la caracterización de incertidumbre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasUtility -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasUtility">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Utility"/>
        <rdfs:comment xml:lang="es">Define la utilidad asociada a una condición de salud, intervención, ruta, población o elemento de uso de recursos. La utilidad es una medida de la preferencia o del valor que los individuos o la sociedad asignan a un estado de salud o resultado concreto. Se usa a menudo en economía de la salud y en análisis de decisiones para evaluar lo deseables que son distintos resultados en salud y para informar la toma de decisiones sanitarias.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the utility associated with a health condition, intervention, pathway, population or resource usage item. The utility is a measure of the preference or value that individuals or society assign to a particular health state or outcome. It is often used in health economics and decision analysis to evaluate the desirability of different health outcomes and to inform healthcare decision-making.</rdfs:comment>
        <rdfs:label xml:lang="en">has utility</rdfs:label>
        <rdfs:label xml:lang="es">tiene la utilidad</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#includedByModel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#includedByModel">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#includesModelItem"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:comment xml:lang="es">Define una relación entre un elemento del modelo y un modelo, indicando que el elemento forma parte de la estructura o del contenido del modelo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a model item and a model, indicating that the model item is included as part of the structure or content of the model.</rdfs:comment>
        <rdfs:label xml:lang="en">included by model</rdfs:label>
        <rdfs:label xml:lang="es">incluido por el modelo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#includesModelItem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#includesModelItem">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:comment xml:lang="es">Define una relación entre un modelo y un elemento del modelo, indicando que el modelo incluye ese elemento como parte de su estructura o contenido.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a model and a model item, indicating that the model includes that item as part of its structure or content.</rdfs:comment>
        <rdfs:label xml:lang="en">includes model item</rdfs:label>
        <rdfs:label xml:lang="es">incluye el elemento del modelo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isAdverseEventOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isAdverseEventOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#AdverseEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:comment xml:lang="es">Inversa de hasAdverseEvent.</rdfs:comment>
        <rdfs:comment xml:lang="en">Inverse of hasAdverseEvent.</rdfs:comment>
        <rdfs:label xml:lang="es">es efecto adverso de</rdfs:label>
        <rdfs:label xml:lang="en">is adverse event of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isAffectedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isAffectedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
        <rdfs:comment xml:lang="es">Define una relación entre un atributo, parámetro o condición de salud y un efecto, indicando que se ve afectado por ese efecto. Una condición de salud solo puede verse afectada por un StrategyReplacementEffect.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between an attribute, parameter or health condition and an effect, indicating that it is affected by that effect. A health condition can only be affected by a StrategyReplacementEffect.</rdfs:comment>
        <rdfs:label xml:lang="es">es modificado por</rdfs:label>
        <rdfs:label xml:lang="en">is modified by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isAssessedInterventionOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isAssessedInterventionOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#includedByModel"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:comment xml:lang="es">Relaciona una intervención con un modelo en el que se evalúa su valor (inversa de hasAssessedIntervention).</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an intervention to a model in which its value is assessed (inverse of hasAssessedIntervention).</rdfs:comment>
        <rdfs:label xml:lang="es">es la intervención evaluada de</rdfs:label>
        <rdfs:label xml:lang="en">is assessed intervention of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isComparatorInterventionOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isComparatorInterventionOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#includedByModel"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:comment xml:lang="es">Relaciona una intervención con un modelo en el que se usa como comparador (inversa de hasComparatorIntervention).</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an intervention to a model in which it is used as comparator (inverse of hasComparatorIntervention).</rdfs:comment>
        <rdfs:label xml:lang="es">es la intervención como comparador de</rdfs:label>
        <rdfs:label xml:lang="en">is comparator intervention of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isConditionExpressionOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isConditionExpressionOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define una relación entre una expresión de condición y una pauta o estrategia, indicando que la expresión de condición se usa dentro de la pauta o estrategia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a condition expression and a guideline or strategy, indicating that the condition expression is used within the guideline or strategy.</rdfs:comment>
        <rdfs:label xml:lang="es">es expresión de condición de</rdfs:label>
        <rdfs:label xml:lang="en">is condition expression of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isDataItemTypeOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isDataItemTypeOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="es">Define una relación entre un tipo de elemento de datos y un parámetro, indicando que el tipo de elemento de datos se usa para definir el parámetro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a data item type and a parameter, indicating that the data item type is used to define the parameter.</rdfs:comment>
        <rdfs:label xml:lang="es">es tipo de elemento de datos de</rdfs:label>
        <rdfs:label xml:lang="en">is data item type of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isDetectedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isDetectedBy">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"/>
        <rdfs:comment xml:lang="es">Define una relación entre una enfermedad y una estrategia de detección, indicando que esa estrategia se usa para identificar la enfermedad.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a disease and a detection strategy, indicating that such strategy is used to identify the disease.</rdfs:comment>
        <rdfs:label xml:lang="es">es detectado por</rdfs:label>
        <rdfs:label xml:lang="en">is detected by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isEffectOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isEffectOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define una relación entre un efecto y una condición de salud, intervención, ruta, población o elemento de uso de recursos, indicando que el efecto está asociado a ese elemento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between an effect and a health condition, intervention, pathway, population or resource usage item, indicating that the effect is associated with that element.</rdfs:comment>
        <rdfs:label xml:lang="es">es efecto de</rdfs:label>
        <rdfs:label xml:lang="en">is effect of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isExpressionLanguageOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isExpressionLanguageOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ExpressionLanguage"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"/>
        <rdfs:comment xml:lang="es">Define una relación entre un lenguaje de expresión y un parámetro calculado, indicando que el lenguaje de expresión se usa para definir el parámetro calculado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between an expression language and a calculated parameter, indicating that the expression language is used to define the calculated parameter.</rdfs:comment>
        <rdfs:label xml:lang="es">es lenguaje de expresión de</rdfs:label>
        <rdfs:label xml:lang="en">is expression language of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isGroupItemOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isGroupItemOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GroupableModelItem"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Group"/>
        <rdfs:comment xml:lang="es">Indica que un elemento del modelo pertenece a un grupo (inversa de hasGroupItem).</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that a model item belongs to a group (inverse of hasGroupItem).</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to group</rdfs:label>
        <rdfs:label xml:lang="es">pertenece al grupo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isGuidelineOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isGuidelineOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthTechnology"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define una relación entre una pauta y una tecnología sanitaria o estrategia, indicando que la pauta está asociada a esa tecnología o estrategia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a guideline and a health technology or strategy, indicating that the guideline is associated with that technology or strategy.</rdfs:comment>
        <rdfs:label xml:lang="es">es guía o pauta de</rdfs:label>
        <rdfs:label xml:lang="en">is guideline of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isInterventionOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isInterventionOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
        <rdfs:comment xml:lang="es">Define el objetivo de una intervención, es decir, la condición de salud (la enfermedad o un elemento de su progresión) a la que se aplica. Inversa de hasIntervention, que describe su semántica. Cada intervención tiene exactamente un objetivo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the target of an intervention, i.e., the health condition (the disease or an element of its progression) to which it is applied. Inverse of hasIntervention, which describes its semantics. Every intervention has exactly one target.</rdfs:comment>
        <rdfs:label xml:lang="es">es intervención de</rdfs:label>
        <rdfs:label xml:lang="en">is intervention of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isOccurrenceOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isOccurrenceOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#AdverseEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
        <rdfs:comment xml:lang="es">Identifica la condición de salud de la que el efecto adverso es una aparición (p. ej., el efecto adverso «diarrea por amoxicilina» es una aparición de «diarrea»). Solo la identifica: el efecto adverso no activa la progresión, los pagos ni los efectos de esa condición.</rdfs:comment>
        <rdfs:comment xml:lang="en">Identifies the health condition of which the adverse event is an occurrence (e.g., the adverse event &apos;diarrhoea due to amoxicillin&apos; is an occurrence of &apos;diarrhoea&apos;). It only identifies the condition: the adverse event does not activate the progression, payoffs or effects of that condition.</rdfs:comment>
        <rdfs:label xml:lang="es">es una aparición de</rdfs:label>
        <rdfs:label xml:lang="en">is occurrence of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isParameterOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isParameterOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define una relación entre un parámetro y un elemento de progresión clínica, enfermedad, intervención, ruta, población o elemento de uso de recursos, indicando que el parámetro está asociado a ese elemento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a parameter and a clinical progression element, disease, intervention, pathway, population or resource usage item, indicating that the parameter is associated with that element.</rdfs:comment>
        <rdfs:label xml:lang="es">es parámetro de</rdfs:label>
        <rdfs:label xml:lang="en">is parameter of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isProgressionElementOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isProgressionElementOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DiseaseProgressionElement"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define una relación entre un elemento de progresión de la enfermedad y una enfermedad o regla de combinación de progresiones.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a disease progression element and a disease or progression combination rule.</rdfs:comment>
        <rdfs:label xml:lang="es">es elemento de progresión de</rdfs:label>
        <rdfs:label xml:lang="en">is progression element of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isRequiredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isRequiredBy">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#requires"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
        <rdfs:comment xml:lang="es">Define una relación entre un elemento de progresión clínica y una ruta, indicando que la ruta requiere el elemento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a clinical progression element and a pathway, indicating that the element is required by the pathway.</rdfs:comment>
        <rdfs:label xml:lang="es">es requerido por</rdfs:label>
        <rdfs:label xml:lang="en">is required by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isRiskCharacterizationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isRiskCharacterizationOf">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#AdverseEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define una relación entre una caracterización del riesgo y un elemento de progresión clínica o un efecto adverso, indicando que la caracterización se aplica a ese elemento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a risk characterization and a clinical progression element or an adverse event, indicating that the characterization applies to that element.</rdfs:comment>
        <rdfs:label xml:lang="es">es caracterización de riesgo de</rdfs:label>
        <rdfs:label xml:lang="en">is risk characterization of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isStrategyOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isStrategyOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:comment xml:lang="es">Relaciona una estrategia con la condición de salud o la estrategia que la declara, o con el grupo de estrategias al que pertenece (inversa de hasStrategy).</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a strategy to the health condition or strategy that declares it, or to the group of strategies it belongs to (inverse of hasStrategy).</rdfs:comment>
        <rdfs:label xml:lang="es">es estrategia de</rdfs:label>
        <rdfs:label xml:lang="en">is strategy of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isStrategyOutcomeOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isStrategyOutcomeOf">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:comment xml:lang="es">Inversa de hasStrategyOutcome.</rdfs:comment>
        <rdfs:comment xml:lang="en">Inverse of hasStrategyOutcome.</rdfs:comment>
        <rdfs:label xml:lang="es">es resultado de la estrategia</rdfs:label>
        <rdfs:label xml:lang="en">is strategy outcome of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isSubGuidelineOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isSubGuidelineOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:comment xml:lang="es">Relaciona una subpauta con su pauta padre. Inversa de hasSubGuideline.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a sub-guideline to its parent guideline. Inverse of hasSubGuideline.</rdfs:comment>
        <rdfs:label xml:lang="es">es subpauta de</rdfs:label>
        <rdfs:label xml:lang="en">is sub-guideline of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isSubPopulationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isSubPopulationOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <rdfs:comment xml:lang="es">Define una relación entre dos poblaciones, indicando que la población del dominio es una subpoblación de la población del rango.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between two populations, indicating that the domain population is a subpopulation of the range population.</rdfs:comment>
        <rdfs:label xml:lang="es">es subpoblación de</rdfs:label>
        <rdfs:label xml:lang="en">is subpopulation of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isSubProgressionOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isSubProgressionOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:comment xml:lang="es">Define una relación entre dos elementos de progresión clínica, indicando que el elemento del dominio es un subelemento del elemento del rango.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between two clinical progression elements, indicating that the domain element is a subelement of the range element.</rdfs:comment>
        <rdfs:label xml:lang="es">es subelemento de</rdfs:label>
        <rdfs:label xml:lang="en">is subelement of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isSupersededByClinicalProgression -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isSupersededByClinicalProgression">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#supersedesClinicalProgression"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:comment xml:lang="es">Define una relación entre dos elementos de progresión clínica, indicando que el elemento del rango reemplaza al elemento del dominio.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between two clinical progression elements, indicating that the domain element is superseded by the range element.</rdfs:comment>
        <rdfs:label xml:lang="es">es reemplazado por</rdfs:label>
        <rdfs:label xml:lang="en">is superseded by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isUncertaintyCharacterizationOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isUncertaintyCharacterizationOf">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#FirstOrderUncertaintyParameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#SecondOrderUncertaintyParameter"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define una relación entre una caracterización de la incertidumbre y un parámetro o una expresión de distribución de probabilidad, indicando que la caracterización se aplica a ese elemento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between an uncertainty characterization and a parameter or probability distribution expression, indicating that the characterization applies to that element.</rdfs:comment>
        <rdfs:label xml:lang="es">es caracterización de incertidumbre de</rdfs:label>
        <rdfs:label xml:lang="en">is uncertainty characterization of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isUsedAsAttributeValueBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isUsedAsAttributeValueBy">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#usesAttributeValue"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#AttributeValueParameter"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define una relación entre un parámetro de valor de atributo y una enfermedad o población, indicando que el parámetro se usa como valor de atributo para esa enfermedad o población.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between an attribute value parameter and a disease or population, indicating that the parameter is used as an attribute value for that disease or population.</rdfs:comment>
        <rdfs:label xml:lang="es">es utilizado como valor de atributo por</rdfs:label>
        <rdfs:label xml:lang="en">is used as attribute value by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isUsedByStrategy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isUsedByStrategy">
        <owl:inverseOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#usesHealthTechnology"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthTechnology"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:comment xml:lang="es">Define una relación entre una tecnología sanitaria y una estrategia, indicando que la tecnología sanitaria se usa en esa estrategia.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a health technology and a strategy, indicating that the health technology is used in that strategy.</rdfs:comment>
        <rdfs:label xml:lang="es">es utilizado por la estrategia</rdfs:label>
        <rdfs:label xml:lang="en">is used by strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
        <rdfs:comment xml:lang="es">Define una relación entre un parámetro y un atributo, indicando que el parámetro es un valor de ese atributo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a parameter and an attribute, indicating that the parameter is a value of that attribute.</rdfs:comment>
        <rdfs:label xml:lang="es">es valor del atributo</rdfs:label>
        <rdfs:label xml:lang="en">is value of attribute</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#requires -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#requires">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define que una ruta requiere cierto elemento de progresión clínica o intervención. Puede servir, por ejemplo, para definir que cierta ruta requiere la presencia de cierto síntoma o solo aparece cuando se aplica cierta intervención.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines that a pathway requires a certain clinical progression element or intervention. This can be useful for defining that a certain pathway requires the presence of a certain symptom or only appears when a certain intervention is applied.</rdfs:comment>
        <rdfs:label xml:lang="es">requiere</rdfs:label>
        <rdfs:label xml:lang="en">requires</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#supersedesClinicalProgression -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#supersedesClinicalProgression">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:comment xml:lang="es">Define que un elemento de progresión clínica reemplaza a otro. Puede servir, por ejemplo, para definir que cierta manifestación reemplaza a otra en la progresión de la enfermedad, como cuando un síntoma aparece tras desaparecer otro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines that a clinical progression element replaces another one. This can be useful for defining that a certain manifestation replaces another one in the progression of the disease, for example, to define that a certain symptom appears after the disappearance of another symptom.</rdfs:comment>
        <rdfs:label xml:lang="es">reemplaza la progresión clínica</rdfs:label>
        <rdfs:label xml:lang="en">supersedes clinical progression</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#usesAttributeValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#usesAttributeValue">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#AttributeValueParameter"/>
        <rdfs:comment xml:lang="es">Define una relación entre una enfermedad o población y un parámetro que es el valor de un atributo</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a disease or population and a parameter which is the value of an attribute</rdfs:comment>
        <rdfs:label xml:lang="es">usa el valor del atributo</rdfs:label>
        <rdfs:label xml:lang="en">uses attribute value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#usesHealthTechnology -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#usesHealthTechnology">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthTechnology"/>
        <rdfs:comment xml:lang="es">Define una relación entre una estrategia y una tecnología sanitaria usada en ella. Es útil para definir las tecnologías sanitarias usadas en una estrategia; por ejemplo, que cierto fármaco se usa en una estrategia de tratamiento o que cierta prueba de cribado se usa en una estrategia de cribado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a relationship between a strategy and a health technology used in that strategy. This is useful for defining the health technologies used in a strategy, for example, to define that a certain drug is used in a treatment strategy or that a certain screening test is used in a screening strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">uses health technology</rdfs:label>
        <rdfs:label xml:lang="es">utiliza tecnología sanitaria</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#usesModel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#usesModel">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:comment xml:lang="en">An experiment uses certain model</rdfs:comment>
        <rdfs:comment xml:lang="es">Un experimento usa cierto modelo</rdfs:comment>
        <rdfs:label xml:lang="es">usa el modelo</rdfs:label>
        <rdfs:label xml:lang="en">uses model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#usesSameModelItemsAs -->


    <owl:ObjectProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#usesSameModelItemsAs">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:range rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:comment xml:lang="es">Define que un modelo usa los mismos elementos de datos que otro modelo. Útil para no «recrear» esa relación para todos los elementos del modelo en modelos muy parecidos que solo difieren en algunas características.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines that a model uses the same data items as another model. Useful for avoiding &quot;recreating&quot; that relationship for all the model items in models which are very similar and simply differ in some characteristics.</rdfs:comment>
        <rdfs:label xml:lang="en">uses same model items as</rdfs:label>
        <rdfs:label xml:lang="es">utiliza los mismos elementos del modelo que</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/ontologies-ULL/OSDi#appliesOneTime -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#appliesOneTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Cost"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Utility"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Define el comportamiento temporal de un parámetro (en general, un coste o una utilidad): si es verdadero, se aplica al aparecer algún elemento del modelo (enfermedad, progresión de la enfermedad...); en otro caso, se supone que se aplica anualmente. Las utilidades por episodio son pérdidas de AVAC de una vez, que se suman cuando se aplica una estrategia o un resultado de una estrategia (StrategyOutcome), o cuando aparece una manifestación. Los costes y utilidades de un resultado de una estrategia se aplican una vez.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the temporal behavior of a parameter (generally a cost or utility): if true, applies upon onset of some model item (disease, disease progression...); otherwise, it is assumed to apply annually. Per-episode utilities are one-time QALY losses, which are added when a strategy or an outcome of a strategy (StrategyOutcome) is applied, or when a manifestation appears. The costs and utilities of an outcome of a strategy apply once.</rdfs:comment>
        <rdfs:label xml:lang="en">applies one time</rdfs:label>
        <rdfs:label xml:lang="es">se aplica una única vez</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasAlfaParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasAlfaParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#BetaDistributionExpression"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#GammaDistributionExpression"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el parámetro alfa de una distribución de probabilidad, que es el parámetro de forma que determina la asimetría de la distribución</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the alpha parameter of a probability distribution, which is the shape parameter that determines the skewness of the distribution</rdfs:comment>
        <rdfs:label xml:lang="en">has alfa parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro alfa</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasAuthor -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasAuthor">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Define el autor de un modelo. Puede servir, por ejemplo, para reconocer la autoría del modelo o para indicar a quién dirigir las preguntas sobre él.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the author of a model. This can be useful for defining the author of a model, for example, to give credit to the creator of the model or to provide contact information for questions about the model.</rdfs:comment>
        <rdfs:label xml:lang="en">has author</rdfs:label>
        <rdfs:label xml:lang="es">tiene el autor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasAverageParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasAverageParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el parámetro de la media de una distribución de probabilidad. Es útil para las distribuciones de probabilidad definidas por su media y otro parámetro, como la distribución normal (definida por su media y su desviación estándar) o la distribución de Poisson (definida por su media, que es también su parámetro lambda).</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the average parameter of a probability distribution, which is the mean of the distribution. This is useful for probability distributions which are defined by their mean and another parameter, such as the normal distribution (defined by its mean and standard deviation) or the Poisson distribution (defined by its mean, which is also its lambda parameter).</rdfs:comment>
        <rdfs:label xml:lang="en">has average parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro promedio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasBetaParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasBetaParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#BetaDistributionExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el parámetro beta de una distribución beta, que es el parámetro de forma que determina la asimetría de la distribución</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the beta parameter of a beta distribution, which is the shape parameter that determines the skewness of the distribution</rdfs:comment>
        <rdfs:label xml:lang="en">has beta parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro beta</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasCalculationMethod -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasCalculationMethod">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#QoLDataItemType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Define el método usado para calcular un elemento de datos de calidad de vida, por ejemplo, una utilidad o desutilidad. Puede servir, por ejemplo, para definir el método usado para calcular una utilidad o desutilidad a partir de un cuestionario.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the method used to calculate a quality of life data item, for example, a utility or disutility. This can be useful for defining the method used to calculate a utility or disutility from a questionnaire, for example.</rdfs:comment>
        <rdfs:label xml:lang="en">has calculation method</rdfs:label>
        <rdfs:label xml:lang="es">tiene el método de cálculo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasCostCombinationMethod -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasCostCombinationMethod">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>ADD</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>ADD_DISTINCT</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define el método usado para combinar los costes anuales de todos los elementos del modelo activos al mismo tiempo. Los métodos de combinación se aplican, en cada momento, al conjunto de elementos del modelo (enfermedad, progresiones clínicas, intervenciones) activos simultáneamente para un individuo: en un árbol de decisión, los elementos del camino hasta cada hoja; en una simulación de eventos discretos, el estado del paciente entre dos eventos consecutivos. Los métodos con el sufijo _DISTINCT cuentan una sola vez el individuo de un parámetro compartido por varios elementos activos simultáneamente (p. ej., la misma visita de seguimiento requerida por dos manifestaciones). ADD suma todos los costes; ADD_DISTINCT suma los costes, pero cuenta una sola vez cada parámetro de coste. Los costes de una vez (appliesOneTime = true) no se ven afectados por este método: siempre se suman, una vez por cada evento que los provoca. Si no se define, se supone ADD.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the method used to combine the annual costs of all the model items that are active at the same time. Combination methods are applied, at any moment, to the set of model items (disease, clinical progressions, interventions) that are simultaneously active for an individual: in a decision tree, the items along the path to each leaf; in a discrete-event simulation, the state of the patient between two consecutive events. Methods suffixed with _DISTINCT count only once a parameter individual that is shared by several simultaneously active items (e.g., the same follow-up visit required by two manifestations). ADD sums every cost; ADD_DISTINCT sums the costs, but counts only once each cost parameter. One-time costs (appliesOneTime = true) are not affected by this method: they are always added, once per triggering event. If not defined, ADD is assumed.</rdfs:comment>
        <rdfs:label xml:lang="en">has cost combination method</rdfs:label>
        <rdfs:label xml:lang="es">tiene el método de combinación de costes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasDescription -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasDescription">
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
        <rdfs:comment xml:lang="es">Descripción legible por personas de un individuo, pensada para mostrarse en los modelos generados (p. ej., en las hojas de parámetros). Se espera un valor por idioma.</rdfs:comment>
        <rdfs:comment xml:lang="en">Human-readable description of an individual, intended to be shown in generated models (e.g. parameter sheets). One value per language is expected.</rdfs:comment>
        <rdfs:label xml:lang="en">has description</rdfs:label>
        <rdfs:label xml:lang="es">tiene la descripción</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasDiscountForCosts -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasDiscountForCosts">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define la tasa de descuento de los costes en el experimento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the discount rate for costs in the experiment.</rdfs:comment>
        <rdfs:label xml:lang="en">has discount for costs</rdfs:label>
        <rdfs:label xml:lang="es">tiene el descuento para costos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasDiscountForEffects -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasDiscountForEffects">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define la tasa de descuento de los efectos en el experimento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the discount rate for effects in the experiment.</rdfs:comment>
        <rdfs:label xml:lang="en">has discount for effects</rdfs:label>
        <rdfs:label xml:lang="es">tiene el descuento para efectos</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasDisutilityCombinationMethod -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasDisutilityCombinationMethod">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>ADD</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>ADD_DISTINCT</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>MAX</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define el método usado para combinar las desutilidades anuales de todos los elementos del modelo activos al mismo tiempo. Los métodos de combinación se aplican, en cada momento, al conjunto de elementos del modelo (enfermedad, progresiones clínicas, intervenciones) activos simultáneamente para un individuo: en un árbol de decisión, los elementos del camino hasta cada hoja; en una simulación de eventos discretos, el estado del paciente entre dos eventos consecutivos. Los métodos con el sufijo _DISTINCT cuentan una sola vez el individuo de un parámetro compartido por varios elementos activos simultáneamente (p. ej., la misma visita de seguimiento requerida por dos manifestaciones). ADD suma todas las desutilidades; ADD_DISTINCT las suma, pero cuenta una sola vez cada parámetro de utilidad; MAX aplica solo la mayor desutilidad. Las desutilidades de una vez siempre se suman, una vez por cada evento que las provoca. Si no se define, se supone ADD.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the method used to combine the annual disutilities of all the model items that are active at the same time. Combination methods are applied, at any moment, to the set of model items (disease, clinical progressions, interventions) that are simultaneously active for an individual: in a decision tree, the items along the path to each leaf; in a discrete-event simulation, the state of the patient between two consecutive events. Methods suffixed with _DISTINCT count only once a parameter individual that is shared by several simultaneously active items (e.g., the same follow-up visit required by two manifestations). ADD sums every disutility; ADD_DISTINCT sums them, but counts only once each utility parameter; MAX applies only the largest disutility. One-time disutilities are always added, once per triggering event. If not defined, ADD is assumed.</rdfs:comment>
        <rdfs:label xml:lang="en">has disutility combination method</rdfs:label>
        <rdfs:label xml:lang="es">tiene el método de combinación de disutilidades</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasExpectedValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasExpectedValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DeterministicParameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#SecondOrderUncertaintyParameter"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">El valor esperado de un parámetro con incertidumbre. Es útil para los parámetros deterministas con incertidumbre, que pueden usarse en el análisis de sensibilidad determinista, y para los parámetros con incertidumbre de segundo orden, que se usan en el ASP de dos niveles.</rdfs:comment>
        <rdfs:comment xml:lang="en">The expected value of a parameter with uncertainty. This is useful for deterministic parameters with uncertainty, which can be used in deterministic sensitivity analysis, and for second-order uncertainty parameters, which are used in two-level PSA.</rdfs:comment>
        <rdfs:label xml:lang="en">has expected value</rdfs:label>
        <rdfs:label xml:lang="es">tiene el valor esperado</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasExpressionValue -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasExpressionValue">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">La expresión, en un lenguaje formal, para calcular el valor de un parámetro calculado. La expresión debe escribirse con la sintaxis del lenguaje de expresión definido para ese parámetro (ver la propiedad isExpressionLanguageOf).</rdfs:comment>
        <rdfs:comment xml:lang="en">The expression in a formal language to calculate the value of a calculated parameter. The expression must be written using the syntax of the expression language defined for that parameter (see property isExpressionLanguageOf).</rdfs:comment>
        <rdfs:label xml:lang="en">has expression value</rdfs:label>
        <rdfs:label xml:lang="es">tiene el valor de expresión</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasGeographicalContext -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasGeographicalContext">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Model"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Define el contexto geográfico de un modelo, parámetro o población. Puede servir, por ejemplo, para definir el ámbito de aplicación de un modelo o parámetro.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the geographical context of a model, parameter or population. This can be useful for defining the scope of applicability of a model or parameter, for example.</rdfs:comment>
        <rdfs:label xml:lang="en">has geographical context</rdfs:label>
        <rdfs:label xml:lang="es">tiene el contexto geográfico</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasLambdaParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasLambdaParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ExponentialDistributionExpression"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#PoissonDistributionExpression"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el parámetro lambda de una distribución de probabilidad: la tasa en una distribución exponencial (media = 1 / lambda) y el número medio de eventos en una distribución de Poisson. La escala de una distribución gamma es hasThetaParameter (en OSDi 1.2 se llamaba hasLambdaParameter).</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the lambda parameter of a probability distribution: the rate in an exponential distribution (mean = 1 / lambda) and the average number of events in a Poisson distribution. The scale of a gamma distribution is hasThetaParameter (in OSDi 1.2, it was called hasLambdaParameter).</rdfs:comment>
        <rdfs:label xml:lang="en">has lambda parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro lambda</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasLifeExpectancyReductionCombinationMethod -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasLifeExpectancyReductionCombinationMethod">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>ADD</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>ADD_DISTINCT</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>MAX</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define el método usado para combinar las reducciones de la esperanza de vida (magnitudes de LifeExpectancyReductionEffect, en años) de todos los elementos del modelo activos al mismo tiempo. Los métodos de combinación se aplican, en cada momento, al conjunto de elementos del modelo (enfermedad, progresiones clínicas, intervenciones) activos simultáneamente para un individuo: en un árbol de decisión, los elementos del camino hasta cada hoja; en una simulación de eventos discretos, el estado del paciente entre dos eventos consecutivos. Los métodos con el sufijo _DISTINCT cuentan una sola vez el individuo de un parámetro compartido por varios elementos activos simultáneamente (p. ej., la misma visita de seguimiento requerida por dos manifestaciones). ADD suma todas las reducciones; ADD_DISTINCT las suma, pero cuenta una sola vez cada parámetro de magnitud; MAX aplica solo la mayor reducción. Si no se define, se supone MAX. Primero se aplican los aumentos de la tasa de mortalidad (ver hasMortalityRateCombinationMethod), dividiendo la esperanza de vida por la tasa combinada; después se resta la reducción combinada de la esperanza de vida.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the method used to combine the life expectancy reductions (magnitudes of LifeExpectancyReductionEffect, in years) of all the model items that are active at the same time. Combination methods are applied, at any moment, to the set of model items (disease, clinical progressions, interventions) that are simultaneously active for an individual: in a decision tree, the items along the path to each leaf; in a discrete-event simulation, the state of the patient between two consecutive events. Methods suffixed with _DISTINCT count only once a parameter individual that is shared by several simultaneously active items (e.g., the same follow-up visit required by two manifestations). ADD sums every reduction; ADD_DISTINCT sums them, but counts only once each magnitude parameter; MAX applies only the largest reduction. If not defined, MAX is assumed. Increased mortality rates (see hasMortalityRateCombinationMethod) are applied first, by dividing the life expectancy by the combined rate; then the combined life expectancy reduction is subtracted.</rdfs:comment>
        <rdfs:label xml:lang="en">has life expectancy reduction combination method</rdfs:label>
        <rdfs:label xml:lang="es">tiene el método de combinación de reducciones de esperanza de vida</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasLowerLimitParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasLowerLimitParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#UniformDistributionExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el parámetro del límite inferior de una distribución uniforme</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the lower limit parameter of a uniform distribution</rdfs:comment>
        <rdfs:label xml:lang="en">has lower limit parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro de límite inferior</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasMaxAge -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasMaxAge">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define la edad máxima de una población</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the maximum age of a population</rdfs:comment>
        <rdfs:label xml:lang="en">has maximum age</rdfs:label>
        <rdfs:label xml:lang="es">tiene la edad máxima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasMinAge -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasMinAge">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define la edad mínima de una población</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the minimum age of a population</rdfs:comment>
        <rdfs:label xml:lang="en">has minimum age</rdfs:label>
        <rdfs:label xml:lang="es">tiene la edad mínima</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasMortalityRateCombinationMethod -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasMortalityRateCombinationMethod">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>MAX</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>MULT</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Define el método usado para combinar los aumentos de la tasa de mortalidad (magnitudes de IncreasedMortalityRateEffect, expresadas como razones de tasas) de todos los elementos del modelo activos al mismo tiempo. Los métodos de combinación se aplican, en cada momento, al conjunto de elementos del modelo (enfermedad, progresiones clínicas, intervenciones) activos simultáneamente para un individuo: en un árbol de decisión, los elementos del camino hasta cada hoja; en una simulación de eventos discretos, el estado del paciente entre dos eventos consecutivos. MAX aplica solo la mayor razón de tasas; MULT las multiplica todas. Si no se define, se supone MAX. La razón de tasas combinada divide la esperanza de vida antes de aplicar cualquier reducción de la esperanza de vida (ver hasLifeExpectancyReductionCombinationMethod).</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the method used to combine the increased mortality rates (magnitudes of IncreasedMortalityRateEffect, expressed as rate ratios) of all the model items that are active at the same time. Combination methods are applied, at any moment, to the set of model items (disease, clinical progressions, interventions) that are simultaneously active for an individual: in a decision tree, the items along the path to each leaf; in a discrete-event simulation, the state of the patient between two consecutive events. MAX applies only the largest rate ratio; MULT multiplies all of them. If not defined, MAX is assumed. The combined rate ratio divides the life expectancy before applying any life expectancy reduction (see hasLifeExpectancyReductionCombinationMethod).</rdfs:comment>
        <rdfs:label xml:lang="en">has mortality rate combination method</rdfs:label>
        <rdfs:label xml:lang="es">tiene el método de combinación de tasas de mortalidad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasNullProgression -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasNullProgression">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#AlternativeCombinationRule"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indica que una regla de combinación de alternativas define una opción de «ninguna de las anteriores»</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates that an alternative rule combination defines an option for &quot;none of the above&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">has null progression</rdfs:label>
        <rdfs:label xml:lang="es">tiene progresión nula</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasNumberOfPSARuns -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasNumberOfPSARuns">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Define el número de ejecuciones del análisis de sensibilidad probabilístico (ASP) en el experimento</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the number of runs for the probabilistic sensitivity analysis (PSA) in the experiment</rdfs:comment>
        <rdfs:label xml:lang="en">has number of PSA runs</rdfs:label>
        <rdfs:label xml:lang="es">tiene número de ejecuciones de PSA</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasNumberOfSimulatedIndividuals -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasNumberOfSimulatedIndividuals">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">Define el número de individuos simulados en el experimento</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the number of simulated individuals in the experiment</rdfs:comment>
        <rdfs:label xml:lang="en">has number of simulated individuals</rdfs:label>
        <rdfs:label xml:lang="es">tiene número de individuos simulados</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasOffsetParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasOffsetParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el parámetro de desplazamiento de una distribución de probabilidad, que es un valor que se suma a la variable aleatoria definida por la distribución. Es útil para definir distribuciones que solo pueden tomar valores por encima o por debajo de cierto umbral (por ejemplo, un desplazamiento de 1 en una distribución de Poisson define una distribución que solo puede tomar valores de 1 a infinito, en lugar de 0 a infinito).</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the offset parameter of a probability distribution, which is a value that is added to the random variable defined by the distribution. This is useful for defining distributions that can only take values above or below a certain threshold (for example, an offset of 1 in a Poisson distribution would define a distribution that can only take values from 1 to infinite, instead of from 0 to infinite).</rdfs:comment>
        <rdfs:label xml:lang="en">has offset parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro de desplazamiento</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define un parámetro de una distribución de probabilidad. Es una propiedad general que puede usarse para cualquier parámetro de cualquier distribución de probabilidad, pero se proporcionan subpropiedades más específicas para los parámetros más habituales (media, varianza, lambda, etc.)</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a parameter of a probability distribution. This is a general property which can be used for any parameter of any probability distribution, but more specific subproperties are provided for the most common parameters (average, variance, lambda, etc.)</rdfs:comment>
        <rdfs:label xml:lang="en">has probability distribution parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro de distribución de probabilidad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasProbabilityParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#BernoulliDistributionExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el parámetro de probabilidad de una distribución de Bernoulli</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the probability parameter of a Bernoulli distribution</rdfs:comment>
        <rdfs:label xml:lang="en">has probability parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro de probabilidad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasRefTo -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasRefTo">
