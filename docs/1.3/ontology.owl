        <rdfs:label xml:lang="en">Lower 95% CI limit</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DI_MeanDifference -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/OSDi#DI_MeanDifference">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
        <hasRefToSTATO>http://purl.obolibrary.org/obo/STATO_0000457</hasRefToSTATO>
