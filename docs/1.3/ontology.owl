<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/ontologies-ULL/OSDi#"
     xml:base="https://w3id.org/ontologies-ULL/OSDi"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://creativecommons.org/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:OSDi="https://w3id.org/ontologies-ULL/OSDi#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:opla-sd="http://ontologydesignpatterns.org/opla-sd#"
     xmlns:ontodebug="http://ainf.aau.at/ontodebug#">
    <owl:Ontology rdf:about="https://w3id.org/ontologies-ULL/OSDi">
        <owl:versionIRI rdf:resource="https://w3id.org/ontologies-ULL/OSDi/1.3"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <ns:license rdf:resource="http://creativecommons.org/licenses/by-nc-sa/4.0/"/>
        <dc:contributor>María Luz Couce Pico (https://orcid.org/0000-0003-4861-9905)</dc:contributor>
        <dc:creator>David Prieto González (https://orcid.org/0000-0003-1411-129X)</dc:creator>
        <dc:creator>Evelio J. González González (https://orcid.org/0000-0002-2203-3757)</dc:creator>
        <dc:creator>Iván Castilla Rodríguez (http://orcid.org/0000-0003-3933-2582)</dc:creator>
        <dc:description xml:lang="en">Ontology designed for collecting and inferring the parameters required to create a simulation-based Health Technology Assesment</dc:description>
        <dc:description xml:lang="es">Ontología diseñada para recopilar e inferir los parámetros necesarios para crear una evaluación de tecnología sanitaria basada en simulación</dc:description>
        <dc:source rdf:resource="https://github.com/ontologies-ULL/OSDi"/>
        <terms:abstract xml:lang="en">This ontology provides a structured framework for the interoperability of health economics data used to create models. The ontology represents all the concepts and relationships involved in health technology assessment, including the characterization of the disease and its development, the population affected, and the interventions applied.</terms:abstract>
        <rdfs:comment xml:lang="es">Las restricciones only sin cardinalidad son orientativas y señalan qué propiedades aplican a cada clase</rdfs:comment>
        <rdfs:comment xml:lang="en">The only restrictions without cardinality are indicative and indicate which properties apply to each class</rdfs:comment>
        <rdfs:label xml:lang="en">OSDi</rdfs:label>
        <rdfs:label xml:lang="es">OSDi</rdfs:label>
        <owl:priorVersion rdf:resource="https://w3id.org/ontologies-ULL/OSDi/1.2"/>
        <owl:versionInfo>1.3</owl:versionInfo>
    </owl:Ontology>
    


