    <!-- https://w3id.org/ontologies-ULL/OSDi#DI_HazardRatio -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/OSDi#DI_HazardRatio">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
        <hasDescription>The ratio of the hazard rates of an event in two groups</hasDescription>
        <hasRefToSTATO>http://purl.obolibrary.org/obo/STATO_0000677</hasRefToSTATO>
        <rdfs:comment xml:lang="en">As the magnitude of an effect, it multiplies the rate equivalent to a probability (1 - (1 - p)^HR), or divides the mean of a time to event, which is assumed exponential if it has no distribution</rdfs:comment>
        <rdfs:comment xml:lang="es">Como magnitud de un efecto, multiplica la tasa equivalente a una probabilidad (1 - (1 - p)^HR), o divide la media de un tiempo hasta el evento, que se supone exponencial si no tiene distribución</rdfs:comment>
        <rdfs:label xml:lang="en">Hazard ratio</rdfs:label>
        <rdfs:label xml:lang="es">Razón de riesgos instantáneos</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DI_Incidence -->


    <owl:NamedIndividual rdf:about="https://w3id.org/ontologies-ULL/OSDi#DI_Incidence">
        <rdf:type rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
        <hasDescription>The ratio of the number of new cases of a disease/manifestation/stage divided by the number of persons at risk for the disease/manifestation/stage</hasDescription>
        <hasRefToSTATO>http://purl.obolibrary.org/obo/STATO_0000413</hasRefToSTATO>
        <rdfs:label xml:lang="en">Incidence</rdfs:label>
        <rdfs:label xml:lang="es">Incidencia</rdfs:label>
    </owl:NamedIndividual>
    


