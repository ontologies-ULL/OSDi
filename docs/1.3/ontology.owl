    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefTo"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Reference to the corresponding item in STATO, if available</rdfs:comment>
        <rdfs:comment xml:lang="es">Referencia al elemento correspondiente de STATO, si existe</rdfs:comment>
        <rdfs:label xml:lang="en">has reference to STATO</rdfs:label>
        <rdfs:label xml:lang="es">tiene la referencia a STATO</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasRefToWikidata -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasRefToWikidata">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefTo"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Currency"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Reference to the corresponding item in Wikidata, if available</rdfs:comment>
        <rdfs:comment xml:lang="es">Referencia al elemento correspondiente de Wikidata, si existe</rdfs:comment>
        <rdfs:label xml:lang="en">has reference to Wikidata</rdfs:label>
        <rdfs:label xml:lang="es">tiene la referencia a Wikidata</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasScaleParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasScaleParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define un factor que multiplica el valor de la variable aleatoria definida por la distribución (antes de sumar el desplazamiento, ver hasOffsetParameter). No es el parámetro de escala de una distribución gamma, que es hasThetaParameter.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines a factor that multiplies the value of the random variable defined by the distribution (before adding the offset, see hasOffsetParameter). It is not the scale parameter of a gamma distribution, which is hasThetaParameter.</rdfs:comment>
        <rdfs:label xml:lang="en">has scale parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro de escala</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasSize -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasSize">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of individuals in the population</rdfs:comment>
        <rdfs:comment xml:lang="es">Número de individuos de la población</rdfs:comment>
        <rdfs:label xml:lang="en">has size</rdfs:label>
        <rdfs:label xml:lang="es">tiene el tamaño</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasSource -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasSource">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Fuente del valor del parámetro, p. ej., una referencia bibliográfica, el nombre de un conjunto de datos, el nombre de una persona experta...</rdfs:comment>
        <rdfs:comment xml:lang="en">Source of the parameter value, e.g., a bibliographic reference, name of a dataset, name of an expert...</rdfs:comment>
        <rdfs:label xml:lang="en">has source</rdfs:label>
        <rdfs:label xml:lang="es">tiene la fuente</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasStandardDeviationParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasStandardDeviationParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el parámetro de la desviación estándar de una distribución de probabilidad</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the standard deviation parameter of a probability distribution</rdfs:comment>
        <rdfs:label xml:lang="en">has standard deviation parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro de desviación estándar</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasThetaParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasThetaParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GammaDistributionExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el parámetro de escala (theta) de una distribución gamma, cuya media es k * theta, con k su forma (hasAlfaParameter). Para una distribución gamma expresada con una tasa lambda, theta = 1 / lambda.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the scale parameter (theta) of a gamma distribution, whose mean is k * theta, with k its shape (hasAlfaParameter). For a gamma distribution expressed with a rate lambda, theta = 1 / lambda.</rdfs:comment>
        <rdfs:label xml:lang="en">has theta parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro theta</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasTimeHorizon -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasTimeHorizon">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el horizonte temporal (en años) que se aplica a una simulación. En un árbol de decisión, limita los años de vida de cada hoja y los pagos que dependen de ellos; sin él, el horizonte es la vida entera.</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the time horizon (in years) applied to a simulation. In a decision tree, it limits the life years of each leaf, and the payoffs that depend on them; without it, the horizon is the lifetime.</rdfs:comment>
        <rdfs:label xml:lang="en">has time horizon</rdfs:label>
        <rdfs:label xml:lang="es">tiene horizonte temporal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasUnit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasUnit">
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#MeasuredDataItemType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">Unidad de medida de un tipo de elemento de datos, p. ej., «años», «kg», «número de casos»...</rdfs:comment>
        <rdfs:comment xml:lang="en">Unit of measurement of a data item type, e.g., &quot;years&quot;, &quot;kg&quot;, &quot;number of cases&quot;...</rdfs:comment>
        <rdfs:label xml:lang="en">has unit</rdfs:label>
        <rdfs:label xml:lang="es">tiene la unidad</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasUpperLimitParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasUpperLimitParameter">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityDistributionParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#UniformDistributionExpression"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment xml:lang="es">Define el parámetro del límite superior de una distribución uniforme</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines the upper limit parameter of a uniform distribution</rdfs:comment>
        <rdfs:label xml:lang="en">has upper limit parameter</rdfs:label>
        <rdfs:label xml:lang="es">tiene el parámetro de límite superior</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#hasYear -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#hasYear">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Experiment"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
        <rdfs:comment xml:lang="es">Año en que se recogen los datos de coste</rdfs:comment>
        <rdfs:comment xml:lang="en">Year in which the cost data is collected</rdfs:comment>
        <rdfs:label xml:lang="en">has year</rdfs:label>
        <rdfs:label xml:lang="es">tiene el año</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isDisutility -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isDisutility">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Utility"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indica si un parámetro de utilidad representa una desutilidad o una utilidad. Una utilidad u (isDisutility = false) de una progresión, la enfermedad o una intervención equivale a una desutilidad de (utilidad basal de la población - u), de modo que el paciente obtiene exactamente u si es la única activa. El valor convertido se combina con el resto de desutilidades mediante el método de combinación de desutilidades del experimento (hasDisutilityCombinationMethod). Esto se aplica tanto a las utilidades anuales como a las de una vez, y supone que la utilidad se midió en una población con la misma utilidad basal que la del modelo. Una desutilidad de una vez es una pérdida de AVAC por episodio, que se suma cuando se aplica una estrategia o un resultado de una estrategia, o cuando aparece una manifestación.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether a utility parameter represents a disutility or a utility. A utility u (isDisutility = false) of a progression, the disease or an intervention is equivalent to a disutility of (base utility of the population - u), so the patient gets exactly u if it is the only one active. The converted value is combined with the rest of disutilities by using the disutility combination method of the experiment (hasDisutilityCombinationMethod). This applies both to annual and one-time utilities, and assumes that the utility was measured in a population with the same base utility as that of the model. A one-time disutility is a loss of QALYs per episode, added when a strategy or an outcome of a strategy is applied, or when a manifestation appears.</rdfs:comment>
        <rdfs:label xml:lang="es">es una desutilidad</rdfs:label>
        <rdfs:label xml:lang="en">is disutility</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#isTrueEpidemiologicalParameterEstimate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#isTrueEpidemiologicalParameterEstimate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#EpidemiologicalParameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indica si un parámetro epidemiológico es una estimación verdadera del parámetro o una estimación con sesgos conocidos</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether an epidemiological parameter is a true estimate of the parameter or an estimation with known biases</rdfs:comment>
        <rdfs:label xml:lang="es">es una estimación verdadera de un parámetro epidemiológico</rdfs:label>
        <rdfs:label xml:lang="en">is true epidemiological parameter estimate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#resolvesHealthCondition -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#resolvesHealthCondition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Si un resultado de una estrategia resuelve la condición de salud en cuyo contexto se aplica la estrategia (falso si no se define). Para una manifestación aguda, termina el episodio. Para una condición de salud crónica, es una curación: sus pagos anuales y sus efectos se detienen cuando ocurre el resultado (ver hasEvaluationTime).</rdfs:comment>
        <rdfs:comment xml:lang="en">Whether an outcome of a strategy resolves the health condition in whose context the strategy is applied (false if not defined). For an acute manifestation, it ends the episode. For a chronic health condition, it is a cure: its annual payoffs and effects stop when the outcome happens (see hasEvaluationTime).</rdfs:comment>
        <rdfs:label xml:lang="en">resolves health condition</rdfs:label>
        <rdfs:label xml:lang="es">resuelve la condición de salud</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#resolvesOnSuccess -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/ontologies-ULL/OSDi#resolvesOnSuccess">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Forma abreviada (ver failsIf): si el éxito de una estrategia resuelve la condición de salud (ver resolvesHealthCondition).</rdfs:comment>
        <rdfs:comment xml:lang="en">Short form (see failsIf): whether the success of a strategy resolves the health condition (see resolvesHealthCondition).</rdfs:comment>
        <rdfs:label xml:lang="en">resolves on success</rdfs:label>
        <rdfs:label xml:lang="es">resuelve en caso de éxito</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/ontologies-ULL/OSDi#AcuteManifestation -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#AcuteManifestation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Manifestation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasFrequency"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionWithInitialProportion"/>
        <rdfs:comment xml:lang="es">Aparición súbita o rápida de signos o síntomas clínicos, en general con un curso corto e intenso. Sus costes y utilidades se aplican por episodio, así que deberían ser de una vez (appliesOneTime = true); una utilidad de una vez es una pérdida de AVAC. En un árbol de decisión, una manifestación aguda representa un único episodio entre la edad inicial de la población y la muerte: su caracterización del riesgo es la probabilidad de que ocurra el episodio y, como cualquier otra progresión, una manifestación aguda sin riesgo ocurre siempre en su contexto. Un árbol de decisión ignora la frecuencia (hasFrequency) de una manifestación aguda que define un riesgo, y no puede representar una que solo define una frecuencia. Los costes y utilidades anuales de una manifestación aguda se ignoran tanto en los árboles de decisión como en las simulaciones de eventos discretos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Sudden or rapid appearance of clinical signs or symptoms, in general with a short and intense course. Its costs and utilities apply per episode, so they should be one-time (appliesOneTime = true); a one-time utility is a loss of QALYs. In a decision tree, an acute manifestation represents a single episode between the initial age of the population and death: its risk characterization is the probability that the episode happens, and, as for any other progression, an acute manifestation without risk always happens in its context. A decision tree ignores the frequency (hasFrequency) of an acute manifestation that defines a risk, and cannot represent one that only defines a frequency. Annual costs and utilities of an acute manifestation are ignored both in decision trees and in discrete-event simulations.</rdfs:comment>
        <rdfs:label xml:lang="en">Acute manifestation</rdfs:label>
        <rdfs:label xml:lang="es">Manifestación aguda</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#AdverseEvent -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#AdverseEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRiskCharacterization"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isOccurrenceOf"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
        <rdfs:comment xml:lang="en">A health condition caused by a strategy (hasAdverseEvent), e.g., the diarrhoea caused by an antibiotic. Each time a strategy is applied, each of its adverse events happens with its risk (hasRiskCharacterization: a probability per application, or a time to event in a simulation), independently of the outcome of the strategy, unless the strategy fails because of the adverse event (failsIf), e.g., when the treatment is abandoned. Its costs and utilities apply once, when it happens (annual ones are not meaningful); its effects (including an InstantDeathEffect) and its own strategies apply to the patients who suffer it. isOccurrenceOf identifies the health condition it represents, but does not activate the structure of that condition. Rule for the modeller: if the problem belongs to the natural history of the disease and the strategy only changes its risk, use an Effect of the strategy on that risk; if the problem is caused by the strategy, use an AdverseEvent.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una condición de salud provocada por una estrategia (hasAdverseEvent), p. ej., la diarrea causada por un antibiótico. Cada vez que se aplica una estrategia, cada uno de sus efectos adversos ocurre con su riesgo (hasRiskCharacterization: una probabilidad por aplicación o, en simulación, un tiempo hasta el evento), con independencia del resultado de la estrategia, salvo que esta fracase por el efecto adverso (failsIf), p. ej., cuando se abandona el tratamiento. Sus costes y utilidades se aplican una vez, cuando ocurre (los anuales no tienen sentido); sus efectos (incluido un InstantDeathEffect) y sus propias estrategias se aplican a los pacientes que lo sufren. isOccurrenceOf identifica la condición de salud que representa, pero no activa la estructura de esa condición. Regla para quien modela: si el problema forma parte de la evolución natural de la enfermedad y la estrategia solo cambia su riesgo, se usa un Effect de la estrategia sobre ese riesgo; si lo provoca la estrategia, un AdverseEvent.</rdfs:comment>
        <rdfs:label xml:lang="en">Adverse event</rdfs:label>
        <rdfs:label xml:lang="es">Efecto adverso</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#AgentBasedModel -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#AgentBasedModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:comment xml:lang="en">A model based on using multiple agents</rdfs:comment>
        <rdfs:comment xml:lang="es">Un modelo basado en el uso de múltiples agentes</rdfs:comment>
        <rdfs:label xml:lang="en">Agent based model</rdfs:label>
        <rdfs:label xml:lang="es">Modelo basado en agentes</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#AlternativeCombinationRule -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#AlternativeCombinationRule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasNullProgression"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A set of disease progressions which are treated as mutually exclusive alternatives, e.g., a mild and a severe development of certain disease</rdfs:comment>
        <rdfs:comment xml:lang="es">Un conjunto de progresiones de la enfermedad que se tratan como alternativas mutuamente excluyentes, p. ej., un desarrollo leve y uno grave de cierta enfermedad</rdfs:comment>
        <rdfs:label xml:lang="en">Alternative disease progression set</rdfs:label>
        <rdfs:label xml:lang="es">Conjunto de progresiones de enfermedad alternativas</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#AtomicGuideline -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#AtomicGuideline">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSubGuideline"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#CompositeGuideline"/>
        <rdfs:comment xml:lang="en">A guideline with no sub-guidelines. Must be asserted: under the open-world assumption the absence of sub-guidelines cannot be inferred. Asserting it on a guideline that has sub-guidelines makes the ontology inconsistent.</rdfs:comment>
        <rdfs:comment xml:lang="es">Pauta sin subpautas. Debe asertarse: bajo la suposición de mundo abierto no se puede inferir la ausencia de subpautas. Asertarla en una pauta con subpautas hace la ontología inconsistente.</rdfs:comment>
        <rdfs:label xml:lang="en">Atomic guideline</rdfs:label>
        <rdfs:label xml:lang="es">Pauta simple</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Attribute -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Attribute">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasAttributeValue"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isAffectedBy"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSNOMED"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemDefiningDiseaseProgression"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithCost"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithDetection"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithEffect"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithFollowUp"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithRiskCharacterization"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithTemporalConstraints"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithTreatment"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithUtility"/>
        <rdfs:comment xml:lang="en">Clinical parameters that define the state of a patient and whose value may modify the evolution of the Disease and/or specific manifestations</rdfs:comment>
        <rdfs:comment xml:lang="es">Parámetros clínicos que definen el estado de un paciente y cuyo valor puede modificar la evolución de la enfermedad o de manifestaciones concretas</rdfs:comment>
        <rdfs:label xml:lang="es">Atributo</rdfs:label>
        <rdfs:label xml:lang="en">Attribute</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#AttributeValueParameter -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#AttributeValueParameter">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="en">A parameter that represents the value of an attribute</rdfs:comment>
        <rdfs:comment xml:lang="es">Un parámetro que representa el valor de un atributo</rdfs:comment>
        <rdfs:label xml:lang="en">Attribute Value Parameter</rdfs:label>
        <rdfs:label xml:lang="es">Parámetro de valor de atributo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#BernoulliDistributionExpression -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#BernoulliDistributionExpression">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO"/>
                <owl:hasValue>http://purl.obolibrary.org/obo/STATO_0000262</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProbabilityParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A discrete (0-1) probability distribution with just one parameter (the probability of an event)</rdfs:comment>
        <rdfs:comment xml:lang="es">Una distribución de probabilidad discreta (0-1) con un único parámetro (la probabilidad de un evento)</rdfs:comment>
        <rdfs:label xml:lang="es">Expresión para distribución de probabilidad de Bernoulli</rdfs:label>
        <rdfs:label xml:lang="en">Expression for a Bernoulli probability distribution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#BetaDistributionExpression -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#BetaDistributionExpression">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO"/>
                <owl:hasValue>http://purl.obolibrary.org/obo/STATO_0000177</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasAlfaParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasBetaParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Continuous probability distributions defined on the interval [0, 1] parametrized by two positive shape parameters, alfa and beta, generally estimated from the number of &apos;cases&apos; and &apos;no cases&apos; from an event</rdfs:comment>
        <rdfs:comment xml:lang="es">Distribuciones de probabilidad continuas definidas en el intervalo [0, 1] y parametrizadas por dos parámetros de forma positivos, alfa y beta, que suelen estimarse a partir del número de «casos» y «no casos» de un evento</rdfs:comment>
        <rdfs:label xml:lang="es">Expresión para distribución de probabilidad Beta</rdfs:label>
        <rdfs:label xml:lang="en">Expression for a Beta probability distribution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#dependsOn"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:onClass>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasExpressionLanguage"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ExpressionLanguage"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasExpressionValue"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ParameterNature"/>
        <rdfs:comment xml:lang="en">Parameter whose value is computed using an expression, generally dependent on other parameters</rdfs:comment>
        <rdfs:comment xml:lang="es">Parámetro cuyo valor se calcula mediante una expresión, que en general depende de otros parámetros</rdfs:comment>
        <rdfs:label xml:lang="en">Calculated Parameter</rdfs:label>
        <rdfs:label xml:lang="es">Parámetro calculado</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ChronicManifestation -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ChronicManifestation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Manifestation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasInitialProportion"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isParameterOf"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Conjunto de signos y síntomas de larga duración o que reaparecen con frecuencia</rdfs:comment>
        <rdfs:comment xml:lang="en">Long-lasting or frequently recurring set of signs and symptoms</rdfs:comment>
        <rdfs:label xml:lang="en">Chronic manifestation</rdfs:label>
        <rdfs:label xml:lang="es">Manifestación crónica</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DiseaseProgressionElement"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDuration"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEndAge"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasOnsetAge"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRiskCharacterization"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStrategy"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#FollowUpStrategy"/>
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#LineOfTherapy"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSubProgression"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#supersedesClinicalProgression"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToICD"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Any way in which a disease can progress: manifestations, symptoms, stages...</rdfs:comment>
        <rdfs:comment xml:lang="es">Cualquier forma en que puede progresar una enfermedad: manifestaciones, síntomas, estadios...</rdfs:comment>
        <rdfs:label xml:lang="en">Disease progression</rdfs:label>
        <rdfs:label xml:lang="es">Progresión de una enfermedad</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionWithInitialProportion -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionWithInitialProportion">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasInitialProportion"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isParameterOf"/>
                                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:comment xml:lang="en">A clinical progression element that is present in an initial proportion in a population</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento de progresión clínica que está presente en una proporción inicial de una población</rdfs:comment>
        <rdfs:label xml:lang="en">Clinical progression with initial proportion</rdfs:label>
        <rdfs:label xml:lang="es">Progresión clínica con proporción inicial</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#CoexistentCombinationRule -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#CoexistentCombinationRule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule"/>
        <rdfs:comment xml:lang="en">A set of disease progressions which can coexist at the same time, e.g. seizures and skin problems.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un conjunto de progresiones de la enfermedad que pueden coexistir al mismo tiempo, p. ej., crisis epilépticas y problemas de piel.</rdfs:comment>
        <rdfs:label xml:lang="en">Coexistent disease progression set</rdfs:label>
        <rdfs:label xml:lang="es">Conjunto de progresiones de enfermedad coexistentes</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#CompositeGuideline -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#CompositeGuideline">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSubGuideline"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSubGuidelineCombination"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A guideline made up of at least one sub-guideline. Inferred automatically. Values defined on a composite guideline (e.g. route, application age) are inherited by its sub-guidelines unless they redefine them.</rdfs:comment>
        <rdfs:comment xml:lang="es">Pauta formada por al menos una subpauta. Se infiere automáticamente. Los valores definidos en una pauta compuesta (p. ej. vía, edad de aplicación) los heredan sus subpautas salvo que los redefinan.</rdfs:comment>
        <rdfs:label xml:lang="en">Composite guideline</rdfs:label>
        <rdfs:label xml:lang="es">Pauta compuesta</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Cost -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Cost">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#YearDependantParameter"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDataItemType"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Currency"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#YearDependantParameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCategory"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#appliesOneTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">El coste de cualquier componente del modelo (intervención, tratamiento, progresión de la enfermedad...)</rdfs:comment>
        <rdfs:comment xml:lang="en">The cost of any component of the model (intervention, treatment, disease progression...)</rdfs:comment>
        <rdfs:label xml:lang="en">Cost</rdfs:label>
        <rdfs:label xml:lang="es">Coste</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Currency -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Currency">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#MeasuredDataItemType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToWikidata"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Data type to express costs</rdfs:comment>
        <rdfs:comment xml:lang="es">Tipo de dato para expresar costes</rdfs:comment>
        <rdfs:label xml:lang="en">Currency</rdfs:label>
        <rdfs:label xml:lang="es">Moneda</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DataItemType -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#DataItemType">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDescription"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"/>
        <rdfs:comment xml:lang="es">El tipo que define la naturaleza de un elemento de datos, ya sea su naturaleza estadística (probabilidad, riesgo relativo...) o alguna característica (moneda, utilidad...)</rdfs:comment>
        <rdfs:comment xml:lang="en">The type to define the nature of a data item, either its statistic nature (probability, relative risk...) or some characteristic (currency, utility...)</rdfs:comment>
        <rdfs:label xml:lang="en">Data item type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo del elemento de datos</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DecisionTreeModel -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#DecisionTreeModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:comment xml:lang="en">A model based on a decision tree</rdfs:comment>
        <rdfs:comment xml:lang="es">Un modelo basado en un árbol de decisión</rdfs:comment>
        <rdfs:label xml:lang="en">Decision tree model</rdfs:label>
        <rdfs:label xml:lang="es">Modelo de árbol de decisión</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DiagnosisIntervention"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ScreeningIntervention"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DiagnosisIntervention"/>
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ScreeningIntervention"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">An intervention intended to detect the presence of a disease or condition in a person</rdfs:comment>
        <rdfs:comment xml:lang="es">Una intervención destinada a detectar la presencia de una enfermedad o condición en una persona</rdfs:comment>
        <rdfs:label xml:lang="en">Detection intervention</rdfs:label>
        <rdfs:label xml:lang="es">Intervención de detección</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRiskIfDiseased"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRiskIfNotDiseased"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#InconclusiveDetectionOutcome"/>
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#NegativeDetectionOutcome"/>
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#PositiveDetectionOutcome"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">An outcome of a detection strategy. Its probability depends on whether the individual has the detected disease, so it declares a risk for each case (hasRiskIfDiseased, hasRiskIfNotDiseased). In each case, the outcome without risk (at most one) takes the remaining probability.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un resultado de una estrategia de detección. Su probabilidad depende de si el individuo tiene la enfermedad detectada, así que declara un riesgo para cada caso (hasRiskIfDiseased, hasRiskIfNotDiseased). En cada caso, el resultado sin riesgo (como mucho uno) se lleva la probabilidad restante.</rdfs:comment>
        <rdfs:label xml:lang="en">Detection outcome</rdfs:label>
        <rdfs:label xml:lang="es">Resultado de una detección</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#detects"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSensitivity"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDataItemType"/>
                                <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DI_Sensitivity"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSpecificity"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDataItemType"/>
                                <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DI_Specificity"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStrategyOutcome"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">A strategy related to the detection of a disease</rdfs:comment>
        <rdfs:comment xml:lang="en">A strategy related to the detection of a disease or diseases (detects), characterized by its sensitivity and specificity. In a screening model, the screening strategy of an arm is applied to the whole population, and the diagnosis strategy is applied to the patients that screen positive or, without screening, to the patients with the disease.</rdfs:comment>
        <rdfs:label xml:lang="en">Detection strategy</rdfs:label>
        <rdfs:label xml:lang="es">Estrategia de detección</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DeterministicParameter -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#DeterministicParameter">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUncertaintyCharacterization"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                        <owl:onClass>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:onClass>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasExpectedValue"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ParameterNature"/>
        <rdfs:comment xml:lang="en">Parameter with a fixed (no-uncertainty) value</rdfs:comment>
        <rdfs:comment xml:lang="es">Parámetro con un valor fijo (sin incertidumbre)</rdfs:comment>
        <rdfs:label xml:lang="en">Deterministic parameter</rdfs:label>
        <rdfs:label xml:lang="es">Parámetro determinista</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Development -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Development">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasInitialProportion"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isParameterOf"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Certain progression of a Disease that comprises a specific set of manifestations or a set of pathways to such manifestations</rdfs:comment>
        <rdfs:comment xml:lang="es">Cierta progresión de una enfermedad que comprende un conjunto concreto de manifestaciones o un conjunto de rutas hacia esas manifestaciones</rdfs:comment>
        <rdfs:label xml:lang="es">Desarrollo</rdfs:label>
        <rdfs:label xml:lang="en">Development</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DiagnosisIntervention -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#DiagnosisIntervention">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCategory"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DiagnosisCat"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ScreeningIntervention"/>
        <rdfs:comment xml:lang="en">An intervention intended to establish the presence/absence of certain disease or condition. The detection strategies of its arm are those of the disease, unless it replaces them through a StrategyReplacementEffect.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una intervención destinada a establecer la presencia o ausencia de cierta enfermedad o condición. Las estrategias de detección de su brazo son las de la enfermedad, salvo que las sustituya mediante un StrategyReplacementEffect.</rdfs:comment>
        <rdfs:label xml:lang="en">Diagnosis intervention</rdfs:label>
        <rdfs:label xml:lang="es">Intervención diagnóstica</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DiagnosisStrategy -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#DiagnosisStrategy">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCategory"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DiagnosisCat"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"/>
        <rdfs:comment xml:lang="en">A strategy related to the diagnosis of a disease</rdfs:comment>
        <rdfs:comment xml:lang="es">Una estrategia relacionada con el diagnóstico de una enfermedad</rdfs:comment>
        <rdfs:label xml:lang="en">Diagnosis strategy</rdfs:label>
        <rdfs:label xml:lang="es">Estrategia de diagnóstico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DiscreteEventSimulationModel -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#DiscreteEventSimulationModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:comment xml:lang="en">A model based on discrete events and entities</rdfs:comment>
        <rdfs:comment xml:lang="es">Un modelo basado en eventos discretos y entidades</rdfs:comment>
        <rdfs:label xml:lang="en">Discrete-event simulation model</rdfs:label>
        <rdfs:label xml:lang="es">Modelo de simulación de eventos discretos</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Disease -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Disease">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEpidemiologicalParameter"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#EpidemiologicalParameter"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isParameterOf"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProgressionElement"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DiseaseProgressionElement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRiskCharacterization"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#usesAttributeValue"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToDO"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToICD"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToOMIM"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSNOMED"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Any type of disease or health condition that a person may suffer. Since diseases may have or not costs, utilities... all of these properties has been explicitly defined with cardinality &apos;only&apos; as an hint for the ontology users</rdfs:comment>
        <rdfs:comment xml:lang="es">Cualquier tipo de enfermedad o condición de salud que puede sufrir una persona. Como las enfermedades pueden tener o no costes, utilidades..., todas estas propiedades se han definido explícitamente con la cardinalidad «only» como indicación para quienes usan la ontología</rdfs:comment>
        <rdfs:label xml:lang="en">Disease</rdfs:label>
        <rdfs:label xml:lang="es">Enfermedad</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#DiseaseProgressionElement -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#DiseaseProgressionElement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:comment xml:lang="en">An element characterizing the progression of a disease</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento que caracteriza la progresión de una enfermedad</rdfs:comment>
        <rdfs:label xml:lang="en">Disease progression element</rdfs:label>
        <rdfs:label xml:lang="es">Elemento de progresión de la enfermedad</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Effect -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Effect">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#affects"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCost"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Cost"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEffectMagnitude"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUtility"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Utility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An effect of a treatment or intervention. It applies its magnitude (hasEffectMagnitude) to the parameters or attributes it affects (affects). The subclasses define how the magnitude is applied (an instant death effect sets a probability of death, a life expectancy reduction effect subtracts years of life and an increased mortality rate effect multiplies the mortality rate), and a strategy replacement effect replaces the strategies of a health condition (see StrategyReplacementEffect); for a generic effect, the data item type of the magnitude defines the operation (see hasEffectMagnitude). When several effects modify the same parameter, the order is decided by the application; the suggested order is: first replace, then multiply (linear factors, then ratios of rates, then odds ratios) and finally subtract. At most one effect should replace the same parameter.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un efecto de un tratamiento o intervención. Aplica su magnitud (hasEffectMagnitude) a los parámetros o atributos a los que afecta (affects). Las subclases definen cómo se aplica la magnitud (un efecto de muerte inmediata fija una probabilidad de muerte, un efecto de reducción de la esperanza de vida resta años de vida y un efecto de aumento de la tasa de mortalidad multiplica la tasa de mortalidad), y un efecto de sustitución de estrategias sustituye las estrategias de una condición de salud (ver StrategyReplacementEffect); en un efecto genérico, el tipo de dato de la magnitud define la operación (ver hasEffectMagnitude). Cuando varios efectos modifican el mismo parámetro, el orden lo decide la aplicación; el orden sugerido es: primero sustituir, después multiplicar (factores lineales, después razones de tasas y después odds ratios) y por último restar. Como mucho un efecto debería sustituir un mismo parámetro.</rdfs:comment>
        <rdfs:label xml:lang="es">Efecto</rdfs:label>
        <rdfs:label xml:lang="en">Effect</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#EpidemiologicalParameter -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#EpidemiologicalParameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isTrueEpidemiologicalParameterEstimate"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A parameter related to the epidemiology (prevalence, incidence...) of a disease or condition</rdfs:comment>
        <rdfs:comment xml:lang="es">Un parámetro relacionado con la epidemiología (prevalencia, incidencia...) de una enfermedad o condición</rdfs:comment>
        <rdfs:label xml:lang="en">Epidemiological parameter</rdfs:label>
        <rdfs:label xml:lang="es">Parámetro epidemiológico</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Experiment -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Experiment">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#usesModel"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDescription"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDisutilityCombinationMethod"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>ADD</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>ADD_DISTINCT</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>MAX</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:onDataRange>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasYear"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCostCombinationMethod"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>ADD</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>ADD_DISTINCT</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:onDataRange>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDiscountForCosts"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDiscountForEffects"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasLifeExpectancyReductionCombinationMethod"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>ADD</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>ADD_DISTINCT</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>MAX</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:onDataRange>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasMortalityRateCombinationMethod"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>MAX</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>MULT</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:onDataRange>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasTimeHorizon"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"/>
        <rdfs:comment xml:lang="en">An HTA experiment that uses a model, some input parameters and obtains results</rdfs:comment>
        <rdfs:comment xml:lang="es">Un experimento de ETS que usa un modelo y unos parámetros de entrada, y obtiene resultados</rdfs:comment>
        <rdfs:label xml:lang="en">Experiment</rdfs:label>
        <rdfs:label xml:lang="es">Experimento</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ExponentialDistributionExpression -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ExponentialDistributionExpression">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO"/>
                <owl:hasValue>http://purl.obolibrary.org/obo/STATO_0000160</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasLambdaParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Continuous probability distribution that describes the time between events in a Poisson process, i.e. a process in which events occur continuously and independently at a constant average rate</rdfs:comment>
        <rdfs:comment xml:lang="es">Distribución de probabilidad continua que describe el tiempo entre eventos en un proceso de Poisson, es decir, un proceso en el que los eventos ocurren de forma continua e independiente a una tasa media constante</rdfs:comment>
        <rdfs:label xml:lang="es">Expresión para distribución de probabilidad Exponencial</rdfs:label>
        <rdfs:label xml:lang="en">Expression for an Exponential probability distribution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ExpressionLanguage -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ExpressionLanguage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Exp_Excel"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Exp_JEXL"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Exp_Java"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Exp_Javaluator"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDescription"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode"/>
        <rdfs:comment xml:lang="en">Language used to define an expression in a string. Generally used to compute something from other items of the model. Only the predefined languages are allowed, but future versions of the ontology may include more.</rdfs:comment>
        <rdfs:comment xml:lang="es">Lenguaje usado para definir una expresión en una cadena de texto. En general se usa para calcular algo a partir de otros elementos del modelo. Solo se admiten los lenguajes predefinidos, pero futuras versiones de la ontología pueden incluir más.</rdfs:comment>
        <rdfs:label xml:lang="en">Expression language</rdfs:label>
        <rdfs:label xml:lang="es">Lenguaje de expresión</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#FailureOutcome -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#FailureOutcome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#SuccessOutcome"/>
        <rdfs:comment xml:lang="es">El fracaso de una estrategia. Es el resultado que genera failsIf (con el riesgo del parámetro, o cuando aparece la condición de salud) y al que sigue followedOnFailureBy en la forma abreviada.</rdfs:comment>
        <rdfs:comment xml:lang="en">The failure of a strategy. It is the outcome generated by failsIf (with the risk of the parameter, or when the health condition appears) and followed by followedOnFailureBy in the short form.</rdfs:comment>
        <rdfs:label xml:lang="en">Failure outcome</rdfs:label>
        <rdfs:label xml:lang="es">Fracaso</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#FirstOrderUncertaintyParameter -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#FirstOrderUncertaintyParameter">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUncertaintyCharacterization"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasExpectedValue"/>
                        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ParameterNature"/>
        <rdfs:comment xml:lang="en">Parameter whose value has first-order uncertainty, i.e., the value for each individual is not fixed</rdfs:comment>
        <rdfs:comment xml:lang="es">Parámetro cuyo valor tiene incertidumbre de primer orden, es decir, el valor de cada individuo no es fijo</rdfs:comment>
        <rdfs:label xml:lang="en">First-order uncertainty parameter</rdfs:label>
        <rdfs:label xml:lang="es">Parámetro con incertidumbre de primer orden</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#FollowUpStrategy -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#FollowUpStrategy">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCategory"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#FollowUpCat"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStrategyOutcome"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A strategy related to the follow-up of a disease or condition. It may have treatment outcomes (TreatmentOutcome). A relapse after the response is modeled with a follow-up strategy: the success of a treatment is followed (followedOnSuccessBy, or the followedByStrategy of its SuccessOutcome) by a follow-up strategy whose failure (FailureOutcome) is the relapse. The risk of that failure is the probability of relapse among the patients who responded, and the failure may be followed by the treatment of the relapse (followedByStrategy). A long-term recurrence is not a relapse, but a new episode of the same acute manifestation.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una estrategia relacionada con el seguimiento de una enfermedad o condición. Puede tener resultados de tratamiento (TreatmentOutcome). Una recaída tras la respuesta se modela con una estrategia de seguimiento: el éxito de un tratamiento va seguido (followedOnSuccessBy, o el followedByStrategy de su SuccessOutcome) de una estrategia de seguimiento cuyo fracaso (FailureOutcome) es la recaída. El riesgo de ese fracaso es la probabilidad de recaída entre los pacientes que respondieron, y el fracaso puede ir seguido del tratamiento de la recaída (followedByStrategy). Una recurrencia a largo plazo no es una recaída, sino un nuevo episodio de la misma manifestación aguda.</rdfs:comment>
        <rdfs:label xml:lang="es">Estrategia de seguimiento</rdfs:label>
        <rdfs:label xml:lang="en">Follow-up strategy</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#GammaDistributionExpression -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#GammaDistributionExpression">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO"/>
                <owl:hasValue>http://purl.obolibrary.org/obo/STATO_0000268</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasAlfaParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasThetaParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Continuous distribution of probability generally used to model costs, characterized by two parameters: the shape k (hasAlfaParameter) and the scale theta (hasThetaParameter), so that the mean is k * theta and the variance, k * theta^2. A gamma distribution expressed with a rate lambda (1 / theta) must be converted into its scale theta = 1 / lambda. In OSDi 1.2, the scale was called hasLambdaParameter.</rdfs:comment>
        <rdfs:comment xml:lang="es">Distribución de probabilidad continua que se usa en general para modelar costes, caracterizada por dos parámetros: la forma k (hasAlfaParameter) y la escala theta (hasThetaParameter), de modo que la media es k * theta y la varianza, k * theta^2. Una distribución gamma expresada con una tasa lambda (1 / theta) debe convertirse a su escala theta = 1 / lambda. En OSDi 1.2, la escala se llamaba hasLambdaParameter.</rdfs:comment>
        <rdfs:label xml:lang="es">Expresión para distribución de probabilidad Gamma</rdfs:label>
        <rdfs:label xml:lang="en">Expression for a Gamma probability distribution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Group -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Group">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasGroupItem"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GroupableModelItem"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:comment xml:lang="en">A group of model items. Useful to categorize or &apos;putting together&apos; manifestations (e.g. all the eye-related manifestations of diabetes) or other model items</rdfs:comment>
        <rdfs:comment xml:lang="es">Un grupo de elementos del modelo. Útil para clasificar o «agrupar» manifestaciones (p. ej., todas las manifestaciones oculares de la diabetes) u otros elementos del modelo</rdfs:comment>
        <rdfs:label xml:lang="en">Group</rdfs:label>
        <rdfs:label xml:lang="es">Grupo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#GroupableModelItem -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#GroupableModelItem">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isGroupItemOf"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Group"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:comment xml:lang="en">A model item that can be put in a group</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que puede incluirse en un grupo</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo agrupable</rdfs:label>
        <rdfs:label xml:lang="en">Groupable model item</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#GroupableModelItemWithProportion -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#GroupableModelItemWithProportion">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#GroupableModelItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProportionWithinGroup"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#GroupableModelItem"/>
        <rdfs:comment xml:lang="en">A groupable model item that declares its proportion within the group (hasProportionWithinGroup)</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo agrupable que declara su proporción dentro del grupo (hasProportionWithinGroup)</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo agrupable con proporción</rdfs:label>
        <rdfs:label xml:lang="en">Groupable model item with proportion</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Guideline -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Guideline">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasConditionExpression"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSubGuideline"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isGuidelineOf"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthTechnology"/>
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCount"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDose"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDuration"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasFrequency"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasMaxApplicationAge"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasMinApplicationAge"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasPeriod"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStartOffset"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isSubGuidelineOf"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithCost"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithUtility"/>
        <rdfs:comment xml:lang="es">La forma en que se aplica una tecnología sanitaria o una estrategia: qué dosis, con qué frecuencia (aplicaciones por periodo), durante cuánto tiempo (duración o número de aplicaciones), cuándo empieza (desfase) y a quién (límites de edad, expresiones de condición). Una pauta puede descomponerse en subpautas, de forma recursiva.</rdfs:comment>
        <rdfs:comment xml:lang="en">The way a health technology or strategy is applied: what dose, how often (frequency per period), for how long (duration or number of applications), when it starts (offset) and to whom (age bounds, condition expressions). A guideline may be decomposed into sub-guidelines, recursively.</rdfs:comment>
        <rdfs:label xml:lang="en">Guideline</rdfs:label>
        <rdfs:label xml:lang="es">Pauta</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#GuidelineCombinationMode">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#GuidelineCombination_Alternative"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#GuidelineCombination_Concurrent"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#GuidelineCombination_Sequential"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:comment xml:lang="en">Closed set of ways in which the sub-guidelines of a composite guideline are combined.</rdfs:comment>
        <rdfs:comment xml:lang="es">Conjunto cerrado de formas de combinar las subpautas de una pauta compuesta.</rdfs:comment>
        <rdfs:label xml:lang="en">Guideline combination mode</rdfs:label>
        <rdfs:label xml:lang="es">Modo de combinación de pautas</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#HealthCondition -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthCondition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCost"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Cost"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEffect"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasIntervention"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStrategy"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUtility"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Utility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Any disease, symptom or clinical sign that affects the health of an individual</rdfs:comment>
        <rdfs:comment xml:lang="es">Cualquier enfermedad, síntoma o signo clínico que afecta a la salud de un individuo</rdfs:comment>
        <rdfs:label xml:lang="es">Condición de salud</rdfs:label>
        <rdfs:label xml:lang="en">Health condition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#HealthTechnology -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#HealthTechnology">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"/>
        <rdfs:comment xml:lang="en">Any treatment, drug, test... that may be applied to a patient. In the context of this ontology, this class and its subclasses define resource usage to compute costs and must not be confused with the &apos;interventions&apos;</rdfs:comment>
        <rdfs:comment xml:lang="es">Cualquier tratamiento, fármaco, prueba... que puede aplicarse a un paciente. En el contexto de esta ontología, esta clase y sus subclases definen el uso de recursos para calcular costes y no deben confundirse con las «intervenciones»</rdfs:comment>
        <rdfs:label xml:lang="en">Health technology</rdfs:label>
        <rdfs:label xml:lang="es">Tecnología sanitaria</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#InconclusiveDetectionOutcome -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#InconclusiveDetectionOutcome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#followedByStrategy"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An inconclusive result of a detection strategy: the individual is not classified, so the outcome must be followed by another strategy (a repetition of the test, modeled as another strategy, or a different test).</rdfs:comment>
        <rdfs:comment xml:lang="es">Un resultado no concluyente de una estrategia de detección: el individuo no queda clasificado, así que el resultado debe ir seguido de otra estrategia (una repetición de la prueba, modelada como otra estrategia, o una prueba distinta).</rdfs:comment>
        <rdfs:label xml:lang="en">Inconclusive detection outcome</rdfs:label>
        <rdfs:label xml:lang="es">Resultado no concluyente de una detección</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#IncreasedMortalityRateEffect -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#IncreasedMortalityRateEffect">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#affects"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute_LifeExpectancy"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An increment on the mortality rate of an individual or population.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un incremento de la tasa de mortalidad de un individuo o una población.</rdfs:comment>
        <rdfs:label xml:lang="es">Efecto de incremento en la tasa de mortalidad</rdfs:label>
        <rdfs:label xml:lang="en">Increased mortality rate effect</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#InfectiousDisease -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#InfectiousDisease">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#InheritedDisease"/>
        <rdfs:comment xml:lang="en">A disease that is transmitted from one person to another through various means</rdfs:comment>
        <rdfs:comment xml:lang="es">Una enfermedad que se transmite de una persona a otra por diversos medios</rdfs:comment>
        <rdfs:label xml:lang="es">Enfermedad infecciosa</rdfs:label>
        <rdfs:label xml:lang="en">Infectious disease</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#InheritedDisease -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#InheritedDisease">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
        <rdfs:comment xml:lang="en">A disease that is passed down from parent to child through genes</rdfs:comment>
        <rdfs:comment xml:lang="es">Una enfermedad que se transmite de padres a hijos a través de los genes</rdfs:comment>
        <rdfs:label xml:lang="es">Enfermedad hereditaria</rdfs:label>
        <rdfs:label xml:lang="en">Inherited disease</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#InstantDeathEffect -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#InstantDeathEffect">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#affects"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute_LifeExpectancy"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCost"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Cost"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Define un riesgo de muerte «instantánea», p. ej., una probabilidad de morir al aparecer una condición</rdfs:comment>
        <rdfs:comment xml:lang="en">Defines an &apos;instantaneous&apos; death risk, e.g., a probability of dying upon the onset of a condition</rdfs:comment>
        <rdfs:label xml:lang="es">Efecto de muerte instantánea</rdfs:label>
        <rdfs:label xml:lang="en">Instantaneous death effect</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Intervention -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCategory"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCost"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Cost"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEffect"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUtility"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Utility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isInterventionOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemDefiningDiseaseProgression"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithRiskCharacterization"/>
        <rdfs:comment xml:lang="es">Algún tipo de tratamiento, fármaco, procedimiento quirúrgico... usado para modificar el desarrollo de una enfermedad. En el contexto de esta ontología, las intervenciones son las opciones que se comparan en el proceso de toma de decisiones. Cada intervención tiene exactamente un objetivo (isInterventionOf): la enfermedad o un elemento de su progresión.</rdfs:comment>
        <rdfs:comment xml:lang="en">Some kind of treatment, drug, surgical procedure... used to modify the development of a Disease. In the context of this ontology, interventions are the comparing options in the decision-making process. Each intervention has exactly one target (isInterventionOf): the disease or an element of its progression.</rdfs:comment>
        <rdfs:label xml:lang="es">Intervención</rdfs:label>
        <rdfs:label xml:lang="en">Intervention</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#LifeExpectancyReductionEffect -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#LifeExpectancyReductionEffect">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#affects"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute_LifeExpectancy"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An effect that reduces the life expectancy of an individual or population.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un efecto que reduce la esperanza de vida de un individuo o una población.</rdfs:comment>
        <rdfs:label xml:lang="es">Efecto de reducción en la esperanza de vida</rdfs:label>
        <rdfs:label xml:lang="en">Life expectancy reduction effect</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#LineOfTherapy -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#LineOfTherapy">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCategory"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#TreatmentCat"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStrategy"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#FollowUpStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStrategyOutcome"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A strategy related to the treatment of a disease or condition</rdfs:comment>
        <rdfs:comment xml:lang="es">Una estrategia relacionada con el tratamiento de una enfermedad o condición</rdfs:comment>
        <rdfs:label xml:lang="es">Estrategia de tratamiento</rdfs:label>
        <rdfs:label xml:lang="en">Line-of-therapy strategy</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Manifestation -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Manifestation">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#AcuteManifestation"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ChronicManifestation"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSubProgression"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#AcuteManifestation"/>
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ChronicManifestation"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="en">Symptoms or signs of a disease. They may be chronic or acute</rdfs:comment>
        <rdfs:comment xml:lang="es">Síntomas o signos de una enfermedad. Pueden ser crónicos o agudos</rdfs:comment>
        <rdfs:label xml:lang="es">Manifestación</rdfs:label>
        <rdfs:label xml:lang="en">Manifestation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#MarkovModel -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#MarkovModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
        <rdfs:comment xml:lang="en">Model based on Markov states and transitions</rdfs:comment>
        <rdfs:comment xml:lang="es">Modelo basado en estados y transiciones de Markov</rdfs:comment>
        <rdfs:label xml:lang="en">Markov model</rdfs:label>
        <rdfs:label xml:lang="es">Modelo de Markov</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#MeasuredDataItemType -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#MeasuredDataItemType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUnit"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
        <rdfs:comment xml:lang="es">Tipo para elementos de datos medibles</rdfs:comment>
        <rdfs:comment xml:lang="en">Type for data items that are measurable</rdfs:comment>
        <rdfs:label xml:lang="en">Measured data item type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo del elemento de datos medible</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Model -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Model">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasAssessedIntervention"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasComparatorIntervention"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#usesSameModelItemsAs"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasAuthor"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasGeographicalContext"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDescription"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefTo"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A container to define all the items that conform a model that can be simulated</rdfs:comment>
        <rdfs:comment xml:lang="es">Un contenedor para definir todos los elementos que forman un modelo que puede simularse</rdfs:comment>
        <rdfs:label xml:lang="en">Model</rdfs:label>
        <rdfs:label xml:lang="es">Modelo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ModelItem -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDescription"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Any component of a model</rdfs:comment>
        <rdfs:comment xml:lang="es">Cualquier componente de un modelo</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo</rdfs:label>
        <rdfs:label xml:lang="en">Model item</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ModelItemDefiningDiseaseProgression -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItemDefiningDiseaseProgression">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasProgressionElement"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"/>
        <rdfs:comment xml:lang="en">A model item that defines the progression of a disease</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que define la progresión de una enfermedad</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo definiendo progreso de la enfermedad</rdfs:label>
        <rdfs:label xml:lang="en">Model item defining disease progression</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ModelItemWithCost -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithCost">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCost"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Cost"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:comment xml:lang="en">A model item that has at least one associated cost, i.e., it must be taken into account when computing the cost of the cost-effectiveness analysis</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que tiene al menos un coste asociado, es decir, debe tenerse en cuenta al calcular el coste del análisis de coste-efectividad</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo con coste</rdfs:label>
        <rdfs:label xml:lang="en">Model item with cost</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ModelItemWithDetection -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithDetection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#TherapeuticIntervention"/>
        <rdfs:comment xml:lang="en">A model item that represents a detection mechanism for a disease</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que representa un mecanismo de detección de una enfermedad</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo con detección</rdfs:label>
        <rdfs:label xml:lang="en">Model item with detection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ModelItemWithEffect -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithEffect">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEffect"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:comment xml:lang="en">A model item that has at least one associated effect</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que tiene al menos un efecto asociado</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo con efecto</rdfs:label>
        <rdfs:label xml:lang="en">Model item with effect</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ModelItemWithFollowUp -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithFollowUp">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStrategy"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#FollowUpStrategy"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStrategy"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#FollowUpStrategy"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:comment xml:lang="en">A model item that has at least one associated follow-up cost or strategy</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que tiene al menos un coste o una estrategia de seguimiento asociados</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo con seguimiento</rdfs:label>
        <rdfs:label xml:lang="en">Model item with follow-up</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ModelItemWithRiskCharacterization -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithRiskCharacterization">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRiskCharacterization"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"/>
        <rdfs:comment xml:lang="en">A model item that has risk characterization, i.e., associated with a parameter or pathway that represents a risk factor</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que tiene caracterización del riesgo, es decir, está asociado a un parámetro o una ruta que representa un factor de riesgo</rdfs:comment>
        <rdfs:label xml:lang="en">Model item with risk characterization</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de elemento del modelo con caracterización de riesgo</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ModelItemWithTemporalConstraints -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithTemporalConstraints">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDuration"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEndAge"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasOnsetAge"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:comment xml:lang="en">A model item that has temporal constraints, i.e., duration, onset age, and end age</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que tiene restricciones temporales, es decir, duración, edad de inicio y edad de fin</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo con restricciones temporales</rdfs:label>
        <rdfs:label xml:lang="en">Model item with temporal constraints</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ModelItemWithTreatment -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithTreatment">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStrategy"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#LineOfTherapy"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStrategy"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#LineOfTherapy"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Pathway"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:comment xml:lang="en">A model item that has at least one associated treatment cost or line-of-therapy</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que tiene al menos un coste de tratamiento o una línea de terapia asociados</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo con tratamiento</rdfs:label>
        <rdfs:label xml:lang="en">Model item with treatment</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ModelItemWithUtility -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItemWithUtility">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUtility"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Utility"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:comment xml:lang="en">A model item that has at least one associated utility, i.e., it must be taken into account when computing the effectiveness of the cost-effectiveness analysis</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que tiene al menos una utilidad asociada, es decir, debe tenerse en cuenta al calcular la efectividad del análisis de coste-efectividad</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo con utilidad</rdfs:label>
        <rdfs:label xml:lang="en">Model item with utility</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#NegativeDetectionOutcome -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#NegativeDetectionOutcome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome"/>
        <rdfs:comment xml:lang="en">A negative result of a detection strategy: the individual is not detected (false negative if diseased, true negative otherwise).</rdfs:comment>
        <rdfs:comment xml:lang="es">Un resultado negativo de una estrategia de detección: el individuo no es detectado (falso negativo si tiene la enfermedad, verdadero negativo en otro caso).</rdfs:comment>
        <rdfs:label xml:lang="en">Negative detection outcome</rdfs:label>
        <rdfs:label xml:lang="es">Resultado negativo de una detección</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#NormalDistributionExpression -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#NormalDistributionExpression">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO"/>
                <owl:hasValue>http://purl.obolibrary.org/obo/STATO_0000227</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Distribución de probabilidad continua, no acotada y simétrica, caracterizada por dos parámetros: la media, que coincide con la moda de la distribución, y la desviación estándar.</rdfs:comment>
        <rdfs:comment xml:lang="en">Unbounded and symmetric continuous probability distribution, characterized by two parameters: average, that falls in the mode of the distribution, and standard deviation.</rdfs:comment>
        <rdfs:label xml:lang="es">Expresión para distribución de probabilidad Normal</rdfs:label>
        <rdfs:label xml:lang="en">Expression for a Normal probability distribution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasNext"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasPrevious"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:comment xml:lang="en">A model item that has a specific order with respect to other model items, such as the stage of a disease</rdfs:comment>
        <rdfs:comment xml:lang="es">Un elemento del modelo que tiene un orden concreto respecto a otros elementos del modelo, como el estadio de una enfermedad</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento del modelo ordenado</rdfs:label>
        <rdfs:label xml:lang="en">Ordered Model Item</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Parameter -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isAffectedBy"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDataItemType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasGeographicalContext"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSource"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Parameters used for computing outcomes or characterize certain class. They have a source, a geographical context, year, description and value</rdfs:comment>
        <rdfs:comment xml:lang="es">Parámetros usados para calcular resultados o caracterizar cierta clase. Tienen una fuente, un contexto geográfico, un año, una descripción y un valor</rdfs:comment>
        <rdfs:label xml:lang="en">Parameter</rdfs:label>
        <rdfs:label xml:lang="es">Parámetro</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ParameterNature -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ParameterNature">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DeterministicParameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#FirstOrderUncertaintyParameter"/>
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#SecondOrderUncertaintyParameter"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#CalculatedParameter"/>
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DeterministicParameter"/>
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#FirstOrderUncertaintyParameter"/>
            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#SecondOrderUncertaintyParameter"/>
        </owl:disjointUnionOf>
        <rdfs:comment xml:lang="es">La naturaleza de los valores de un parámetro, es decir, si es una constante, si se calcula o si caracteriza de algún modo la incertidumbre. Debe usarse para definir parámetros junto con «Parameter» o cualquiera de sus subclases; p. ej., un individuo que define el coste de un fármaco debería pertenecer tanto a «Cost» como a «DeterministicParameter»</rdfs:comment>
        <rdfs:comment xml:lang="en">The nature of the values of a parameter, i.e., whether it is a constant, calculated, or characterizes uncertainty somehow. This must be used to define parameters together with &apos;Parameter&apos; or any of its subclasses, i.e. an individual defining the cost of a drug should be subclass of both &apos;Cost&apos; and &apos;DeterministicParameter&apos;</rdfs:comment>
        <rdfs:label xml:lang="es">Naturaleza del parámetro</rdfs:label>
        <rdfs:label xml:lang="en">Parameter nature</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Pathway -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Pathway">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCost"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Cost"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEffect"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUtility"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Utility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#requires"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">La forma en que aparece una enfermedad, desarrollo, manifestación o estadio, es decir, las condiciones que deben cumplirse para llegar a cualquiera de ellos.</rdfs:comment>
        <rdfs:comment xml:lang="en">The way a disease, development, manifestation or stage appears, i.e., the conditions that must be met to lead to any of these.</rdfs:comment>
        <rdfs:label xml:lang="en">Pathway</rdfs:label>
        <rdfs:label xml:lang="es">Ruta</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#PoissonDistributionExpression -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#PoissonDistributionExpression">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO"/>
                <owl:hasValue>http://purl.obolibrary.org/obo/STATO_0000051</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasLambdaParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Discrete probability distribution used to model the number of events occurring within a given time interval. It is defined by a real number (lambda).</rdfs:comment>
        <rdfs:comment xml:lang="es">Distribución de probabilidad discreta usada para modelar el número de eventos que ocurren en un intervalo de tiempo dado. Se define mediante un número real (lambda).</rdfs:comment>
        <rdfs:label xml:lang="es">Expresión para distribución de probabilidad de Poisson</rdfs:label>
        <rdfs:label xml:lang="en">Expression for a Poisson probability distribution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Population -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Population">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#usesAttributeValue"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEpidemiologicalParameter"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#EpidemiologicalParameter"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isParameterOf"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasInitialProportion"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasParameter"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSubpopulation"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUtility"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Utility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasAge"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute_Age"/>
                    </owl:Restriction>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSex"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute_Sex"/>
                    </owl:Restriction>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasLifeExpectancy"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isValueOfAttribute"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Attribute_LifeExpectancy"/>
                    </owl:Restriction>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isSubPopulationOf"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasGeographicalContext"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasMaxAge"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasMinAge"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSize"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasYear"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Las características de la población a la que se dirigen las intervenciones evaluadas</rdfs:comment>
        <rdfs:comment xml:lang="en">The characteristics of the population which is the objective of the assessed interventions</rdfs:comment>
        <rdfs:label xml:lang="es">Población</rdfs:label>
        <rdfs:label xml:lang="en">Population</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#PositiveDetectionOutcome -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#PositiveDetectionOutcome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionOutcome"/>
        <rdfs:comment xml:lang="en">A positive result of a detection strategy: the individual is detected (true positive if diseased, false positive otherwise). It is usually followed by a confirmatory diagnosis. When it is followed by a diagnosis strategy, the diagnosis confirms the result; when it is followed by another detection strategy (e.g., a second-tier test), the individual is tested again. Without its own followedByStrategy, it is followed by the followedByStrategy of its detection strategy, if any.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un resultado positivo de una estrategia de detección: el individuo es detectado (verdadero positivo si tiene la enfermedad, falso positivo en otro caso). Normalmente va seguido de un diagnóstico de confirmación. Si va seguido de una estrategia de diagnóstico, el diagnóstico confirma el resultado; si va seguido de otra estrategia de detección (p. ej., una prueba de segundo nivel), el individuo vuelve a someterse a una prueba. Sin su propio followedByStrategy, le sigue el followedByStrategy de su estrategia de detección, si lo hay.</rdfs:comment>
        <rdfs:label xml:lang="en">Positive detection outcome</rdfs:label>
        <rdfs:label xml:lang="es">Resultado positivo de una detección</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasAverageParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasOffsetParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToSTATO"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasScaleParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasStandardDeviationParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An expression that defines a probability distribution</rdfs:comment>
        <rdfs:comment xml:lang="es">Una expresión que define una distribución de probabilidad</rdfs:comment>
        <rdfs:label xml:lang="es">Expresión para distribución de probabilidad</rdfs:label>
        <rdfs:label xml:lang="en">Probability distribution expression</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DiseaseProgressionElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#affectsProgressionElement"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A rule that defines how to combine a set of disease progressions (exclusions, coexistence...)</rdfs:comment>
        <rdfs:comment xml:lang="es">Una regla que define cómo combinar un conjunto de progresiones de la enfermedad (exclusiones, coexistencia...)</rdfs:comment>
        <rdfs:label xml:lang="en">Pogression combination rule</rdfs:label>
        <rdfs:label xml:lang="es">Regla de combinación de progresiones</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#QoLDataItemType -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#QoLDataItemType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DataItemType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCalculationMethod"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A type of data item related to quality-of-life measures</rdfs:comment>
        <rdfs:comment xml:lang="es">Un tipo de elemento de datos relacionado con medidas de calidad de vida</rdfs:comment>
        <rdfs:label xml:lang="en">Quality-of-Life Data Item Type</rdfs:label>
        <rdfs:label xml:lang="es">Tipo de elemento de datos de calidad de vida</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#RareDisease -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#RareDisease">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Disease"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToGARD"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasRefToORDO"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A disease with very low prevalence</rdfs:comment>
        <rdfs:comment xml:lang="es">Una enfermedad con una prevalencia muy baja</rdfs:comment>
        <rdfs:label xml:lang="es">Enfermedad rara</rdfs:label>
        <rdfs:label xml:lang="en">Rare disease</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCategory"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCost"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Cost"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEffect"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasGuideline"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Guideline"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUtility"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Utility"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">Elemento relacionado con el uso de recursos sanitarios, que pertenece a alguna categoría concreta</rdfs:comment>
        <rdfs:comment xml:lang="en">Item related to the use of health resources, belonging to some specific category</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento de uso de recursos</rdfs:label>
        <rdfs:label xml:lang="en">Resource Usage Item</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ScreeningIntervention -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ScreeningIntervention">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCategory"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ScreeningCat"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionIntervention"/>
        <rdfs:comment xml:lang="en">An intervention to identify the subset of population who may have certain disease or condition and require further testing to obtain a final diagnosis. A screening intervention declares its screening strategy through a StrategyReplacementEffect on the disease: its replacement (usually a group with the screening strategy and the confirmatory diagnosis strategy) replaces the detection strategies of the disease in its arm. The sensitivity, specificity and costs of the screening are those of the screening strategy.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una intervención para identificar el subconjunto de la población que puede tener cierta enfermedad o condición y requiere más pruebas para obtener un diagnóstico final. Una intervención de cribado declara su estrategia de cribado mediante un StrategyReplacementEffect sobre la enfermedad: su sustitución (normalmente un grupo con la estrategia de cribado y la estrategia de diagnóstico de confirmación) sustituye las estrategias de detección de la enfermedad en su brazo. La sensibilidad, la especificidad y los costes del cribado son los de la estrategia de cribado.</rdfs:comment>
        <rdfs:label xml:lang="es">Intervención de cribado</rdfs:label>
        <rdfs:label xml:lang="en">Screening intervention</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#ScreeningStrategy -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#ScreeningStrategy">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCategory"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ScreeningCat"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#DetectionStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasTemporaryThreshold"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A strategy related to the identification of persons potentially suffering a disease among a population</rdfs:comment>
        <rdfs:comment xml:lang="es">Una estrategia relacionada con la identificación, dentro de una población, de las personas que pueden padecer una enfermedad</rdfs:comment>
        <rdfs:label xml:lang="es">Estrategia de cribado</rdfs:label>
        <rdfs:label xml:lang="en">Screening strategy</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#SecondOrderUncertaintyParameter -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#SecondOrderUncertaintyParameter">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUncertaintyCharacterization"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasExpectedValue"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ParameterNature"/>
        <rdfs:comment xml:lang="en">Parameter whose value has second-order uncertainty, i.e. the precise value is not known and is subject to uncertainty. For example, the actual value of the effectiveness of a treatment could have been derived from a metaanalysis of several studies and being defined by an average but also confidence intervals</rdfs:comment>
        <rdfs:comment xml:lang="es">Parámetro cuyo valor tiene incertidumbre de segundo orden, es decir, el valor exacto no se conoce y está sujeto a incertidumbre. Por ejemplo, el valor real de la efectividad de un tratamiento podría proceder de un metaanálisis de varios estudios y estar definido por una media, pero también por intervalos de confianza</rdfs:comment>
        <rdfs:label xml:lang="es">Parámetro con incertidumbre de segundo orden</rdfs:label>
        <rdfs:label xml:lang="en">Second-order uncertainty parameter</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#SequentialCombinationRule -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#SequentialCombinationRule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProgressionCombinationRule"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#affectsProgressionElement"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#OrderedModelItem"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasFirst"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A set of disease progressions that appear sequentially, e.g., the stages of a cancer. The first element is given by hasFirst and the order by hasNext/hasPrevious. Like the other combination rules, it must be asserted.</rdfs:comment>
        <rdfs:comment xml:lang="es">Conjunto de progresiones de enfermedad que aparecen de forma secuencial, p. ej. los estadios de un cáncer. El primer elemento se indica con hasFirst y el orden con hasNext/hasPrevious. Como el resto de reglas de combinación, debe asertarse.</rdfs:comment>
        <rdfs:label xml:lang="es">Conjunto de progresiones de enfermedad secuenciales</rdfs:label>
        <rdfs:label xml:lang="en">Sequential disease progression set</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Stage -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Stage">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasInitialProportion"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isParameterOf"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Population"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasSubProgression"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#ClinicalProgressionElement"/>
                            <owl:Class>
                                <owl:complementOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Development"/>
                            </owl:Class>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A phase or step in the progression of a disease</rdfs:comment>
        <rdfs:comment xml:lang="es">Una fase o etapa de la progresión de una enfermedad</rdfs:comment>
        <rdfs:label xml:lang="es">Estadio</rdfs:label>
        <rdfs:label xml:lang="en">Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Strategy -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ResourceUsageItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#followedByStrategy"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasGroupItem"/>
                                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasConditionExpression"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#usesHealthTechnology"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthTechnology"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A way of defining a series of steps required to treat, detect or follow-up a disease or condition</rdfs:comment>
        <rdfs:comment xml:lang="es">Una forma de definir la serie de pasos necesarios para tratar, detectar o hacer el seguimiento de una enfermedad o condición</rdfs:comment>
        <rdfs:label xml:lang="es">Estrategia</rdfs:label>
        <rdfs:label xml:lang="en">Strategy</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ModelItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#followedByStrategy"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasEvaluationTime"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">One of the mutually exclusive outcomes of a strategy (hasStrategyOutcome). An outcome declares how likely it is (hasOutcomeRisk and its subproperties), the strategy that follows it (followedByStrategy), when it is evaluated (hasEvaluationTime), and its own effects, costs and utilities, which apply once, when the outcome happens (annual ones are not meaningful for an outcome: the payoffs after an outcome belong to the next strategy). An outcome must belong to one of the concrete subclasses. The chain of strategies that follow an outcome cannot go back to a strategy already applied (decision trees reject cycles): a repetition is modeled as another strategy.</rdfs:comment>
        <rdfs:comment xml:lang="es">Uno de los resultados mutuamente excluyentes de una estrategia (hasStrategyOutcome). Un resultado declara su probabilidad (hasOutcomeRisk y sus subpropiedades), la estrategia que lo sigue (followedByStrategy), cuándo se evalúa (hasEvaluationTime) y sus efectos, costes y utilidades, que se aplican una vez, al producirse el resultado. Un resultado debe pertenecer a una de las subclases concretas. La cadena de estrategias que siguen a un resultado no puede volver a una estrategia ya aplicada: una repetición se modela como otra estrategia.</rdfs:comment>
        <rdfs:label xml:lang="es">Resultado de una estrategia</rdfs:label>
        <rdfs:label xml:lang="en">Strategy outcome</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#StrategyReplacementEffect -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#StrategyReplacementEffect">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Effect"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#affects"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#HealthCondition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasReplacementStrategy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Group"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasGroupItem"/>
                                        <owl:allValuesFrom rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Strategy"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An effect of an intervention that replaces the strategies of a health condition (affects: the disease or an element of its progression) with a new strategy or group of strategies (hasReplacementStrategy). It applies in the arm of the intervention and by type of strategy (detection, i.e. screening or diagnosis; follow-up; or treatment, i.e. line of therapy): the new strategy replaces the strategies of its same type that the health condition declares (hasStrategy), or it is assigned to the health condition if it had none of that type; the strategies of other types are kept. If the replacement is a group, each member replaces the strategies of its type. It does not use a magnitude (hasEffectMagnitude). Two strategy replacements of the same health condition in the same arm are an error. This is the only way for an intervention to declare strategies.</rdfs:comment>
        <rdfs:comment xml:lang="es">Efecto de una intervención que sustituye las estrategias de una condición de salud (affects: la enfermedad o un elemento de su progresión) por una nueva estrategia o grupo de estrategias (hasReplacementStrategy). Se aplica en el brazo de la intervención y por tipo de estrategia (detección, es decir, cribado o diagnóstico; seguimiento; o tratamiento, es decir, línea de terapia): la nueva estrategia sustituye a las estrategias de su mismo tipo que declara la condición de salud (hasStrategy), o se le asigna si no tenía ninguna de ese tipo; las estrategias de otros tipos se mantienen. Si la sustitución es un grupo, cada miembro sustituye a las de su tipo. No usa magnitud (hasEffectMagnitude). Dos sustituciones de estrategia sobre la misma condición de salud en un mismo brazo son un error. Es la única forma de que una intervención declare estrategias.</rdfs:comment>
        <rdfs:label xml:lang="es">Efecto de sustitución de estrategia</rdfs:label>
        <rdfs:label xml:lang="en">Strategy replacement effect</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#SuccessOutcome -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#SuccessOutcome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome"/>
        <rdfs:comment xml:lang="es">El éxito de una estrategia. En una simulación, si no define su propio riesgo, llega con la duración de la condición de salud (hasDuration), modificada por los efectos. Es el resultado al que sigue followedOnSuccessBy en la forma abreviada (ver failsIf).</rdfs:comment>
        <rdfs:comment xml:lang="en">The success of a strategy. In a simulation, if it does not define its own risk, it arrives with the duration of the health condition (hasDuration), modified by the effects. It is the outcome followed by followedOnSuccessBy in the short form (see failsIf).</rdfs:comment>
        <rdfs:label xml:lang="en">Success outcome</rdfs:label>
        <rdfs:label xml:lang="es">Éxito</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#TherapeuticIntervention -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#TherapeuticIntervention">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasCategory"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ontologies-ULL/OSDi#TreatmentCat"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Intervention"/>
        <rdfs:comment xml:lang="en">An intervention driven by a set of drugs and/or treatments</rdfs:comment>
        <rdfs:comment xml:lang="es">Una intervención basada en un conjunto de fármacos o tratamientos</rdfs:comment>
        <rdfs:label xml:lang="es">Intervención terapéutica</rdfs:label>
        <rdfs:label xml:lang="en">Therapeutic intervention</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#TreatmentOutcome">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#StrategyOutcome"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasOutcomeRisk"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An outcome of a strategy that is not a detection strategy (e.g., a partial response, a discontinuation or a death caused by the treatment). Its risk (hasOutcomeRisk) is a probability per episode or a time to event; resolvesHealthCondition says whether it resolves the health condition. Categories without effect on the computations (e.g., complete or partial response) should be expressed with hasCategory.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un resultado de una estrategia que no es de detección (p. ej., una respuesta parcial, una interrupción o una muerte causada por el tratamiento). Su riesgo (hasOutcomeRisk) es una probabilidad por episodio o un tiempo hasta el evento; resolvesHealthCondition indica si resuelve la condición de salud. Las categorías sin efecto en los cálculos (p. ej., respuesta completa o parcial) deberían expresarse con hasCategory.</rdfs:comment>
        <rdfs:label xml:lang="es">Resultado de un tratamiento</rdfs:label>
        <rdfs:label xml:lang="en">Treatment outcome</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#UniformDistributionExpression -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#UniformDistributionExpression">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#ProbabilityDistributionExpression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasLowerLimitParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasUpperLimitParameter"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A bounded continuous probability distribution, where the occurrence of an event is equally probable inside the defined limits</rdfs:comment>
        <rdfs:comment xml:lang="es">Una distribución de probabilidad continua y acotada, en la que la aparición de un evento es igual de probable dentro de los límites definidos</rdfs:comment>
        <rdfs:label xml:lang="es">Expresión para distribución de probabilidad Uniforme</rdfs:label>
        <rdfs:label xml:lang="en">Expression for a Uniform probability distribution</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#Utility -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#Utility">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasDataItemType"/>
                                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                                <owl:onClass rdf:resource="https://w3id.org/ontologies-ULL/OSDi#QoLDataItemType"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#isDisutility"/>
                                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#appliesOneTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="es">La utilidad (o desutilidad) autopercibida de un estado de salud, usada para calcular los años de vida ajustados por calidad</rdfs:comment>
        <rdfs:comment xml:lang="en">The self-perceived utility (or disutility) of a health state, used to compute quality-adjusted life years</rdfs:comment>
        <rdfs:label xml:lang="es">Utilidad</rdfs:label>
        <rdfs:label xml:lang="en">Utility</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/ontologies-ULL/OSDi#YearDependantParameter -->


    <owl:Class rdf:about="https://w3id.org/ontologies-ULL/OSDi#YearDependantParameter">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ontologies-ULL/OSDi#hasYear"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#short"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ontologies-ULL/OSDi#Parameter"/>
        <rdfs:comment xml:lang="en">A parameter whose value depends on the year, such as costs</rdfs:comment>
        <rdfs:comment xml:lang="es">Un parámetro cuyo valor depende del año, como los costes</rdfs:comment>
        <rdfs:label xml:lang="es">Parámetro dependiente del año</rdfs:label>
        <rdfs:label xml:lang="en">Year-Dependent Parameter</rdfs:label>
    </owl:Class>
    


